function getDailyMotivation(){
  var now=new Date();
  var dayNumber=Math.floor(Date.UTC(now.getFullYear(),now.getMonth(),now.getDate())/86400000);
  var index=((dayNumber%DAILY_MOTIVATIONS.length)+DAILY_MOTIVATIONS.length)%DAILY_MOTIVATIONS.length;
  return {item:DAILY_MOTIVATIONS[index],index:index};
}
function getGreeting(){
  var h = new Date().getHours();
  if(h < 5)  return {text:'Boa madrugada', icon:'🌙', aurora:'Trabalhando até tarde?', sub:'Madrugada em Boa Vista. O sistema continua de plantão.'};
  if(h < 12) return {text:'Bom dia',       icon:'🌅', aurora:'Bom dia',           sub:'Comece o dia revendo as entregas pendentes e boletos a vencer.'};
  if(h < 18) return {text:'Boa tarde',     icon:'🌞', aurora:'Boa tarde',         sub:'Painel de controle de vendas, entregas e boletos da Menina dos Raios.'};
  return       {text:'Boa noite',     icon:'🌙', aurora:'Boa noite',         sub:'Fim de expediente é hora de conferir os fechamentos do dia.'};
}
function applyLoginPersonality(){
  try {
    var g = getGreeting();
    var daily = getDailyMotivation();
    var elTxt = document.getElementById('login-greeting-text');
    var elIco = document.querySelector('#login-greeting .g-icon');
    var elAur = document.getElementById('aurora-greeting');
    var elSub = document.getElementById('aurora-sub');
    if(elTxt) elTxt.textContent = g.text;
    if(elIco) elIco.textContent = g.icon;
    if(elAur) elAur.textContent = g.aurora;
    if(elSub) elSub.textContent = g.sub;
    // Citacao motivacional (60+ mensagens em DAILY_MOTIVATIONS)
    var qTitle = document.getElementById('aurora-quote-title');
    var qBody  = document.getElementById('aurora-quote-body');
    if(qTitle && daily && daily.item) qTitle.textContent = daily.item.title;
    if(qBody  && daily && daily.item) qBody.textContent  = daily.item.body;
    // Imagem aleatoria da internet (Picsum) com fade-in; se falhar, mantem o gradiente
    var img = document.getElementById('aurora-img');
    if(img){
      var seed = Math.floor(Math.random()*100000);
      var pic = new Image();
      pic.onload = function(){ img.src = pic.src; img.style.opacity = '1'; };
      pic.src = 'https://picsum.photos/seed/mr'+seed+'/1000/1400';
    }
    var status=document.getElementById('aurora-status');
    if(status) status.textContent='Sistema online';
    var elTip = document.getElementById('login-tip');
    if(elTip){
      var tips=['Pressione N em qualquer tela para lançar uma venda.','A tecla / foca a barra de busca da aba ativa.','Esc fecha modais e menus abertos sem precisar do mouse.','Boletos próximos do vencimento ficam destacados.','Confira as entregas pendentes antes de começar o dia.'];
      elTip.innerHTML = '💡 '+tips[Math.floor(Math.random()*tips.length)];
    }
  } catch(e){}
}
applyLoginPersonality();

// ── Smart Context Bar (subtítulo do header) ───────────────────────────────────
// Atualiza o texto abaixo do nome da empresa conforme aba ativa e dados atuais.
let _ctxLastTab = null;
function updateSmartContext(tab){
  var el = document.getElementById('smart-context');
  if(!el) return;
  if(tab) _ctxLastTab = tab; else tab = _ctxLastTab;
  var text = 'Controle de Vendas';
  try {
    var now = new Date();
    var cm = String(now.getMonth()+1).padStart(2,'0');
    var cy = String(now.getFullYear());
    var monthNames = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
    var mesLabel = monthNames[now.getMonth()] + '/' + cy;
    var ymCurrent = cy + '-' + cm;
    var pmDate = new Date(now.getFullYear(), now.getMonth()-1, 1);
    var ymPrev = pmDate.getFullYear() + '-' + String(pmDate.getMonth()+1).padStart(2,'0');
    function brk(n){
      if(n >= 1000) return 'R$ ' + (n/1000).toFixed(1).replace('.',',') + 'k';
      return 'R$ ' + n.toFixed(0);
    }
    function sep(){ return '<span class="sep">·</span>'; }
    function safe(arr){ return Array.isArray(arr) ? arr : []; }
    var sales = safe(allSales);

    if(!tab || tab === 'consolidado' || tab === 'grafico'){
      var cur = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymCurrent) === 0 && s.sale_type !== 'AVARIA'; });
      var totCur = cur.reduce(function(a,s){ return a + (parseFloat(s.total)||0); }, 0);
      var prev = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymPrev) === 0 && s.sale_type !== 'AVARIA'; });
      var totPrev = prev.reduce(function(a,s){ return a + (parseFloat(s.total)||0); }, 0);
      var varHtml = '';
      if(totPrev > 0){
        var pct = ((totCur - totPrev) / totPrev) * 100;
        var cls = pct >= 0 ? 'up' : 'down';
        var arr = pct >= 0 ? '▲' : '▼';
        varHtml = sep() + '<span class="'+cls+'">'+arr+' '+Math.abs(pct).toFixed(0)+'%</span><span style="opacity:.6"> vs mês anterior</span>';
      }
      text = mesLabel + sep() + cur.length + ' venda' + (cur.length===1?'':'s') + sep() + brk(totCur) + varHtml;
    } else if(['nf','pr','avulso','avaria'].indexOf(tab) >= 0){
      var typeMap = {nf:'NF', pr:'PR', avulso:'AVULSO', avaria:'AVARIA'};
      var t = typeMap[tab];
      var filt = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymCurrent) === 0 && s.sale_type === t; });
      var tot = filt.reduce(function(a,s){ return a + (parseFloat(s.total)||0); }, 0);
      var label = {NF:'NF-e', PR:'PR', AVULSO:'avulsas', AVARIA:'avarias'}[t];
      text = mesLabel + sep() + filt.length + ' ' + label + sep() + brk(tot);
    } else if(tab === 'pendentes'){
      var pend = (typeof getPendingSales === 'function') ? getPendingSales().length : 0;
      var nao  = (typeof getNaoEntregueSales === 'function') ? getNaoEntregueSales().length : 0;
      var del  = (typeof getDeliveredSales === 'function') ? getDeliveredSales().length : 0;
      text = pend + ' a entregar' + sep() + nao + ' não entregues' + sep() + del + ' entregues';
    } else if(tab === 'clientes'){
      var uniq = new Set(sales.map(function(s){ return (s.client||'').trim(); }).filter(Boolean));
      text = uniq.size + ' cliente' + (uniq.size===1?'':'s') + ' (com histórico)';
    } else if(tab === 'produtos'){
      var prices = safe(allPrices);
      var active = prices.filter(function(p){ return p && !p.deleted_at; });
      text = active.length + ' produto' + (active.length===1?'':'s') + ' ativo' + (active.length===1?'':'s');
    } else if(tab === 'boletos'){
      // Boletos não têm cache global no frontend — lê do DOM da lista renderizada
      var rows = document.querySelectorAll('#bol-tbody tr[data-bol]');
      var total = rows.length;
      var pagos = document.querySelectorAll('#bol-tbody tr[data-bol] [data-status="pago"]').length;
      var abertos = total - pagos;
      text = mesLabel + sep() + total + ' boleto' + (total===1?'':'s') + (abertos>0 ? sep() + abertos + ' em aberto' : sep() + 'todos pagos');
    } else if(tab === 'produtividade'){
      var prodCur = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymCurrent) === 0 && s.sale_type !== 'AVARIA'; });
      var dias = new Set(prodCur.map(function(s){ return s.sale_date; })).size;
      var totP = prodCur.reduce(function(a,s){ return a + (parseFloat(s.total)||0); }, 0);
      var media = dias > 0 ? totP / dias : 0;
      text = mesLabel + sep() + dias + ' dia' + (dias===1?'':'s') + ' produtivo' + (dias===1?'':'s') + sep() + 'média ' + brk(media) + '/dia';
    } else if(tab === 'config'){
      text = 'Configurações do sistema';
    }
  } catch(e){ /* mantém fallback */ }

  if(el.innerHTML !== text){
    el.classList.add('fading');
    setTimeout(function(){
      el.innerHTML = text;
      el.classList.remove('fading');
    }, 180);
  }
}
window.addEventListener('salesLoaded', function(){ updateSmartContext(); });
setInterval(function(){ updateSmartContext(); }, 20000);

// ── Botão "Voltar ao topo" — aparece após 320px de scroll ─────────────────────
window.addEventListener('scroll', function(){
  var btn = document.getElementById('btn-top');
  if(!btn) return;
  if(window.scrollY > 320){
    btn.style.display = 'flex';
    requestAnimationFrame(function(){ btn.style.opacity = '1'; });
  } else {
    btn.style.opacity = '0';
    setTimeout(function(){
      if(window.scrollY <= 320) btn.style.display = 'none';
    }, 220);
  }
});

// ── Modo TV — painel fullscreen para escritório ──────────────────────────────
// Slides: 0 = visão geral, 1 = rankings expandidos. Rotação a cada 30s.
let _tvRefreshTimer = null;
let _tvClockTimer   = null;
let _tvSlideTimer   = null;
let _tvCurrentSlide = 0;
const TV_SLIDE_INTERVAL = 30000; // 30s

function enterTVMode(){
  var _tvVer = document.getElementById('tv-footer-version');
  if(_tvVer) _tvVer.textContent = APP_VERSION;
  var tv = document.getElementById('tv-mode');
  if(!tv) return;
  document.body.classList.add('tv-active');
  tv.classList.add('active');
  _tvCurrentSlide = 0;
  renderTVSlide(0);
  renderTVMode();
  startTVClock();
  if(_tvRefreshTimer) clearInterval(_tvRefreshTimer);
  _tvRefreshTimer = setInterval(function(){
    if(typeof loadAll === 'function'){
      loadAll().then(function(){ renderTVMode(); }).catch(function(){});
    } else { renderTVMode(); }
    flashRefreshDot();
  }, 30000);
  if(_tvSlideTimer) clearInterval(_tvSlideTimer);
  _tvSlideTimer = setInterval(function(){
    _tvCurrentSlide = (_tvCurrentSlide + 1) % 3;
    renderTVSlide(_tvCurrentSlide);
  }, TV_SLIDE_INTERVAL);
}

function exitTVMode(){
  if(session && session.role==='viewer'){
    doLogout();
    return;
  }
  var tv = document.getElementById('tv-mode');
  if(!tv) return;
  document.body.classList.remove('tv-active');
  tv.classList.remove('active');
  if(_tvRefreshTimer){ clearInterval(_tvRefreshTimer); _tvRefreshTimer = null; }
  if(_tvClockTimer){ clearInterval(_tvClockTimer); _tvClockTimer = null; }
  if(_tvSlideTimer){ clearInterval(_tvSlideTimer); _tvSlideTimer = null; }
  try { if(document.fullscreenElement) document.exitFullscreen(); } catch(e){}
}

function startTVClock(){
  function tick(){
    var now = new Date();
    var hh = String(now.getHours()).padStart(2,'0');
    var mm = String(now.getMinutes()).padStart(2,'0');
    var t = document.getElementById('tv-time');
    if(t) t.textContent = hh + ':' + mm;
    var d = document.getElementById('tv-date');
    if(d){
      d.textContent = now.toLocaleDateString('pt-BR',{weekday:'long', day:'numeric', month:'long'});
    }
  }
  tick();
  if(_tvClockTimer) clearInterval(_tvClockTimer);
  _tvClockTimer = setInterval(tick, 1000);
}

function flashRefreshDot(){
  var el = document.getElementById('tv-refresh-label');
  if(!el) return;
  var orig = 'AO VIVO';
  el.textContent = 'ATUALIZANDO…';
  setTimeout(function(){ el.textContent = orig; }, 1200);
}

function renderTVSlide(slideIdx){
  // Slide 1 é o "fg" (sempre presente, fade-out). Slides 2+ são "bg" (fade-in via .active).
  var s1 = document.getElementById('tv-slide-1');
  var s2 = document.getElementById('tv-slide-2');
  var s3 = document.getElementById('tv-slide-3');
  if(!s1) return;
  if(slideIdx === 0){
    s1.classList.remove('hidden');
    if(s2) s2.classList.remove('active');
    if(s3) s3.classList.remove('active');
  } else if(slideIdx === 1){
    s1.classList.add('hidden');
    if(s2) s2.classList.add('active');
    if(s3) s3.classList.remove('active');
  } else { // slideIdx === 2
    s1.classList.add('hidden');
    if(s2) s2.classList.remove('active');
    if(s3) s3.classList.add('active');
  }
  // Atualiza dots
  document.querySelectorAll('.tv-slide-dot').forEach(function(d, i){
    d.classList.toggle('active', i === slideIdx);
  });
}

// Helpers compartilhados
function _tvFmtBRK(n){
  if(!isFinite(n) || n === 0) return 'R$ 0';
  if(Math.abs(n) >= 1000000) return 'R$ ' + (n/1000000).toFixed(2).replace('.',',') + 'M';
  if(Math.abs(n) >= 1000)    return 'R$ ' + (n/1000).toFixed(1).replace('.',',') + 'k';
  return 'R$ ' + Math.round(n);
}
function _tvFmtBR(n){
  if(!isFinite(n)) return 'R$ 0,00';
  return 'R$ ' + n.toFixed(2).replace('.',',').replace(/\B(?=(\d{3})+(?!\d))/g,'.');
}
function _tvEscape(s){
  return String(s||'').replace(/[<>&"]/g, function(c){
    return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];
  });
}

// ── Slide 3: Meta & Projeção (painel executivo) ────────────────────────────
// Calcula projeção do mês com base no ritmo atual e renderiza o slide 3.
// Argumentos:
//   meta   = meta mensal configurada (R$)
//   totCur = faturado até o momento no mês corrente (R$, sem AVARIAs)
//   now    = Date atual (já criada em renderTVMode)
function _tvRenderMetaSlide(meta, totCur, now){
  var hero  = document.getElementById('tv-meta-hero');
  var cards = document.getElementById('tv-meta-cards');
  if(!hero || !cards) return;

  // ── Caso: meta não definida ──
  if(!meta || meta <= 0){
    hero.innerHTML =
      '<div class="tv-meta-empty">'
      + '<div class="tv-meta-empty-icon">🎯</div>'
      + '<div class="tv-meta-empty-title">Meta do mês não definida</div>'
      + '<div class="tv-meta-empty-hint">Configure a meta mensal em <strong>Configurações → Preços</strong> para visualizar a projeção em tempo real.</div>'
      + '</div>';
    cards.innerHTML = '';
    return;
  }

  // ── Cálculos de tempo ──
  var diaAtual       = now.getDate();
  var diasNoMes      = new Date(now.getFullYear(), now.getMonth()+1, 0).getDate();
  var diasDecorridos = diaAtual; // hoje conta como "em curso"
  var diasRestantes  = Math.max(0, diasNoMes - diaAtual);

  // ── Ritmos e projeção ──
  var ritmoAtual    = diasDecorridos > 0 ? (totCur / diasDecorridos) : 0;
  var ritmoIdeal    = meta / diasNoMes;
  var projecao      = ritmoAtual * diasNoMes;
  var faltaParaMeta = Math.max(0, meta - totCur);
  var necessarioDia = diasRestantes > 0 ? (faltaParaMeta / diasRestantes) : faltaParaMeta;
  var pctAtual      = (totCur / meta) * 100;
  var pctProjecao   = (projecao / meta) * 100;
  var deltaRitmoPct = ritmoIdeal > 0 ? ((ritmoAtual - ritmoIdeal) / ritmoIdeal) * 100 : 0;

  // ── Status (verde / amarelo / vermelho) ──
  // Tolerância de ±5% no ritmo para "na rota"
  var status, statusLabel, statusBarClass;
  if(deltaRitmoPct > 5){
    status = 'good'; statusLabel = 'ACIMA DA ROTA'; statusBarClass = '';
  } else if(deltaRitmoPct >= -5){
    status = 'warn'; statusLabel = 'NA ROTA'; statusBarClass = 'warn';
  } else {
    status = 'bad';  statusLabel = 'ABAIXO DA ROTA'; statusBarClass = 'bad';
  }
  // Caso especial: meta já batida
  if(totCur >= meta){
    status = 'good'; statusLabel = 'META BATIDA'; statusBarClass = '';
  }

  // ── Frase automática ──
  var frase;
  if(totCur >= meta){
    var excedente = totCur - meta;
    var pctExc = (excedente / meta) * 100;
    frase = '🎉 <strong>Meta atingida!</strong> Excedente de <strong class="good">' + _tvFmtBRK(excedente) + '</strong> (' + pctExc.toFixed(0) + '% acima)';
  } else if(status === 'good'){
    frase = 'No ritmo atual, a meta será <strong class="good">superada em ' + (pctProjecao - 100).toFixed(0) + '%</strong>. Projeção final: <strong>' + _tvFmtBRK(projecao) + '</strong>';
  } else if(status === 'warn'){
    frase = 'No ritmo atual, a meta tende a ser <strong class="warn">atingida</strong>. Projeção final: <strong>' + _tvFmtBRK(projecao) + '</strong> (' + pctProjecao.toFixed(0) + '%)';
  } else {
    var aceleracao = ritmoAtual > 0 ? ((necessarioDia - ritmoAtual) / ritmoAtual) * 100 : 100;
    frase = 'No ritmo atual, a meta ficará <strong class="bad">abaixo do esperado</strong>. Acelere <strong>' + aceleracao.toFixed(0) + '%/dia</strong> para alcançar a meta';
  }

  // ── Posição do marcador de projeção na barra (limita 0–100% pro visual) ──
  var projMarkerPct = Math.max(0, Math.min(100, pctProjecao));
  var nowFillPct    = Math.max(0, Math.min(100, pctAtual));

  // ── HTML do hero ──
  hero.innerHTML =
    '<div class="tv-meta-hero-top">'
    + '<div class="tv-meta-stat">'
    +   '<div class="tv-meta-stat-label">🎯 Meta do Mês</div>'
    +   '<div class="tv-meta-stat-value">' + _tvFmtBRK(meta) + '</div>'
    +   '<div class="tv-meta-stat-sub">' + diasNoMes + ' dias · ideal ' + _tvFmtBRK(ritmoIdeal) + '/dia</div>'
    + '</div>'
    + '<div class="tv-meta-stat">'
    +   '<div class="tv-meta-stat-label">💰 Faturado até agora</div>'
    +   '<div class="tv-meta-stat-value accent">' + _tvFmtBRK(totCur) + '</div>'
    +   '<div class="tv-meta-stat-sub"><strong>' + pctAtual.toFixed(1).replace('.',',') + '%</strong> da meta · dia ' + diaAtual + ' de ' + diasNoMes + '</div>'
    + '</div>'
    + '<div class="tv-meta-stat">'
    +   '<div class="tv-meta-stat-label">📈 Projeção Final</div>'
    +   '<div class="tv-meta-stat-value ' + (status==='bad'?'muted':'') + '">' + _tvFmtBRK(projecao) + '</div>'
    +   '<div class="tv-meta-stat-sub">' + pctProjecao.toFixed(0) + '% da meta no ritmo atual</div>'
    + '</div>'
    + '</div>'

    + '<div class="tv-meta-bar-area">'
    +   '<div class="tv-meta-bar-track">'
    +     '<div class="tv-meta-bar-now ' + statusBarClass + '" style="width:' + nowFillPct.toFixed(1) + '%"></div>'
    +     '<div class="tv-meta-bar-projection" style="left:' + projMarkerPct.toFixed(1) + '%"></div>'
    +   '</div>'
    +   '<div class="tv-meta-bar-scale"><span>0</span><span>50% (' + _tvFmtBRK(meta*0.5) + ')</span><span>100% (' + _tvFmtBRK(meta) + ')</span></div>'
    + '</div>'

    + '<div class="tv-meta-status">'
    +   '<div class="tv-meta-status-dot ' + status + '"></div>'
    +   '<div class="tv-meta-status-text"><strong>' + statusLabel + '</strong> · ' + frase + '</div>'
    + '</div>';

  // ── 5 cards de detalhe ──
  var ritmoDiff   = ritmoAtual - ritmoIdeal;
  var ritmoArrow  = ritmoDiff >= 0 ? '▲' : '▼';
  var ritmoCardCls = status === 'bad' ? 'accent-bad' : (status === 'warn' ? 'accent-warn' : 'accent-good');

  cards.innerHTML =
      '<div class="tv-meta-card ' + ritmoCardCls + '">'
    +   '<span class="tv-meta-card-icon">⚡</span>'
    +   '<div class="tv-meta-card-label">Ritmo Atual</div>'
    +   '<div class="tv-meta-card-value">' + _tvFmtBRK(ritmoAtual) + '<span style="font-size:.55em;opacity:.6;font-weight:600">/dia</span></div>'
    +   '<div class="tv-meta-card-sub"><span class="' + (ritmoDiff>=0?'good':'bad') + '" style="color:' + (ritmoDiff>=0?'#86efac':'#fca5a5') + ';font-weight:700">' + ritmoArrow + ' ' + Math.abs(deltaRitmoPct).toFixed(0) + '%</span> vs ideal</div>'
    + '</div>'

    + '<div class="tv-meta-card accent-neutral">'
    +   '<span class="tv-meta-card-icon">🎯</span>'
    +   '<div class="tv-meta-card-label">Ritmo Ideal</div>'
    +   '<div class="tv-meta-card-value">' + _tvFmtBRK(ritmoIdeal) + '<span style="font-size:.55em;opacity:.6;font-weight:600">/dia</span></div>'
    +   '<div class="tv-meta-card-sub">meta ÷ ' + diasNoMes + ' dias</div>'
    + '</div>'

    + '<div class="tv-meta-card accent-neutral">'
    +   '<span class="tv-meta-card-icon">📅</span>'
    +   '<div class="tv-meta-card-label">Dias Restantes</div>'
    +   '<div class="tv-meta-card-value">' + diasRestantes + '<span style="font-size:.55em;opacity:.6;font-weight:600"> dias</span></div>'
    +   '<div class="tv-meta-card-sub">de ' + diasNoMes + ' totais</div>'
    + '</div>'

    + '<div class="tv-meta-card ' + (totCur>=meta?'accent-good':'accent-warn') + '">'
    +   '<span class="tv-meta-card-icon">📊</span>'
    +   '<div class="tv-meta-card-label">' + (totCur>=meta?'Excedente':'Falta para Meta') + '</div>'
    +   '<div class="tv-meta-card-value">' + _tvFmtBRK(totCur>=meta ? (totCur-meta) : faltaParaMeta) + '</div>'
    +   '<div class="tv-meta-card-sub">' + (totCur>=meta?'acima da meta':(meta>0?(100 - pctAtual).toFixed(1).replace('.',',') + '% restante':'—')) + '</div>'
    + '</div>'

    + '<div class="tv-meta-card ' + (totCur>=meta?'accent-good':(necessarioDia > ritmoAtual*1.3 ? 'accent-bad' : 'accent-warn')) + '">'
    +   '<span class="tv-meta-card-icon">🚀</span>'
    +   '<div class="tv-meta-card-label">Necessário por Dia</div>'
    +   '<div class="tv-meta-card-value">' + (totCur>=meta ? '✓' : _tvFmtBRK(necessarioDia)) + (totCur>=meta?'':'<span style="font-size:.55em;opacity:.6;font-weight:600">/dia</span>') + '</div>'
    +   '<div class="tv-meta-card-sub">' + (totCur>=meta ? 'meta atingida' : (diasRestantes>0?'nos próximos ' + diasRestantes + ' dia' + (diasRestantes===1?'':'s'):'último dia do mês')) + '</div>'
    + '</div>';
}

function renderTVMode(){
  try {
    var now = new Date();
    var cm = String(now.getMonth()+1).padStart(2,'0');
    var cy = String(now.getFullYear());
    var monthNames = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    var period = document.getElementById('tv-period');
    if(period) period.textContent = monthNames[now.getMonth()] + '/' + cy;
    var ymCurrent = cy + '-' + cm;
    var pmDate = new Date(now.getFullYear(), now.getMonth()-1, 1);
    var ymPrev = pmDate.getFullYear() + '-' + String(pmDate.getMonth()+1).padStart(2,'0');

    var sales = Array.isArray(allSales) ? allSales : [];
    var cur     = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymCurrent) === 0 && s.sale_type !== 'AVARIA'; });
    var prev    = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymPrev) === 0 && s.sale_type !== 'AVARIA'; });
    var avariasMes = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymCurrent) === 0 && s.sale_type === 'AVARIA'; });
    var totCur  = cur.reduce(function(a,s){ return a + (parseFloat(s.total)||0); }, 0);
    var totPrev = prev.reduce(function(a,s){ return a + (parseFloat(s.total)||0); }, 0);
    var totAvar = avariasMes.reduce(function(a,s){ return a + Math.abs(parseFloat(s.total)||0); }, 0);
    var avariasPrev = sales.filter(function(s){ return s && s.sale_date && s.sale_date.indexOf(ymPrev) === 0 && s.sale_type === 'AVARIA'; });
    var totAvarPrev = avariasPrev.reduce(function(a,s){ return a + Math.abs(parseFloat(s.total)||0); }, 0);

    // ── KPI 1: Faturamento
    document.getElementById('tv-kpi-fatur').textContent = _tvFmtBRK(totCur);
    var subEl = document.getElementById('tv-kpi-fatur-sub');
    if(totPrev > 0){
      var pct = ((totCur - totPrev) / totPrev) * 100;
      subEl.innerHTML = '<span class="'+(pct>=0?'up':'down')+'">'+(pct>=0?'▲':'▼')+' '+Math.abs(pct).toFixed(0)+'%</span> vs mês anterior';
    } else { subEl.textContent = 'sem dados do mês anterior'; }

    // ── KPI 2: Vendas
    document.getElementById('tv-kpi-vendas').textContent = cur.length;
    var diff = cur.length - prev.length;
    document.getElementById('tv-kpi-vendas-sub').textContent =
      diff === 0 ? '= ao mês anterior' : (diff > 0 ? ('+' + diff + ' que mês ant.') : (diff + ' que mês ant.'));

    // ── KPI 3: Ticket médio
    var ticket = cur.length > 0 ? totCur / cur.length : 0;
    document.getElementById('tv-kpi-ticket').textContent = _tvFmtBRK(ticket);

    // ── KPI 4: Dias produtivos
    var dias = new Set(cur.map(function(s){ return s.sale_date; })).size;
    document.getElementById('tv-kpi-dias').textContent = dias;
    var media = dias > 0 ? totCur / dias : 0;
    document.getElementById('tv-kpi-dias-sub').textContent = 'média ' + _tvFmtBRK(media) + '/dia';

    // ── KPI 5: Avarias do mês
    document.getElementById('tv-kpi-avaria').textContent = _tvFmtBRK(totAvar);
    var avSub = document.getElementById('tv-kpi-avaria-sub');
    if(totAvar > 0 && totCur > 0){
      var avPct = (totAvar / totCur) * 100;
      avSub.innerHTML = '<span class="down">▼ '+avPct.toFixed(2).replace('.',',')+'%</span> do faturamento · '+avariasMes.length+' ocorrência'+(avariasMes.length===1?'':'s');
    } else if(totAvar > 0){
      avSub.textContent = avariasMes.length + ' ocorrência' + (avariasMes.length===1?'':'s');
    } else {
      avSub.textContent = '✓ nenhuma avaria';
    }

    var _tvHoje = new Date();
    var _tvDaysInMonth = new Date(_tvHoje.getFullYear(), _tvHoje.getMonth() + 1, 0).getDate();
    var _tvDaysElapsed = _tvHoje.getDate();
    var _tvProjAvar = _tvDaysElapsed > 0 ? (totAvar / _tvDaysElapsed) * _tvDaysInMonth : totAvar;
    var _tvMediaAvarDia = _tvDaysElapsed > 0 ? totAvar / _tvDaysElapsed : 0;
    var _tvTend = _tvProjAvar > totAvar * 1.15 ? '↑ Acelerado' : _tvProjAvar < totAvar * 0.85 ? '↓ Reduzindo' : '→ Estável';
    var avarVar = totAvarPrev > 0 ? ((totAvar - totAvarPrev) / totAvarPrev) * 100 : 0;
    var avarVarStr = totAvarPrev > 0
      ? '<span class="'+(avarVar>=0?'down':'up')+'">'+(avarVar>=0?'▲':'▼')+' '+Math.abs(avarVar).toFixed(0)+'%</span> vs mês ant.'
      : '<span style="opacity:.5">vs mês ant.</span>';
    var avarPctOfRevenue = totCur > 0 ? (totAvar / totCur) * 100 : 0;
    var avarAlertIcon = avarPctOfRevenue > 5 ? '🔴' : (avarPctOfRevenue > 3 ? '🟡' : '🟢');
    var avarAlertCls = avarPctOfRevenue > 5 ? 'tag' : (avarPctOfRevenue > 3 ? 'tag yellow' : 'tag green');

    var _tvProjEl = document.getElementById('tv-kpi-avaria-proj');
    if (_tvProjEl) {
        _tvProjEl.innerHTML =
          '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:11px;line-height:1.5">'
          + '<span>Proj: <span style="color:#fca5a5;font-weight:700">' + _tvFmtBRK(_tvProjAvar) + '</span></span>'
          + '<span style="opacity:.65">Média: ' + _tvFmtBRK(_tvMediaAvarDia) + '/dia</span>'
          + '<span style="opacity:.65">' + _tvTend + '</span>'
          + '<span style="opacity:.65">dia ' + _tvDaysElapsed + '/' + _tvDaysInMonth + '</span>'
          + '</div>'
          + '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:10px;opacity:.8;margin-top:3px" id="tv-avaria-proj-kpi-extra"></div>';
    }

    // ── KPI 6: Meta do mês
    var metaEl = document.getElementById('meta-mensal');
    var meta = metaEl ? (parseFloat(metaEl.value)||0) : 0;
    var metaWrap = document.getElementById('tv-meta-bar-wrap');
    var metaValEl = document.getElementById('tv-kpi-meta-val');
    var metaSubEl = document.getElementById('tv-kpi-meta-sub');
    if(meta > 0){
      var pctMeta = Math.min(100, (totCur / meta) * 100);
      metaValEl.textContent = pctMeta.toFixed(0) + '% atingido';
      metaWrap.style.display = 'block';
      var fill = document.getElementById('tv-meta-bar-fill');
      fill.style.width = pctMeta.toFixed(0) + '%';
      fill.classList.toggle('full', pctMeta >= 100);
      var falta = Math.max(0, meta - totCur);
      if(pctMeta >= 100){
        metaSubEl.innerHTML = '🎉 <span class="up">Meta batida!</span> Excedente ' + _tvFmtBRK(totCur - meta);
      } else {
        metaSubEl.innerHTML = 'Falta ' + _tvFmtBRK(falta) + ' · meta ' + _tvFmtBRK(meta);
      }
    } else {
      metaValEl.textContent = '—';
      metaValEl.style.opacity = '.5';
      metaWrap.style.display = 'none';
      metaSubEl.textContent = 'Meta não definida';
      metaSubEl.style.opacity = '.5';
    }

    // ── Slide 3: Meta & Projeção (painel executivo)
    _tvRenderMetaSlide(meta, totCur, now);

    // ── Canais (NF / PR / Avulso)
    var byType = {NF:{val:0,cnt:0}, PR:{val:0,cnt:0}, AVULSO:{val:0,cnt:0}};
    cur.forEach(function(s){
      if(byType[s.sale_type]){
        byType[s.sale_type].val += parseFloat(s.total)||0;
        byType[s.sale_type].cnt += 1;
      }
    });
    function setChannel(prefix, data, total){
      document.getElementById('tv-ch-'+prefix+'-val').textContent = _tvFmtBRK(data.val);
      var pct = total > 0 ? (data.val/total)*100 : 0;
      document.getElementById('tv-ch-'+prefix+'-pct').textContent = pct.toFixed(0)+'%';
      document.getElementById('tv-ch-'+prefix+'-cnt').textContent = data.cnt;
      document.getElementById('tv-ch-'+prefix+'-bar').style.width = pct.toFixed(1)+'%';
    }
    setChannel('nf', byType.NF, totCur);
    setChannel('pr', byType.PR, totCur);
    setChannel('av', byType.AVULSO, totCur);

    // ── Avarias por cliente (mapa, usado em vários lugares)
    var avariasByClient = {};
    avariasMes.forEach(function(s){
      var k = (s.client||'').trim();
      if(!k) return;
      avariasByClient[k] = avariasByClient[k] || {val:0, cnt:0};
      avariasByClient[k].val += Math.abs(parseFloat(s.total)||0);
      avariasByClient[k].cnt += 1;
    });

    // ── Top 5 clientes (enriquecido)
    var byClient = {};
    cur.forEach(function(s){
      var k = (s.client||'').trim();
      if(!k) return;
      byClient[k] = (byClient[k]||0) + (parseFloat(s.total)||0);
    });
    var topClients = Object.keys(byClient).map(function(k){
      return {client:k, val:byClient[k]};
    }).sort(function(a,b){ return b.val - a.val; });
    renderTVTopList('tv-top-list', topClients.slice(0,5), totCur, avariasByClient, true);

    // Top 10 do slide 2
    renderTVTopList('tv-top10-list', topClients.slice(0,8), totCur, avariasByClient, false);

    // ── Entregadores
    var byDriver = {};
    cur.forEach(function(s){
      var d = (s.delivery_person||'').trim();
      if(!d || d === '--' || d === '-') return;
      byDriver[d] = byDriver[d] || {val:0, cnt:0};
      byDriver[d].val += parseFloat(s.total)||0;
      byDriver[d].cnt += 1;
    });
    var topDrivers = Object.keys(byDriver).map(function(k){
      return {name:k, val:byDriver[k].val, cnt:byDriver[k].cnt};
    }).sort(function(a,b){ return b.val - a.val; });
    renderTVDriversList('tv-drivers-list', topDrivers.slice(0,4));
    renderTVDriversList('tv-drivers-detail-list', topDrivers.slice(0,4));

    // ── Avarias por cliente (lista)
    var avariasList = Object.keys(avariasByClient).map(function(k){
      return {client:k, val:avariasByClient[k].val, cnt:avariasByClient[k].cnt};
    }).sort(function(a,b){ return b.val - a.val; });
    renderTVAvariaList('tv-avaria-list', avariasList.slice(0,5), totAvar);
    renderTVAvariaList('tv-avaria-detail-list', avariasList.slice(0,6), totAvar);

    // ── Avarias por produto
    var avariasByProduct = {};
    avariasMes.forEach(function(s){
      var p = prodCanonicalName(s.product,s.sale_type);
      if(!p) return;
      avariasByProduct[p] = (avariasByProduct[p]||0) + Math.abs(parseFloat(s.total)||0);
    });
    var avariaProducts = Object.keys(avariasByProduct).map(function(k){
      return {product:k, val:avariasByProduct[k]};
    }).sort(function(a,b){ return b.val - a.val; });
    renderTVAvariaProductList('tv-avaria-product-list', avariaProducts.slice(0,6));

    // Maior cliente e maior produto para o KPI extra
    var avarBigClient = avariasList.length > 0 ? avariasList[0] : null;
    var avarBigProduct = avariaProducts.length > 0 ? avariaProducts[0] : null;

    // Preenche a linha extra do KPI de projeção (tv-avaria-proj-kpi-extra)
    var tvExtra = document.getElementById('tv-avaria-proj-kpi-extra');
    if(tvExtra){
      var parts = [];
      if(avarBigClient) parts.push('⚠ '+_tvEscape(avarBigClient.client)+' ('+_tvFmtBRK(avarBigClient.val)+')');
      if(avarBigProduct) parts.push('📦 '+_tvEscape(avarBigProduct.product)+' ('+_tvFmtBRK(avarBigProduct.val)+')');
      parts.push('<span class="'+avarAlertCls+'">'+avarAlertIcon+' '+(avarPctOfRevenue).toFixed(1).replace('.',',')+'% do fat.</span>');
      parts.push('<span style="opacity:.65">'+avarVarStr+'</span>');
      tvExtra.innerHTML = parts.join('<span style="opacity:.3;margin:0 2px">·</span>');
    }

    // Preenche o barra de projeção do slide 2
    var tvProjBar = document.getElementById('tv-avaria-proj-bar');
    if(tvProjBar && totAvar > 0){
      var rows = tvProjBar.querySelectorAll('.tv-avaria-proj-row');
      if(rows.length >= 2){
        rows[0].innerHTML =
          '<span class="tag">Proj: '+_tvFmtBRK(_tvProjAvar)+'</span>'
          + '<span style="opacity:.7">Total: '+_tvFmtBRK(totAvar)+'</span>'
          + '<span style="opacity:.7">Média: '+_tvFmtBRK(_tvMediaAvarDia)+'/dia</span>'
          + '<span>'+avarVarStr+'</span>'
          + '<span class="'+avarAlertCls+'">'+avarAlertIcon+' '+(avarPctOfRevenue).toFixed(1).replace('.',',')+'%</span>';
        rows[1].innerHTML =
          '<span style="opacity:.7">'+_tvTend+' · dia '+_tvDaysElapsed+'/'+_tvDaysInMonth+'</span>'
          + (avarBigClient ? '<span style="opacity:.7">⚠ '+_tvEscape(avarBigClient.client)+'</span>' : '')
          + (avarBigProduct ? '<span style="opacity:.7">📦 '+_tvEscape(avarBigProduct.product)+'</span>' : '');
      }
    } else if(tvProjBar) {
      var rows = tvProjBar.querySelectorAll('.tv-avaria-proj-row');
      if(rows.length >= 2){
        rows[0].innerHTML = '<span class="tag green">🟢 Nenhuma avaria no mês</span>';
        rows[1].innerHTML = '';
      }
    }

    // ── Gráfico de barras dos últimos 14 dias
    renderTVChart(sales);

    // ── Canais por semana (slide 2)
    renderTVWeeklyBars(sales);

    // ── Ticker (últimas 5 vendas)
    renderTVTicker(sales);

  } catch(e){
    console.warn('renderTVMode error:', e);
  }
}

function renderTVTopList(elId, list, totCur, avariasByClient, withBar){
  var ul = document.getElementById(elId);
  if(!ul) return;
  if(list.length === 0){
    ul.innerHTML = '<li class="tv-empty">Sem vendas neste mês</li>';
    return;
  }
  ul.innerHTML = list.map(function(c, idx){
    var rankCls = idx === 0 ? 'gold' : (idx === 1 || idx === 2 ? 'silver' : '');
    if(idx === 2) rankCls = 'bronze';
    var nameSafe = _tvEscape(c.client);
    var avariaBadge = '';
    if(avariasByClient && avariasByClient[c.client]){
      avariaBadge = '<span class="tv-top-avaria-badge">⚠️ '+_tvFmtBRK(avariasByClient[c.client].val)+'</span>';
    }
    var pct = totCur > 0 ? (c.val/totCur)*100 : 0;
    var barHtml = withBar
      ? '<div class="tv-top-bar"><div class="tv-top-bar-fill" style="width:'+Math.min(100,pct).toFixed(1)+'%"></div></div>'
      : '';
    return '<li>'+
      '<span class="tv-top-rank '+rankCls+'">'+(idx+1)+'</span>'+
      '<div class="tv-top-body">'+
        '<div class="tv-top-name">'+nameSafe+avariaBadge+'</div>'+
        barHtml+
      '</div>'+
      '<span class="tv-top-val">'+_tvFmtBRK(c.val)+'</span>'+
    '</li>';
  }).join('');
}

function renderTVDriversList(elId, list){
  var ul = document.getElementById(elId);
  if(!ul) return;
  if(list.length === 0){
    ul.innerHTML = '<li class="tv-empty">Nenhum entregador no mês</li>';
    return;
  }
  ul.innerHTML = list.map(function(d, idx){
    var topCls = idx === 0 ? 'top' : '';
    var medal = idx === 0 ? '🥇' : (idx+1);
    return '<li class="'+topCls+'">'+
      '<span class="tv-drivers-rank">'+medal+'</span>'+
      '<span class="tv-drivers-name">'+_tvEscape(d.name)+'</span>'+
      '<span class="tv-drivers-count">'+d.cnt+'v</span>'+
      '<span class="tv-drivers-val">'+_tvFmtBRK(d.val)+'</span>'+
    '</li>';
  }).join('');
}

function renderTVAvariaList(elId, list, totalAvar){
  var ul = document.getElementById(elId);
  if(!ul) return;
  if(list.length === 0){
    ul.innerHTML = '<li class="tv-avaria-ok">✅ Nenhuma avaria no mês</li>';
    return;
  }
  var maxVal = list.length > 0 ? list[0].val : 1;
  ul.innerHTML = list.map(function(a, i){
    var pct = totalAvar > 0 ? (a.val / totalAvar) * 100 : 0;
    var barW = maxVal > 0 ? (a.val / maxVal) * 100 : 0;
    var cls = i === 0 && pct >= 15 ? 'tv-avaria-high' : '';
    return '<li class="'+cls+'">'+
      '<span class="tv-avaria-name">'+_tvEscape(a.client)+'</span>'+
      '<span class="tv-avaria-count">'+a.cnt+'×</span>'+
      '<div class="tv-avaria-bar-wrap"><div class="tv-avaria-bar-fill" style="width:'+barW.toFixed(0)+'%"></div></div>'+
      '<span class="tv-avaria-val">'+_tvFmtBRK(a.val)+'</span>'+
      '<span class="tv-avaria-pct">'+pct.toFixed(1).replace('.',',')+'%</span>'+
    '</li>';
  }).join('');
}

function renderTVAvariaProductList(elId, list){
  var ul = document.getElementById(elId);
  if(!ul) return;
  if(list.length === 0){
    ul.innerHTML = '<li class="tv-avaria-ok">✅ Nenhum produto com avaria</li>';
    return;
  }
  ul.innerHTML = list.map(function(a){
    return '<li>'+
      '<span class="tv-avaria-name">'+_tvEscape(a.product)+'</span>'+
      '<span class="tv-avaria-val">'+_tvFmtBRK(a.val)+'</span>'+
    '</li>';
  }).join('');
}

function renderTVChart(allSalesArr){
  var svg = document.getElementById('tv-chart');
  if(!svg) return;
  var today = new Date(); today.setHours(0,0,0,0);
  var days = [];
  for(var i = 13; i >= 0; i--){
    var d = new Date(today); d.setDate(d.getDate() - i);
    var key = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    var label = String(d.getDate()).padStart(2,'0') + '/' + String(d.getMonth()+1).padStart(2,'0');
    days.push({key:key, label:label, val:0});
  }
  var idx = {};
  days.forEach(function(d){ idx[d.key] = d; });
  allSalesArr.forEach(function(s){
    if(!s || !s.sale_date || s.sale_type === 'AVARIA') return;
    if(idx[s.sale_date]) idx[s.sale_date].val += (parseFloat(s.total)||0);
  });
  var W = 700, H = 180, padX = 14, padTop = 16, padBottom = 30;
  var maxVal = Math.max.apply(null, days.map(function(d){ return d.val; }).concat([1]));
  var avg = days.reduce(function(a,d){ return a + d.val; }, 0) / days.length;
  var slot = (W - padX*2) / days.length;
  var barW = slot * 0.62;
  var chartH = H - padTop - padBottom;

  // Acha o dia mais alto
  var maxDay = days.reduce(function(a,d){ return d.val > a.val ? d : a; }, days[0]);

  var avgY = padTop + chartH - (avg / maxVal) * chartH;

  var bars = days.map(function(d, i){
    var x = padX + i * slot + (slot - barW)/2;
    var h = maxVal > 0 ? (d.val / maxVal) * chartH : 0;
    var y = padTop + chartH - h;
    var color = (d.val === maxDay.val && d.val > 0) ? '#4ade80' : '#86efac';
    var op = d.val === 0 ? 0.25 : 1;
    return '<rect x="'+x.toFixed(1)+'" y="'+y.toFixed(1)+'" width="'+barW.toFixed(1)+'" height="'+h.toFixed(1)+'" fill="'+color+'" opacity="'+op+'" rx="2"/>'+
           '<text x="'+(x+barW/2).toFixed(1)+'" y="'+(H-12)+'" text-anchor="middle" font-size="9" fill="rgba(255,255,255,.55)" font-family="DM Sans">'+d.label+'</text>';
  }).join('');

  var avgLine = avg > 0
    ? '<line x1="'+padX+'" y1="'+avgY.toFixed(1)+'" x2="'+(W-padX)+'" y2="'+avgY.toFixed(1)+'" stroke="rgba(252,211,77,.6)" stroke-width="1.5" stroke-dasharray="4,4"/>'+
      '<text x="'+(W-padX-4)+'" y="'+(avgY-4).toFixed(1)+'" text-anchor="end" font-size="10" fill="rgba(252,211,77,.75)" font-family="DM Sans" font-weight="600">média '+_tvFmtBRK(avg)+'</text>'
    : '';

  svg.innerHTML = bars + avgLine;
}

function renderTVWeeklyBars(allSalesArr){
  var svg = document.getElementById('tv-weekly-bars');
  if(!svg) return;
  // Últimas 4 semanas, agrupado por tipo
  var weeks = [];
  for(var w = 3; w >= 0; w--){
    var ini = new Date(); ini.setHours(0,0,0,0); ini.setDate(ini.getDate() - (w*7 + 6));
    var fim = new Date(); fim.setHours(0,0,0,0); fim.setDate(fim.getDate() - (w*7));
    weeks.push({ini:ini, fim:fim, NF:0, PR:0, AVULSO:0, label:'Sem ' + (4-w)});
  }
  allSalesArr.forEach(function(s){
    if(!s || !s.sale_date) return;
    var sd = new Date(s.sale_date + 'T00:00');
    for(var i = 0; i < weeks.length; i++){
      if(sd >= weeks[i].ini && sd <= weeks[i].fim){
        if(weeks[i][s.sale_type] !== undefined){
          weeks[i][s.sale_type] += parseFloat(s.total)||0;
        }
        break;
      }
    }
  });
  var maxVal = 1;
  weeks.forEach(function(wk){ maxVal = Math.max(maxVal, wk.NF, wk.PR, wk.AVULSO); });
  var W = 700, H = 200, padX = 16, padTop = 14, padBottom = 28;
  var slot = (W - padX*2) / weeks.length;
  var grpW = slot * 0.82;
  var barW = grpW / 3 - 2;
  var chartH = H - padTop - padBottom;
  var colors = {NF:'#86efac', PR:'#fbbf24', AVULSO:'#60a5fa'};

  var content = weeks.map(function(wk, i){
    var xStart = padX + i * slot + (slot - grpW)/2;
    var types = ['NF','PR','AVULSO'];
    var bars = types.map(function(t, ti){
      var v = wk[t];
      var h = (v / maxVal) * chartH;
      var y = padTop + chartH - h;
      var x = xStart + ti * (barW + 2);
      return '<rect x="'+x.toFixed(1)+'" y="'+y.toFixed(1)+'" width="'+barW.toFixed(1)+'" height="'+h.toFixed(1)+'" fill="'+colors[t]+'" rx="2"/>';
    }).join('');
    var label = '<text x="'+(xStart+grpW/2).toFixed(1)+'" y="'+(H-10)+'" text-anchor="middle" font-size="11" fill="rgba(255,255,255,.7)" font-family="DM Sans">'+wk.label+'</text>';
    return bars + label;
  }).join('');

  svg.innerHTML = content;
}

function renderTVTicker(allSalesArr){
  var el = document.getElementById('tv-ticker-inner');
  if(!el) return;
  // Pega últimas 5 vendas (qualquer tipo) por data desc
  var recent = (allSalesArr||[]).slice().filter(function(s){
    return s && s.sale_date && s.client;
  }).sort(function(a,b){
    var c = (b.sale_date||'').localeCompare(a.sale_date||'');
    if(c !== 0) return c;
    return (b.sale_time||'').localeCompare(a.sale_time||'');
  }).slice(0, 5);

  if(recent.length === 0){
    el.innerHTML = '<span style="opacity:.5">Sem vendas registradas</span>';
    return;
  }

  function buildItem(s){
    var when = s.sale_time ? s.sale_time.slice(0,5) : s.sale_date.slice(8) + '/' + s.sale_date.slice(5,7);
    var isAvaria = s.sale_type === 'AVARIA';
    var typeLabel = {NF:'NF-e', PR:'PR', AVULSO:'Avulso', AVARIA:'Avaria'}[s.sale_type] || s.sale_type;
    var prod = s.product ? ' · ' + _tvEscape(s.product) : '';
    var icon = isAvaria ? '⚠️ ' : '';
    var cls = isAvaria ? 'tk-avaria' : '';
    return '<span class="'+cls+'">'+
      '<span class="tk-time">'+when+'</span>'+
      icon + _tvEscape(s.client) + ' · ' + typeLabel + prod +
      '<span class="tk-val">'+ _tvFmtBR(Math.abs(parseFloat(s.total)||0)) +'</span>'+
    '</span>';
  }

  var items = recent.map(buildItem).join('<span class="tk-sep">●</span>');
  // duplica para loop contínuo (a animação translateX(-50%) garante a continuidade)
  el.innerHTML = items + '<span class="tk-sep">●</span>' + items;
}


// ── Atalhos de teclado ─────────────────────────────────────────────────────────
// n      = abrir modal de Lançar Venda
// /      = focar busca da aba ativa (se houver)
// Escape = fechar modal aberto
// Ignora quando o usuário está digitando em input/textarea/select/contenteditable
// ou quando ainda na tela de login.
document.addEventListener('keydown', function(e){
  // Esc para sair do Modo TV — funciona independente do login/foco
  if(e.key === 'Escape'){
    var tv = document.getElementById('tv-mode');
    if(tv && tv.classList.contains('active')){
      e.preventDefault();
      exitTVMode();
      return;
    }
  }
  // Não interfere com modificadores (Ctrl/Cmd/Alt) — preserva atalhos do navegador
  if(e.ctrlKey || e.metaKey || e.altKey) return;
  // Só ativo após login
  var appEl = document.getElementById('app');
  if(!appEl || !appEl.classList.contains('visible')) return;
  // Ignora se foco está em campo editável
  var t = e.target;
  if(t && typeof t.matches === 'function' && (t.matches('input,textarea,select') || t.isContentEditable)) return;

  if(e.key === 'n' || e.key === 'N'){
    // N só abre venda nova se não for viewer
    if(typeof session !== 'undefined' && session && session.role === 'viewer') return;
    // Não abre se modal já está aberto
    var ovOpen = document.getElementById('modal-overlay');
    if(ovOpen && ovOpen.classList.contains('open')) return;
    e.preventDefault();
    if(typeof openModal === 'function') openModal();
  } else if(e.key === '/'){
    var search = document.querySelector('.panel.active input[type="text"][placeholder*="Buscar"]')
              || document.getElementById('search-input');
    if(search){ e.preventDefault(); search.focus(); search.select && search.select(); }
  } else if(e.key === 'Escape'){
    // Fecha o modal de venda se estiver aberto
    var overlay = document.getElementById('modal-overlay');
    if(overlay && overlay.classList.contains('open') && typeof closeModal === 'function'){
      closeModal();
    }
    // Fecha menu de usuário se aberto
    var um = document.getElementById('user-menu');
    if(um && um.style.display === 'block'){ um.style.display = 'none'; }
  }
});

// ─── WhatsApp Notifications ───────────────────────────
let waConfig  = {};
let waToggles = { boleto: true, avaria: true, inativo: true };
let waSectionLoaded = false;
let waBaileysPoll = null;

async function loadWaSection() {
  if (!session || session.role !== 'admin') return;
  if (waSectionLoaded) return;
  try {
    await Promise.all([loadWaConfig(), loadWaContacts(), loadWaLog(), loadWaMotivationStatus()]);
    waSectionLoaded = true;
  } catch(e) { console.error('loadWaSection error', e); }
}

async function loadWaMotivationStatus(){
  const el=document.getElementById('wa-motivation-status');if(!el)return;
  try{
    const r=await api('/api/whatsapp/motivation-status');
    const last=r.last_success?new Date(r.last_success+'T00:00:00').toLocaleDateString('pt-BR'):'ainda nao enviado';
    el.innerHTML='<b>'+r.templates+'</b> mensagem(ns) motivacional(is) armazenada(s) · <b>'+r.active_contacts+'</b> contato(s) ativo(s) · envio diario as <b>'+waLogEsc(r.time)+'</b> · ultimo: <b>'+last+'</b>';
    el.style.color=r.templates&&r.active_contacts?'var(--muted)':'var(--red)';
  }catch(e){el.textContent='Erro ao verificar: '+e.message;el.style.color='var(--red)';}
}
async function sendWaMotivationNow(){
  if(!confirm('Enviar agora a mensagem motivacional do dia para todos os contatos ativos?'))return;
  const el=document.getElementById('wa-motivation-status');if(el)el.textContent='Enviando mensagem motivacional...';
  try{
    const r=await api('/api/whatsapp/motivation-send-now',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
    if(!r.ok)throw new Error(r.reason==='no_templates'?'Nenhuma mensagem motivacional foi encontrada no banco.':r.reason==='no_contacts'?'Nenhum contato ativo foi encontrado.':'O provedor nao confirmou o envio.');
    toast('Mensagem motivacional enviada para '+r.sent+' contato(s).');loadWaMotivationStatus();loadWaLog();
  }catch(e){toast(e.message,'error');loadWaMotivationStatus();}
}

async function loadWaConfig() {
  try {
    waConfig = await api('/api/whatsapp/config');
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };
    set('wa-provider',    waConfig.provider   || 'ultramsg');
    set('wa-api-url',     waConfig.api_url    || '');
    set('wa-api-token',   waConfig.api_token  || '');
    set('wa-instance-id', waConfig.instance_id|| '');
    set('wa-avaria-min',  waConfig.avaria_min || '25');
    set('wa-inativo-dias',waConfig.inativo_dias|| '30');
    set('wa-auto-period', waConfig.auto_period || '7');
    waToggles.boleto  = waConfig.notify_boleto  !== '0';
    waToggles.avaria  = waConfig.notify_avaria  !== '0';
    waToggles.inativo = waConfig.notify_inativo !== '0';
    ['boleto','avaria','inativo'].forEach(k => {
      document.getElementById('wt-'+k)?.classList.toggle('on', waToggles[k]);
    });
    waProviderHint();
  } catch(e) { console.warn('loadWaConfig:', e); }
}

function waProviderHint() {
  const p = document.getElementById('wa-provider')?.value;
  const h = document.getElementById('wa-provider-hint');
  const baileyPanel = document.getElementById('wa-baileys-panel');
  if (!h) return;
  const hints = {
    ultramsg:  '🔗 URL: https://api.ultramsg.com (apenas o domínio, SEM /instanceXXX no final)  |  Instance ID: somente o número, ex: 180318  |  Token: a chave longa do painel UltraMsg.',
    zapi:      '🔗 URL: https://api.z-api.io  |  Instance ID e Token gerados na conta Z-API.',
    evolution: '🔗 URL: seu servidor Evolution API  |  API Key configurada no painel Evolution.',
    baileys:   '🔗 URL: http://127.0.0.1:3001 (serviço local — não altere)  |  Token: chave API_KEY do arquivo baileys-api/.env  |  Instance ID: deixe em branco.'
  };
  h.style.display = 'block';
  h.textContent   = hints[p] || '';
  if (baileyPanel) {
    if (p === 'baileys') {
      baileyPanel.style.display = 'block';
      waLoadBaileysStatus(false);
    } else {
      baileyPanel.style.display = 'none';
      waStopBaileysPoll();
    }
  }
}

let _waLastQr = null;      // último QR renderizado (evita re-render/piscar)
let _waStatusBusy = false; // evita chamadas concorrentes
// silent=true: chamada de fundo (polling) — não reseta o texto para "Verificando"
// nem re-renderiza o QR sem necessidade, evitando o "piscar" da tela.
async function waLoadBaileysStatus(silent) {
  const statusEl = document.getElementById('wa-baileys-status');
  const qrEl     = document.getElementById('wa-baileys-qr');
  if (!statusEl) return;
  if (_waStatusBusy) return;
  _waStatusBusy = true;
  if (!silent) {
    statusEl.textContent = '⏳ Verificando serviço Baileys...';
    if (qrEl) { qrEl.style.display = 'none'; qrEl.innerHTML=''; }
    _waLastQr = null;
  }
  try {
    const r = await api('/api/whatsapp/baileys-status');
    const checked=' Verificado às '+new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit',second:'2-digit'})+'.';
    const disconnectBtn=document.getElementById('wa-baileys-disconnect');
    if (r.connected) {
      statusEl.innerHTML = '<span style="color:#22c55e;font-weight:700">✅ WhatsApp conectado</span><div style="font-size:10px;color:var(--muted);margin-top:3px">Pronto para enviar mensagens.'+checked+'</div>';
      if(disconnectBtn)disconnectBtn.disabled=false;
      if (qrEl){ qrEl.style.display='none'; qrEl.innerHTML=''; }
      _waLastQr = null;
      clearInterval(waBaileysPoll);   // conectou: para o polling (não fica atualizando)
    } else if (r.qr) {
      statusEl.innerHTML = '<span style="color:#b45309;font-weight:700">📷 Aguardando leitura do QR Code</span><div style="font-size:10px;color:var(--muted);margin-top:3px">No celular: WhatsApp → Dispositivos conectados → Conectar dispositivo.'+checked+'</div>';
      if(disconnectBtn)disconnectBtn.disabled=true;
      if (qrEl) {
        if (_waLastQr !== r.qr) {   // só re-renderiza a imagem se o QR mudou (evita piscar)
          _waLastQr = r.qr;
          const encoded = encodeURIComponent(r.qr);
          qrEl.innerHTML = '<img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data='+encoded+'" style="border-radius:8px;border:3px solid #fff;box-shadow:0 2px 12px rgba(0,0,0,.15)" alt="QR Code WhatsApp">';
        }
        qrEl.style.display = 'block';
      }
    } else {
      statusEl.innerHTML = '<span style="color:#b45309;font-weight:700">⚠️ WhatsApp desconectado</span><div style="font-size:10px;color:var(--muted);margin-top:3px">'+waLogEsc(r.message||'Sessao sem conexao. Tente reconectar ou gere um novo QR Code.')+checked+'</div>';
      if(disconnectBtn)disconnectBtn.disabled=true;
      if (qrEl){ qrEl.style.display='none'; qrEl.innerHTML=''; }
      _waLastQr = null;
    }
  } catch(e) {
    // Em polling silencioso não fica piscando o erro; só mostra na verificação manual.
    if (!silent) statusEl.innerHTML = '<span style="color:var(--red)">❌ Baileys inacessível: ' + waLogEsc(e.message) + '</span>';
  } finally {
    _waStatusBusy = false;
  }
}

async function waBaileysConnection(action){
  if(action==='disconnect'&&!confirm('Desconectar esta conta e apagar a sessao atual? Sera necessario escanear um novo QR Code.'))return;
  const statusEl=document.getElementById('wa-baileys-status');
  if(statusEl)statusEl.innerHTML='<span style="color:var(--muted)">Processando '+(action==='disconnect'?'nova sessao':'reconexao')+'...</span>';
  try{
    const r=await api('/api/whatsapp/baileys-connection/'+action,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
    toast(r.message||'Comando enviado.');
    // Primeira leitura imediata (não silenciosa) e depois polling silencioso e estável.
    clearInterval(waBaileysPoll); _waLastQr=null; let attempts=0;
    waLoadBaileysStatus(false);
    waBaileysPoll=setInterval(function(){
      attempts++;
      waLoadBaileysStatus(true);           // silencioso: não pisca a tela
      if(attempts>=24) clearInterval(waBaileysPoll);   // ~60s para escanear o QR
    },2500);
  }catch(e){if(statusEl)statusEl.innerHTML='<span style="color:var(--red)">Falha: '+waLogEsc(e.message)+'</span>';toast(e.message,'error');}
}

// Para o polling do Baileys quando sai da aba/troca de provedor (evita ficar rodando em fundo).
function waStopBaileysPoll(){ if(waBaileysPoll){ clearInterval(waBaileysPoll); waBaileysPoll=null; } }

async function saveWaConfig() {
  try {
    await api('/api/whatsapp/config', {
      method: 'PUT',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        provider:    document.getElementById('wa-provider')?.value,
        api_url:     document.getElementById('wa-api-url')?.value,
        api_token:   document.getElementById('wa-api-token')?.value,
        instance_id: document.getElementById('wa-instance-id')?.value
      })
    });
    toast('✅ Configuração salva!');
  } catch(e) { toast(e.message, 'error'); }
}

function waToggle(k) {
  waToggles[k] = !waToggles[k];
  document.getElementById('wt-'+k)?.classList.toggle('on', waToggles[k]);
}

async function saveWaToggles() {
  try {
    await api('/api/whatsapp/config', {
      method: 'PUT',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        notify_boleto:  waToggles.boleto  ? '1' : '0',
        notify_avaria:  waToggles.avaria  ? '1' : '0',
        notify_inativo: waToggles.inativo ? '1' : '0',
        avaria_min:   document.getElementById('wa-avaria-min')?.value,
        inativo_dias: document.getElementById('wa-inativo-dias')?.value,
        auto_period:  document.getElementById('wa-auto-period')?.value
      })
    });
    toast('✅ Gatilhos salvos!');
  } catch(e) { toast(e.message, 'error'); }
}

async function waCheckTriggers() {
  var el=document.getElementById('wa-trigger-result');
  if(!el)return;
  el.style.display='block';
  el.innerHTML='<div style="text-align:center;padding:12px;color:var(--muted)">🔍 Verificando...</div>';
  try {
    var r=await api('/api/whatsapp/check-triggers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({send:false})});
    if(!r.triggers_fired){
      el.innerHTML='<div style="display:flex;align-items:center;gap:8px;color:#22c55e;font-weight:600;font-size:13px">✅ Nenhum gatilho foi acionado. Tudo em ordem!</div>';
      return;
    }
    var html='<div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:8px">🔍 Resultado da verificação</div>';
    var icons={boleto:'📄',avaria:'⚠️',inativo:'😴'};
    var labels={boleto:'Boletos vencidos',avaria:'Avarias altas',inativo:'Clientes inativos'};
    r.messages.forEach(function(m){
      html+='<div style="margin-bottom:10px;padding:10px;background:var(--card2);border-radius:8px;font-size:12px">'
        +'<div style="font-weight:700;margin-bottom:4px">'+(icons[m.type]||'🔔')+' '+(labels[m.type]||m.type)+' ('+m.count+')</div>'
        +'<pre style="white-space:pre-wrap;font-family:inherit;font-size:11px;color:var(--g800);margin:0;line-height:1.5">'+m.preview+'</pre></div>';
    });
    html+='<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:4px">'
      +'<button class="btn btn-secondary btn-sm" onclick="document.getElementById(\'wa-trigger-result\').style.display=\'none\'">Fechar</button>'
      +'<button class="btn btn-primary btn-sm" onclick="waSendTriggers()">📤 Enviar notificações</button>'
      +'</div>';
    el.innerHTML=html;
  } catch(e) { el.innerHTML='<div style="color:var(--red);font-size:12px">❌ '+e.message+'</div>'; }
}

async function waSendTriggers() {
  if(!confirm('Enviar notificações dos gatilhos para TODOS os contatos ativos?'))return;
  var el=document.getElementById('wa-trigger-result');
  if(!el)return;
  el.innerHTML='<div style="text-align:center;padding:12px;color:var(--muted)">📤 Enviando...</div>';
  try {
    var r=await api('/api/whatsapp/check-triggers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({send:true})});
    var ok=(r.sent||[]).filter(function(x){return x.ok;}).length;
    var bad=(r.sent||[]).filter(function(x){return !x.ok;}).length;
    var firstError=(r.sent||[]).find(function(x){return !x.ok;});
    el.innerHTML='<div style="display:flex;align-items:center;gap:8px;font-weight:600;font-size:13px">📤 Notificações enviadas: '+ok+' ✅'+(bad?'  '+bad+' ❌':'')+'</div>'
      +'<div style="margin-top:6px;font-size:11px;color:var(--muted)">'+r.triggers_fired+' gatilho(s) acionado(s) · '+(r.sent||[]).length+' envio(s)</div>'
      +(firstError?'<div style="margin-top:8px;padding:9px;background:var(--red-l);border-radius:7px;color:var(--red);font-size:11px"><b>Motivo:</b> '+waLogEsc(firstError.response||'Falha sem detalhe')+'<br><b>Como corrigir:</b> '+waLogEsc(firstError.hint||'Consulte o log de envios.')+'</div>':'')
      +'<div style="margin-top:8px"><button class="btn btn-secondary btn-sm" onclick="document.getElementById(\'wa-trigger-result\').style.display=\'none\'">Fechar</button></div>';
    loadWaLog();
  } catch(e) { el.innerHTML='<div style="color:var(--red);font-size:12px">❌ '+e.message+'</div>'; }
}

async function loadWaContacts() {
  const el = document.getElementById('wa-contacts-list');
  if (!el) return;
  try {
    const contacts = await api('/api/whatsapp/contacts');
    if (!contacts.length) {
      el.innerHTML = '<div class="wa-empty">Nenhum contato cadastrado.</div>';
      return;
    }
    el.innerHTML = contacts.map(function(c) {
      const init = (c.name || '?').trim().split(/\s+/).slice(0,2).map(function(w){return w[0]||'';}).join('').toUpperCase();
      return '<div class="wa-contact-row">'
        +'<div class="wa-avatar">'+init+'</div>'
        +'<div class="wa-contact-info"><div class="wa-contact-name">'+c.name+'</div><div class="wa-contact-phone">+'+c.phone+'</div></div>'
        +'<span class="'+(c.active?'wa-badge-active':'wa-badge-inactive')+'">'+(c.active?'Ativo':'Inativo')+'</span>'
        +'<button class="btn btn-secondary btn-sm" onclick="waTest(\''+c.id+'\',\''+c.name.replace(/'/g,"\'")+'\')">🧪 Testar</button>'
        +'<button class="btn btn-sm" style="background:var(--card2);color:var(--muted)" onclick="waToggleContact(\''+c.id+'\','+(c.active?0:1)+')">'+(c.active?'⏸ Pausar':'▶ Ativar')+'</button>'
        +'<button class="btn btn-danger btn-sm" onclick="waDeleteContact(\''+c.id+'\',\''+c.name.replace(/'/g,"\'")+'\')">🗑</button>'
        +'</div>';
    }).join('');
  } catch(e) { el.innerHTML = '<div class="wa-empty">'+e.message+'</div>'; }
}

function openWaContactModal() {
  ['wa-c-name','wa-c-phone'].forEach(function(id){var el=document.getElementById(id);if(el)el.value='';});
  var err=document.getElementById('wa-c-err');if(err)err.style.display='none';
  var modal=document.getElementById('wa-contact-modal');if(modal)modal.style.display='flex';
}

function closeWaContactModal() {
  var modal=document.getElementById('wa-contact-modal');if(modal)modal.style.display='none';
}

async function saveWaContact() {
  var name=document.getElementById('wa-c-name')?.value.trim();
  var phone=document.getElementById('wa-c-phone')?.value.trim();
  var err=document.getElementById('wa-c-err');if(err)err.style.display='none';
  if(!name||!phone){if(err){err.textContent='Preencha nome e telefone.';err.style.display='block';}return;}
  try {
    await api('/api/whatsapp/contacts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name,phone:phone})});
    toast('✅ Contato cadastrado!');closeWaContactModal();loadWaContacts();
  } catch(e) { if(err){err.textContent=e.message;err.style.display='block';} }
}

async function waToggleContact(id, newActive) {
  try {
    await api('/api/whatsapp/contacts/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({active:newActive})});
    loadWaContacts();
  } catch(e) { toast(e.message, 'error'); }
}

async function waDeleteContact(id, name) {
  if (!confirm('Remover "'+name+'" das notificações?')) return;
  try {
    await api('/api/whatsapp/contacts/'+id,{method:'DELETE'});
    toast('Contato removido.');loadWaContacts();
  } catch(e) { toast(e.message, 'error'); }
}

async function waTest(id, name) {
  toast('🧪 Enviando teste para '+name+'...');
  try {
    var r=await api('/api/whatsapp/test/'+id,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
    toast(r.ok?'✅ Teste enviado para '+name+'!':'Falha: '+r.response+' '+(r.hint||''),r.ok?undefined:'error');
    loadWaLog();
  } catch(e) { toast(e.message, 'error'); }
}

async function waSendManual() {
  var msg=document.getElementById('wa-manual-msg')?.value.trim();
  if (!msg) { toast('Digite a mensagem antes de enviar.','error'); return; }
  if (!confirm('Enviar esta mensagem para TODOS os contatos ativos?')) return;
  try {
    var r=await api('/api/whatsapp/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg,event_type:'manual'})});
    var ok=(r.results||[]).filter(function(x){return x.ok;}).length;
    var bad=(r.results||[]).filter(function(x){return !x.ok;}).length;
    var firstError=(r.results||[]).find(function(x){return !x.ok;});
    toast(bad?('Falha em '+bad+' envio(s): '+((firstError&&firstError.response)||'consulte o log')+' '+((firstError&&firstError.hint)||'')):('📲 Enviado: '+ok+' ✅'),bad?'error':undefined);
    loadWaLog();
  } catch(e) { toast(e.message, 'error'); }
}

function waPreviewMsg() {
  var msg=document.getElementById('wa-manual-msg')?.value.trim();
  if (msg) alert('Prévia:\n\n'+msg);
}

var _waLogPage = 1;
function waLogEsc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function waLogDiagnostic(l){
  var raw=l.response||'',data={response:raw,hint:''};
  try{var parsed=JSON.parse(raw);if(parsed&&typeof parsed==='object')data=parsed;}catch(e){}
  var detail=String(data.response||raw||'O provedor nao informou detalhes.'),low=detail.toLowerCase();
  if(!data.hint){
    if(/401|403|unauthorized|forbidden/.test(low))data.hint='Confira o token ou API Key configurado.';
    else if(/404|not found/.test(low))data.hint='Confira a URL da API e o ID da instancia.';
    else if(/timeout|timed out/.test(low))data.hint='O provedor nao respondeu. Verifique se o servico esta online.';
    else if(/connect|refused/.test(low))data.hint='O servidor nao conseguiu acessar a API. Confira URL, porta e firewall.';
    else data.hint='Confira token, instancia, conexao do WhatsApp e numero do contato.';
  }
  return {provider:data.provider||'nao informado',http:data.http_status||'',detail:detail,hint:data.hint};
}
function toggleWaLogDetail(id,btn){var el=document.getElementById(id);if(!el)return;var open=el.classList.toggle('open');if(btn)btn.textContent=open?'Ocultar diagnostico':'Ver diagnostico';}
async function loadWaLog(page) {
  if(page !== undefined) _waLogPage = page;
  const el = document.getElementById('wa-log-list');
  if (!el) return;
  try {
    var r=await api('/api/whatsapp/log?page='+_waLogPage+'&limit=10');
    var logs=r.logs||[], total=r.total||0, pages=r.pages||1;
    if(_waLogPage>pages){ _waLogPage=pages; loadWaLog(); return; }
    var counter=document.getElementById('wa-log-counter');
    if(counter) counter.textContent=total>0?'Mostrando '+((_waLogPage-1)*10+1)+'–'+Math.min(_waLogPage*10,total)+' de '+total:'';
    if (!logs.length) { el.innerHTML='<div class="wa-empty">Nenhum envio registrado.</div>'; renderWaLogPages(1,1); return; }
    el.innerHTML = logs.map(function(l,index) {
      var msgShort = (l.message||'').length > 80 ? l.message.slice(0,77)+'…' : (l.message||'');
      var diag=waLogDiagnostic(l),detailId='wa-log-detail-'+index;
      return '<div class="wa-log-item"><div class="wa-log-row">'
        +'<div class="wa-log-dot '+l.status+'"></div>'
        +'<div style="flex:1;min-width:0"><div style="font-weight:600">'+waLogEsc(l.contact||'?')+' <span style="font-family:monospace;font-size:11px;color:var(--muted)">'+waLogEsc(l.phone)+'</span></div>'
        +'<div style="color:var(--muted);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+waLogEsc(l.message||'')+'">'+waLogEsc(msgShort||'')+'</div>'+(l.status!=='sent'?'<button class="wa-log-diagnostic" onclick="toggleWaLogDetail(\''+detailId+'\',this)">Ver diagnostico</button>':'')+'</div>'
        +'<div style="text-align:right;flex-shrink:0;min-width:90px"><div style="font-size:10px;color:var(--muted)">'+new Date(l.sent_at).toLocaleString('pt-BR')+'</div>'
        +'<div style="font-size:10px;font-weight:700;color:'+(l.status==='sent'?'#22c55e':'var(--red)')+'">'+(l.status==='sent'?'✅ Enviado':'❌ Erro')+'</div>'
        +'<div style="font-size:9px;color:var(--muted)">'+waLogEsc(l.event_type)+'</div></div>'
        +'<button class="wa-log-del" onclick="if(confirm(\'Excluir este log?\'))deleteWaLog(\''+l.id+'\')" title="Excluir">✕</button></div>'
        +(l.status!=='sent'?'<div id="'+detailId+'" class="wa-log-detail"><b>Motivo:</b> '+waLogEsc(diag.detail)+'<br><b>Como corrigir:</b> '+waLogEsc(diag.hint)+'<br><b>Provedor:</b> '+waLogEsc(diag.provider)+(diag.http?' · <b>HTTP:</b> '+waLogEsc(diag.http):'')+'<code>'+waLogEsc(l.response||'Sem resposta tecnica.')+'</code></div>':'')+'</div>';
    }).join('');
    renderWaLogPages(_waLogPage, pages);
  } catch(e) { el.innerHTML = '<div class="wa-empty">'+e.message+'</div>'; renderWaLogPages(1,1); }
}
function renderWaLogPages(cur, total){
  var el=document.getElementById('wa-log-pages');
  if(!el) return;
  if(total<=1){ el.innerHTML=''; return; }
  el.innerHTML='<button onclick="loadWaLog(1)"'+(cur<=1?' disabled':'')+'>&laquo;</button>'
    +'<button onclick="loadWaLog('+(cur-1)+')"'+(cur<=1?' disabled':'')+'>&lsaquo; Anterior</button>'
    +'<span style="font-weight:600;color:var(--ink)">'+cur+'/'+total+'</span>'
    +'<button onclick="loadWaLog('+(cur+1)+')"'+(cur>=total?' disabled':'')+'>Próximo &rsaquo;</button>'
    +'<button onclick="loadWaLog('+total+')"'+(cur>=total?' disabled':'')+'>&raquo;</button>';
}
async function deleteWaLog(id){
  try{
    await api('/api/whatsapp/log/'+id,{method:'DELETE'});
    loadWaLog();
  }catch(e){ toast(e.message,'error'); }
}
// ── Sub-tab switching ──
function switchWaSubView(view){
  document.querySelectorAll('.wa-sub-btn').forEach(function(b){
    b.classList.toggle('active', b.dataset.view === view);
  });
  ['main','autoreply','templates','bot'].forEach(function(v){
    var el=document.getElementById('wa-view-'+v);
    if(el) el.style.display = v===view ? 'block' : 'none';
  });
  if(view==='autoreply') loadWaAutoRules();
  if(view==='templates') loadWaTemplates();
  if(view==='bot') loadWaBotSettings();
}

// ── Auto Rules CRUD ──
var _waRules = [];

function _waRuleIcon(type){
  return type==='auto_reply' ? '🤖' : '📢';
}
function _waRuleLabel(type){
  return type==='auto_reply' ? 'Auto resposta' : 'Gatilho';
}

async function loadWaAutoRules(){
  var el=document.getElementById('wa-autorules-list');
  if(!el) return;
  try{
    var rules=await api('/api/whatsapp/auto-rules');
    _waRules=rules;
    if(!rules.length){ el.innerHTML='<div class="wa-empty">Nenhuma regra cadastrada. Crie uma regra de gatilho ou auto resposta.</div>'; return; }
    el.innerHTML=rules.map(function(r){
      var meta=[];
      if(r.rule_type==='auto_reply' && r.keyword) meta.push('🔑 '+r.keyword);
      if(r.event_key) meta.push('⚡ '+r.event_key);
      if(r.priority>0) meta.push('🎯 Prioridade '+r.priority);
      if(r.cooldown_min>0) meta.push('⏳ '+r.cooldown_min+'min cooldown');
      return '<div class="wa-rule-row">'
        +'<div class="wa-rule-info"><div class="wa-rule-name">'+_waRuleIcon(r.rule_type)+' '+r.name+'</div>'
        +'<div class="wa-rule-meta"><span class="wa-rule-tag '+(r.rule_type==='auto_reply'?'reply':'trigger')+'">'+_waRuleLabel(r.rule_type)+'</span>'
        +(meta.length?' <span style="color:var(--g600)">'+meta.join(' · ')+'</span>':'')
        +'</div></div>'
        +'<button class="wa-rule-switch'+(r.enabled?' on':'')+'" onclick="waToggleAutoRule(\''+r.id+'\','+(r.enabled?'0':'1')+')" title="'+(r.enabled?'Desativar':'Ativar')+'"></button>'
        +'<div class="wa-rule-actions">'
        +'<button onclick="waOpenAutoRuleModal(\''+r.id+'\')" title="Editar">✏️</button>'
        +'<button class="danger" onclick="waDeleteAutoRule(\''+r.id+'\',\''+r.name.replace(/'/g,"\'")+'\')" title="Excluir">🗑</button>'
        +'</div></div>';
    }).join('');
  }catch(e){ el.innerHTML='<div class="wa-empty">'+e.message+'</div>'; }
}

function waOpenAutoRuleModal(id){
  var rule=id ? _waRules.find(function(r){return r.id===id;}) : null;
  document.getElementById('wa-rule-modal-title').textContent=rule ? '✏️ Editar regra' : '➕ Nova regra';
  document.getElementById('war-edit-id').value=rule ? rule.id : '';
  document.getElementById('war-name').value=rule ? rule.name : '';
  document.getElementById('war-type').value=rule ? rule.rule_type : 'trigger';
  document.getElementById('war-enabled').value=rule ? (rule.enabled?'1':'0') : '1';
  document.getElementById('war-event').value=rule ? (rule.event_key||'') : '';
  document.getElementById('war-keyword').value=rule ? (rule.keyword||'') : '';
  document.getElementById('war-message').value=rule ? (rule.message||'') : '';
  document.getElementById('war-priority').value=rule ? (rule.priority||0) : 0;
  document.getElementById('war-cooldown').value=rule ? (rule.cooldown_min||0) : 0;
  document.getElementById('war-sch-from').value=rule ? (rule.schedule_from||'08:00') : '08:00';
  document.getElementById('war-sch-to').value=rule ? (rule.schedule_to||'19:00') : '19:00';
  document.getElementById('war-repeatable').value=rule ? (rule.repeatable?'1':'0') : '1';
  document.getElementById('war-maxday').value=rule ? (rule.max_per_day||5) : 5;
  waRuleTypeToggle();
  waRulePreview();
  document.getElementById('wa-rule-modal').style.display='flex';
}

function waCloseAutoRuleModal(){
  document.getElementById('wa-rule-modal').style.display='none';
}

function waRuleTypeToggle(){
  var t=document.getElementById('war-type').value;
  document.getElementById('war-event-wrap').style.display=t==='trigger' ? 'block' : 'none';
  document.getElementById('war-keyword-wrap').style.display=t==='auto_reply' ? 'block' : 'none';
}

function waRulePreview(){
  var msg=document.getElementById('war-message').value;
  var previewEl=document.getElementById('war-msg-preview');
  var contentEl=document.getElementById('war-preview-content');
  if(!msg.trim()){ previewEl.style.display='none'; return; }
  previewEl.style.display='block';
  contentEl.textContent=msg.replace(/\{cliente\}/g,'EXEMPLO CLIENTE').replace(/\{valor\}/g,'R$ 1.234,56').replace(/\{vencimento\}/g,'15/07/2026').replace(/\{taxa\}/g,'25%').replace(/\{data\}/g,'14/06/2026').replace(/\{empresa\}/g,'Menina dos Raios');
}

async function waSaveAutoRule(){
  var name=document.getElementById('war-name').value.trim();
  var msg=document.getElementById('war-message').value.trim();
  if(!name){ toast('Nome da regra obrigatório.','error'); return; }
  if(!msg){ toast('Mensagem não pode ficar vazia.','error'); return; }
  var body={
    name: name,
    rule_type: document.getElementById('war-type').value,
    enabled: parseInt(document.getElementById('war-enabled').value),
    event_key: document.getElementById('war-type').value==='trigger' ? document.getElementById('war-event').value : '',
    keyword: document.getElementById('war-type').value==='auto_reply' ? document.getElementById('war-keyword').value.trim() : '',
    message: msg,
    priority: parseInt(document.getElementById('war-priority').value)||0,
    schedule_from: document.getElementById('war-sch-from').value,
    schedule_to: document.getElementById('war-sch-to').value,
    cooldown_min: parseInt(document.getElementById('war-cooldown').value)||0,
    repeatable: parseInt(document.getElementById('war-repeatable').value),
    max_per_day: parseInt(document.getElementById('war-maxday').value)||0
  };
  var editId=document.getElementById('war-edit-id').value;
  try{
    if(editId){
      await api('/api/whatsapp/auto-rules/'+editId,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      toast('✅ Regra atualizada!');
    } else {
      await api('/api/whatsapp/auto-rules',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      toast('✅ Regra criada!');
    }
    waCloseAutoRuleModal();
    loadWaAutoRules();
  }catch(e){ toast(e.message,'error'); }
}

async function waToggleAutoRule(id, enabled){
  try{
    await api('/api/whatsapp/auto-rules/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:enabled})});
    loadWaAutoRules();
  }catch(e){ toast(e.message,'error'); }
}

async function waDeleteAutoRule(id, name){
  if(!confirm('Excluir regra "'+name+'"?')) return;
  try{
    await api('/api/whatsapp/auto-rules/'+id,{method:'DELETE'});
    toast('Regra excluída.');
    loadWaAutoRules();
  }catch(e){ toast(e.message,'error'); }
}

// ── Templates CRUD ──
var _waTemplates = [];

async function loadWaTemplates(){
  var el=document.getElementById('wa-templates-list');
  if(!el) return;
  try{
    var tpls=await api('/api/whatsapp/templates');
    _waTemplates=tpls;
    if(!tpls.length){ el.innerHTML='<div class="wa-empty">Nenhum modelo cadastrado. Crie modelos de mensagem para reutilizar.</div>'; return; }
    el.innerHTML=tpls.map(function(t){
      var catLabel=t.category ? ' <span class="wa-rule-tag template">'+t.category+'</span>' : '';
      return '<div class="wa-rule-row">'
        +'<div class="wa-rule-info"><div class="wa-rule-name">📦 '+t.name+catLabel+'</div>'
        +'<div class="wa-rule-meta" style="color:var(--g600)">'+(t.content||'').slice(0,80)+(t.content&&t.content.length>80?'…':'')+'</div></div>'
        +'<div class="wa-rule-actions">'
        +'<button onclick="waOpenTemplateModal(\''+t.id+'\')" title="Editar">✏️</button>'
        +'<button onclick="waDuplicateTemplate(\''+t.id+'\')" title="Duplicar">📋</button>'
        +'<button class="danger" onclick="waDeleteTemplate(\''+t.id+'\',\''+t.name.replace(/'/g,"\'")+'\')" title="Excluir">🗑</button>'
        +'</div></div>';
    }).join('');
  }catch(e){ el.innerHTML='<div class="wa-empty">'+e.message+'</div>'; }
}

function waOpenTemplateModal(id){
  var tpl=id ? _waTemplates.find(function(t){return t.id===id;}) : null;
  document.getElementById('wa-tpl-modal-title').textContent=tpl ? '✏️ Editar modelo' : '➕ Novo modelo';
  document.getElementById('wat-edit-id').value=tpl ? tpl.id : '';
  document.getElementById('wat-name').value=tpl ? tpl.name : '';
  document.getElementById('wat-cat').value=tpl ? (tpl.category||'') : '';
  document.getElementById('wat-content').value=tpl ? (tpl.content||'') : '';
  waTemplatePreview();
  document.getElementById('wa-template-modal').style.display='flex';
}

function waCloseTemplateModal(){
  document.getElementById('wa-template-modal').style.display='none';
}

function waTemplatePreview(){
  var content=document.getElementById('wat-content').value;
  var preview=document.getElementById('wat-preview');
  if(!preview) return;
  if(!content.trim()){ preview.textContent='Digite o conteúdo acima para ver a prévia...'; return; }
  preview.textContent=content.replace(/\{cliente\}/g,'EXEMPLO CLIENTE').replace(/\{valor\}/g,'R$ 1.234,56').replace(/\{vencimento\}/g,'15/07/2026').replace(/\{taxa\}/g,'25%').replace(/\{data\}/g,'14/06/2026').replace(/\{empresa\}/g,'Menina dos Raios');
}

async function waSaveTemplate(){
  var name=document.getElementById('wat-name').value.trim();
  var content=document.getElementById('wat-content').value.trim();
  if(!name){ toast('Nome do modelo obrigatório.','error'); return; }
  if(!content){ toast('Conteúdo do modelo não pode ficar vazio.','error'); return; }
  var body={name:name, category:document.getElementById('wat-cat').value, content:content};
  var editId=document.getElementById('wat-edit-id').value;
  try{
    if(editId){
      await api('/api/whatsapp/templates/'+editId,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      toast('✅ Modelo atualizado!');
    } else {
      await api('/api/whatsapp/templates',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      toast('✅ Modelo criado!');
    }
    waCloseTemplateModal();
    loadWaTemplates();
  }catch(e){ toast(e.message,'error'); }
}

async function waDuplicateTemplate(id){
  var tpl=_waTemplates.find(function(t){return t.id===id;});
  if(!tpl) return;
  try{
    await api('/api/whatsapp/templates',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:tpl.name+' (cópia)', category:tpl.category||'', content:tpl.content||''})});
    toast('📋 Modelo duplicado!');
    loadWaTemplates();
  }catch(e){ toast(e.message,'error'); }
}

async function waDeleteTemplate(id, name){
  if(!confirm('Excluir modelo "'+name+'"?')) return;
  try{
    await api('/api/whatsapp/templates/'+id,{method:'DELETE'});
    toast('Modelo excluído.');
    loadWaTemplates();
  }catch(e){ toast(e.message,'error'); }
}

// ── Bot Settings ──
async function loadWaBotSettings(){
  var el=document.getElementById('wa-bot-settings-form');
  if(!el) return;
  try{
    var s=await api('/api/whatsapp/bot-settings');
    el.innerHTML='<div class="wa-bot-grid">'
      +'<div class="wa-bot-item"><label>🤖 Bot ativo</label><div class="wa-toggle-wrap"><input type="checkbox" id="wbs-bot-active"'+(s.bot_active==='1'?' checked':'')+'></div></div>'
      +'<div class="wa-bot-item"><label>💬 Auto respostas</label><div class="wa-toggle-wrap"><input type="checkbox" id="wbs-auto-reply-enabled"'+(s.auto_reply_enabled==='1'?' checked':'')+'></div></div>'
      +'<div class="wa-bot-item"><label>🧪 Modo teste</label><div class="wa-toggle-wrap"><input type="checkbox" id="wbs-test-mode"'+(s.test_mode==='1'?' checked':'')+'></div></div>'
      +'<div class="wa-bot-item"><label>🚫 Bloquear grupos</label><div class="wa-toggle-wrap"><input type="checkbox" id="wbs-block-groups"'+(s.block_groups==='1'?' checked':'')+'></div></div>'
      +'<div class="wa-bot-item"><label>🔁 Bloquear duplicado</label><div class="wa-toggle-wrap"><input type="checkbox" id="wbs-block-duplicate"'+(s.block_duplicate==='1'?' checked':'')+'></div></div>'
      +'<div class="wa-bot-item"><label>⏰ Horário início</label><input type="time" id="wbs-auto-reply-from" value="'+(s.auto_reply_from||'08:00')+'"></div>'
      +'<div class="wa-bot-item"><label>⏰ Horário fim</label><input type="time" id="wbs-auto-reply-to" value="'+(s.auto_reply_to||'19:00')+'"></div>'
      +'<div class="wa-bot-item"><label>⏱ Intervalo min (seg)</label><input type="number" id="wbs-min-interval" value="'+(s.min_interval_secs||'30')+'" min="1"></div>'
      +'<div class="wa-bot-item"><label>📊 Máx/dia/cliente</label><input type="number" id="wbs-max-per-day" value="'+(s.max_per_day_per_client||'10')+'" min="0"></div>'
      +'</div>';
  }catch(e){ el.innerHTML='<div class="wa-empty">'+e.message+'</div>'; }
}

async function saveWaBotSettings(){
  var body={};
  ['bot-active','auto-reply-enabled','test-mode','block-groups','block-duplicate'].forEach(function(k){
    body[k.replace(/-/g,'_')]=document.getElementById('wbs-'+k)?.checked ? '1' : '0';
  });
  body.auto_reply_from=document.getElementById('wbs-auto-reply-from')?.value||'08:00';
  body.auto_reply_to=document.getElementById('wbs-auto-reply-to')?.value||'19:00';
  body.min_interval_secs=parseInt(document.getElementById('wbs-min-interval')?.value)||30;
  body.max_per_day_per_client=parseInt(document.getElementById('wbs-max-per-day')?.value)||10;
  try{
    await api('/api/whatsapp/bot-settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    toast('✅ Configurações do bot salvas!');
  }catch(e){ toast(e.message,'error'); }
}

// ─── fim WhatsApp ──────────────────────────────────────

// ━━ PALADAR APP (overlay independente) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
let palChart1 = null, palChart2 = null, palChart3 = null, palChart4 = null;
let _palItems = [];

function getPalFilterMonth(){ return document.getElementById('pal-filter-month')?.value || ''; }
function getPalFilterYear(){ return document.getElementById('pal-filter-year')?.value || ''; }
function getPalPeriod(){ return document.getElementById('pal-filter-period')?.value || 'mensal'; }
function togglePalPeriodFields(){
  var p = getPalPeriod();
  var m = document.getElementById('pal-filter-month');
  var y = document.getElementById('pal-filter-year');
  if(!m||!y) return;
  if(p==='quinzenal'){ m.style.display='none'; y.style.display='none'; }
  else if(p==='anual'){ m.style.display=''; y.style.display=''; }
  else { m.style.display=''; y.style.display=''; }
}

function openPaladarApp(){
  document.getElementById('paladar-app').classList.add('active');
  document.body.classList.add('paladar-active');
  togglePalPeriodFields();
  applyMonteiroCalendarPermUI();
  switchPaladarTab('painel');
  loadPaladarProducts();
  refreshAppCalendarBadge();
}

function closePaladarApp(){
  document.getElementById('paladar-app').classList.remove('active');
  document.body.classList.remove('paladar-active');
}

function openOrcamentoFromMonteiro(){
  closePaladarApp();
  var tab=document.querySelector('.tabs-wrap .tab[onclick*="orcamento"]');
  if(tab) switchTab(tab,'orcamento');
  else if(typeof loadOrcamento==='function') loadOrcamento();
}

function switchPaladarTab(tab){
  if(tab==='calendario' && !canUseMonteiroCalendar()){
    toast('Seu perfil não tem permissão para acessar o Calendário APP.','error');
    tab='painel';
  }
  var app=document.getElementById('paladar-app');
  if(app) app.classList.toggle('pal-pay-compact', tab==='pagamentos');
  var scroller=app ? app.querySelector(':scope > div:nth-child(3)') : null;
  if(scroller) scroller.scrollTop = 0;
  ['painel','lancamentos','produtos','clientes','notasapp','calendario','pagamentos'].forEach(function(t){
    var v = document.getElementById('pal-view-'+t);
    if(v) v.style.display = (t===tab ? 'block' : 'none');
    var b = document.getElementById('pal-tab-'+t);
    if(b){
      b.style.background = (t===tab ? '#4F46E5' : 'transparent');
      b.style.color = (t===tab ? '#fff' : 'var(--muted)');
    }
  });
  if(tab==='painel') loadPaladarSummary();
  else if(tab==='lancamentos') loadPaladarSales();
  else if(tab==='produtos') loadPaladarProducts();
  else if(tab==='clientes') loadPaladarClients();
  else if(tab==='notasapp') loadAppNotes();
  else if(tab==='calendario') loadAppCalendar();
  else if(tab==='pagamentos'){ loadMonteiroPaymentPermUI(); loadPaladarPayments(); }
}

/* ── Notas APP: pedidos recebidos do Android ─────────────────────────────── */
var _appNotes=[];
var _appNotesTimer=null;
var _appNotesStatus='pending';
var _appNotesPendingNotif=[];
function debounceAppNotes(){ clearTimeout(_appNotesTimer); _appNotesTimer=setTimeout(loadAppNotes,350); }
function appNoteMoney(v){ return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}); }
function appNoteQty(v){ return Number(v||0).toLocaleString('pt-BR',{maximumFractionDigits:3}); }
function appNoteMeasureLabel(unit){return ({KG:'Peso',UN:'Unidade',CX:'Caixa',MC:'Maço',SC:'Saco'})[String(unit||'').toUpperCase()]||'Medida';}
function appNoteHasPrice(i){return i&&i.effective_price_provided!==undefined?!!i.effective_price_provided:Number(i&&i.price_provided)!==0;}
function appNoteUnitPrice(i){return i&&i.effective_unit_price!==undefined?Number(i.effective_unit_price||0):Number(i&&i.unit_price||0);}
function switchAppNotesStatus(status){
  _appNotesStatus=status==='completed'?'completed':'pending';
  var p=document.getElementById('app-notes-tab-pending'),c=document.getElementById('app-notes-tab-completed');
  if(p)p.className='btn btn-sm '+(_appNotesStatus==='pending'?'btn-primary':'btn-secondary');
  if(c)c.className='btn btn-sm '+(_appNotesStatus==='completed'?'btn-primary':'btn-secondary');
  loadAppNotes();
}

async function loadAppNotes(){
  var wrap=document.getElementById('app-notes-wrap'); if(!wrap)return;
  wrap.innerHTML='<div class="wa-empty" style="padding:36px">Carregando notas do aplicativo...</div>';
  var q=new URLSearchParams();
  q.set('status',_appNotesStatus);
  var client=document.getElementById('app-notes-client')?.value?.trim()||'';
  if(client)q.set('client',client);
  var month=getPalFilterMonth(),year=getPalFilterYear(); if(month)q.set('month',month); if(year)q.set('year',year);
  try{
    var data=await api('/api/app-notes'+(q.toString()?'?'+q.toString():''));
    _appNotes=data.notes||[]; renderAppNotes(data);
    if(_appNotesStatus==='pending'){_appNotesPendingNotif=_appNotes.slice();updateAppNotesNotificationUI();}
  }catch(e){ wrap.innerHTML='<div class="wa-empty" style="padding:36px;color:#b91c1c">'+admEsc(e.message)+'</div>'; }
}

function renderAppNotes(data){
  var kpis=document.getElementById('app-notes-kpis'),wrap=document.getElementById('app-notes-wrap'); if(!kpis||!wrap)return;
  var clients=new Set(_appNotes.map(function(n){return n.client||'Sem cliente';})).size;
  kpis.innerHTML=''
    +'<div class="card" style="padding:12px"><div style="font-size:10px;color:var(--muted);text-transform:uppercase">📄 '+(_appNotesStatus==='pending'?'Notas pendentes':'Notas concluídas')+'</div><div style="font-size:20px;font-weight:800;color:var(--g800);margin-top:3px">'+Number(data.count||0)+'</div></div>'
    +'<div class="card" style="padding:12px"><div style="font-size:10px;color:var(--muted);text-transform:uppercase">👥 Clientes</div><div style="font-size:20px;font-weight:800;color:var(--g800);margin-top:3px">'+clients+'</div></div>'
    +'<div class="card" style="padding:12px;background:#4F46E5;color:#fff"><div style="font-size:10px;opacity:.75;text-transform:uppercase">💰 Total consolidado</div><div style="font-size:20px;font-weight:800;margin-top:3px">'+appNoteMoney(data.total||0)+'</div></div>';
  if(!_appNotes.length){wrap.innerHTML='<div class="wa-empty" style="padding:42px">Nenhuma nota '+(_appNotesStatus==='pending'?'pendente':'concluída')+' encontrada neste período.</div>';return;}
  var canEdit=canUseMonteiroCalendar();
  var cards=_appNotes.map(function(n){
    var itemRows=(n.items||[]).map(function(i,index){
      var qty=Number(i.quantity_provided)!==0?appNoteQty(i.quantity):'<span style="color:var(--muted)">Não informado</span>';
      var measure=appNoteQty(i.weight==null?i.quantity:i.weight)+' '+admEsc(i.unit||'');
      var price=appNoteHasPrice(i)?appNoteMoney(appNoteUnitPrice(i))+(i.price_from_catalog?'<div style="font-size:8px;color:#166534">Preço atual de Produtos</div>':''):'<span style="color:var(--muted)">Não informado</span>';
      var subtotal=appNoteHasPrice(i)?appNoteMoney(Number(i.weight||0)*appNoteUnitPrice(i)):'—';
      return '<tr style="border-top:1px solid var(--border);background:'+(index%2?'var(--card2)':'var(--card)')+'">'
        +'<td style="padding:11px 12px;font-weight:800;color:var(--g800)">'+admEsc(i.product||'Sem produto')+'</td>'
        +'<td style="padding:11px 12px;text-align:center">'+qty+'</td>'
        +'<td style="padding:11px 12px;text-align:center"><span style="display:inline-block;background:#EEF2FF;color:#4338CA;border-radius:999px;padding:3px 9px;font-size:10px;font-weight:800">'+appNoteMeasureLabel(i.unit)+'</span></td>'
        +'<td style="padding:11px 12px;text-align:center;font-weight:700;white-space:nowrap">'+measure+'</td>'
        +'<td style="padding:11px 12px;text-align:right;white-space:nowrap">'+price+'</td>'
        +'<td style="padding:11px 12px;text-align:right;font-weight:800;white-space:nowrap">'+subtotal+'</td></tr>';
    }).join('');
    if(!itemRows)itemRows='<tr><td colspan="6" style="padding:24px;text-align:center;color:var(--muted)">Nenhum produto nesta nota.</td></tr>';
    var statusAction=_appNotesStatus==='pending'?'<button class="btn btn-primary btn-sm" onclick="setAppNoteStatus(\''+n.id+'\',\'completed\')">✅ Concluir</button>':'<button class="btn btn-secondary btn-sm" onclick="setAppNoteStatus(\''+n.id+'\',\'pending\')">↩ Voltar para pendente</button>';
    var actions='<div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end"><button class="btn btn-secondary btn-sm" onclick="openAppNoteDetail(\''+n.id+'\')">👁 Ver</button><button class="btn btn-sm" style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d" onclick="printAppNoteReceipt(\''+n.id+'\')">🧾 Recibo</button>'+(canEdit?'<button class="btn btn-secondary btn-sm" onclick="openAppNoteModal(\''+n.id+'\')">✏️ Editar</button>'+statusAction+'<button class="btn btn-sm" style="background:#fee2e2;color:#b91c1c;border:1px solid #fecaca" onclick="deleteAppNote(\''+n.id+'\')">🗑 Remover</button>':'')+'</div>';
    var statusBadge=_appNotesStatus==='pending'?'<span style="background:#FEF3C7;color:#92400E;border-radius:999px;padding:3px 9px;font-size:9px;font-weight:800">⏳ Pendente</span>':'<span style="background:#DCFCE7;color:#166534;border-radius:999px;padding:3px 9px;font-size:9px;font-weight:800">✅ Concluída</span>';
    return '<section class="card" style="padding:0;overflow:hidden;margin-bottom:14px;border:1px solid var(--border)">'
      +'<div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:14px 16px;background:var(--card)">'
      +'<div style="min-width:110px"><div style="font-size:9px;color:var(--muted);text-transform:uppercase;font-weight:700">Data</div><div style="font-size:14px;font-weight:800;color:var(--g800);margin-top:3px">'+admEsc(n.note_date||'—')+'</div></div>'
      +'<div style="flex:1;min-width:190px"><div style="font-size:9px;color:var(--muted);text-transform:uppercase;font-weight:700">Cliente</div><button onclick="openAppNoteDetail(\''+n.id+'\')" style="display:block;background:none;border:none;padding:0;margin-top:3px;font:inherit;font-size:15px;font-weight:900;color:#4338CA;cursor:pointer;text-decoration:underline;text-underline-offset:3px;text-align:left">'+admEsc(n.client||'Sem cliente')+'</button><div style="font-size:9px;color:var(--muted);margin-top:4px">'+statusBadge+' · Atualizada '+admDate(n.updated_at||n.created_at)+'</div></div>'
      +'<div style="min-width:100px"><div style="font-size:9px;color:var(--muted);text-transform:uppercase;font-weight:700">Produtos</div><div style="font-size:16px;font-weight:900;color:var(--g800);margin-top:3px">'+(n.items||[]).length+'</div></div>'
      +'<div style="min-width:140px;text-align:right"><div style="font-size:9px;color:var(--muted);text-transform:uppercase;font-weight:700">Total do dia</div><div style="font-size:18px;font-weight:900;color:#4F46E5;margin-top:3px">'+appNoteMoney(n.total)+'</div></div>'
      +'<div style="min-width:170px">'+actions+'</div></div>'
      +'<div style="overflow-x:auto"><table style="width:100%;min-width:760px;border-collapse:collapse;font-size:11px"><thead><tr style="background:#F1F5F3;color:var(--muted);text-transform:uppercase;font-size:9px"><th style="padding:9px 12px;text-align:left">Produto</th><th style="padding:9px 12px;text-align:center">Quantidade</th><th style="padding:9px 12px;text-align:center">Tipo</th><th style="padding:9px 12px;text-align:center">Medida</th><th style="padding:9px 12px;text-align:right">Valor unitário</th><th style="padding:9px 12px;text-align:right">Subtotal</th></tr></thead><tbody>'+itemRows+'</tbody></table></div></section>';
  }).join('');
  wrap.innerHTML=cards;
}

function openAppNoteDetail(id){
  var n=_appNotes.concat(_appNotesPendingNotif).find(function(x){return x.id===id;}); if(!n)return;
  document.getElementById('app-note-detail-client').textContent=n.client||'Sem cliente';
  document.getElementById('app-note-detail-meta').textContent=(n.note_date||'—')+' · '+(n.items||[]).length+' produto(s) · Total '+appNoteMoney(n.total);
  var products=(n.items||[]).map(function(i){
    var qty=Number(i.quantity_provided)!==0?appNoteQty(i.quantity):'Não informado';
    var price=appNoteHasPrice(i)?appNoteMoney(appNoteUnitPrice(i))+(i.price_from_catalog?' · Produtos':''):'Não informado';
    var subtotal=appNoteHasPrice(i)?appNoteMoney(Number(i.weight||0)*appNoteUnitPrice(i)):'—';
    return '<article style="border:1px solid var(--border);border-radius:10px;padding:13px;background:var(--card)">'
      +'<div style="font-size:14px;font-weight:900;color:var(--g800);margin-bottom:10px">'+admEsc(i.product||'Sem produto')+'</div>'
      +'<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:9px">'
      +'<div><div style="font-size:9px;color:var(--muted);text-transform:uppercase">Quantidade</div><div style="font-weight:800;margin-top:2px">'+qty+'</div></div>'
      +'<div><div style="font-size:9px;color:var(--muted);text-transform:uppercase">Tipo</div><div style="font-weight:800;margin-top:2px">'+appNoteMeasureLabel(i.unit)+'</div></div>'
      +'<div><div style="font-size:9px;color:var(--muted);text-transform:uppercase">Medida</div><div style="font-weight:800;margin-top:2px">'+appNoteQty(i.weight==null?i.quantity:i.weight)+' '+admEsc(i.unit||'')+'</div></div>'
      +'<div><div style="font-size:9px;color:var(--muted);text-transform:uppercase">Valor unitário</div><div style="font-weight:800;margin-top:2px">'+price+'</div></div>'
      +'<div><div style="font-size:9px;color:var(--muted);text-transform:uppercase">Subtotal</div><div style="font-weight:900;color:#4F46E5;margin-top:2px">'+subtotal+'</div></div>'
      +'</div></article>';
  }).join('');
  document.getElementById('app-note-detail-body').innerHTML='<div style="display:grid;gap:10px">'+(products||'<div class="wa-empty">Nenhum produto.</div>')+'</div>';
  document.getElementById('app-note-detail-modal').style.display='flex';
}
function closeAppNoteDetail(){document.getElementById('app-note-detail-modal').style.display='none';}

function printAppNoteReceipt(id){
  var n=_appNotes.find(function(x){return String(x.id)===String(id);});
  if(!n){toast('Nota não encontrada.','error');return;}
  var itens=(n.items||[]).map(function(i,index){
    var medida=appNoteQty(i.weight==null?i.quantity:i.weight)+' '+admEsc(i.unit||'');
    var valor=appNoteHasPrice(i)?appNoteMoney(appNoteUnitPrice(i))+(i.price_from_catalog?' *':''):'Não informado';
    var subtotal=appNoteHasPrice(i)?appNoteMoney((Number(i.weight==null?i.quantity:i.weight)||0)*appNoteUnitPrice(i)):'—';
    return '<tr><td>'+(index+1)+'</td><td><strong>'+admEsc(i.product||'Produto')+'</strong></td><td>'+admEsc(appNoteMeasureLabel(i.unit||''))+'</td><td class="num">'+medida+'</td><td class="num">'+valor+'</td><td class="num">'+subtotal+'</td></tr>';
  }).join('');
  var status=n.status==='completed'?'Concluída':'Pendente';
  var emitido=new Date().toLocaleString('pt-BR');
  var html='<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>Recibo - '+admEsc(n.client||'Cliente')+'</title><style>'
    +'@page{size:A4;margin:12mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#172033;margin:0;font-size:12px}.sheet{max-width:190mm;margin:auto;border:1px solid #cbd5e1;padding:18px}.head{display:flex;justify-content:space-between;gap:20px;border-bottom:3px solid #4f46e5;padding-bottom:12px;margin-bottom:16px}.brand{font-size:24px;font-weight:900;color:#4f46e5}.sub{font-size:11px;color:#64748b;margin-top:3px}.receipt-title{text-align:right;font-size:20px;font-weight:900}.meta{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;background:#f8fafc;border:1px solid #e2e8f0;padding:12px;margin-bottom:16px}.label{font-size:9px;text-transform:uppercase;color:#64748b;font-weight:700}.value{font-size:13px;font-weight:700;margin-top:2px}table{width:100%;border-collapse:collapse}th{background:#eef2ff;color:#3730a3;text-align:left;font-size:9px;text-transform:uppercase;padding:8px;border:1px solid #c7d2fe}td{padding:9px 8px;border:1px solid #e2e8f0}.num{text-align:right;white-space:nowrap}.total{margin-left:auto;margin-top:14px;width:270px;border:2px solid #4f46e5;padding:12px;text-align:right}.total-label{font-size:10px;color:#64748b;text-transform:uppercase}.total-value{font-size:22px;font-weight:900;color:#4f46e5;margin-top:3px}.note{margin-top:14px;padding:10px;background:#fffbeb;border:1px solid #fde68a;color:#92400e}.signatures{display:grid;grid-template-columns:1fr 1fr;gap:50px;margin-top:60px}.sign{text-align:center;border-top:1px solid #334155;padding-top:6px}.footer{margin-top:24px;text-align:center;color:#94a3b8;font-size:9px}.no-print{margin:0 auto 12px;display:block;padding:10px 22px;background:#4f46e5;color:white;border:0;border-radius:7px;font-weight:700;cursor:pointer}@media print{.no-print{display:none}.sheet{border:0;padding:0}}</style></head><body>'
    +'<button class="no-print" onclick="window.print()">🖨️ Imprimir recibo</button><main class="sheet"><header class="head"><div><div class="brand">🍽️ Monteiro</div><div class="sub">Menina dos Raios Ltda · Sistema de Vendas Independente</div></div><div><div class="receipt-title">RECIBO DE PEDIDO</div><div class="sub">Nota APP nº '+admEsc(String(n.id||'—'))+'</div></div></header>'
    +'<section class="meta"><div><div class="label">Cliente</div><div class="value">'+admEsc(n.client||'Sem cliente')+'</div></div><div><div class="label">Data do pedido</div><div class="value">'+admEsc(n.note_date||'—')+'</div></div><div><div class="label">Situação</div><div class="value">'+status+'</div></div><div><div class="label">Emitido em</div><div class="value">'+admEsc(emitido)+'</div></div></section>'
    +'<table><thead><tr><th>#</th><th>Produto</th><th>Tipo</th><th style="text-align:right">Medida</th><th style="text-align:right">Valor unitário</th><th style="text-align:right">Subtotal</th></tr></thead><tbody>'+(itens||'<tr><td colspan="6">Nenhum produto informado.</td></tr>')+'</tbody></table>'
    +'<div class="total"><div class="total-label">Total do pedido</div><div class="total-value">'+appNoteMoney(n.total)+'</div></div>'
    +'<div class="note">* Valor obtido do preço atual cadastrado na aba Produtos. Este recibo comprova o registro do pedido recebido pelo aplicativo interno e não substitui documento fiscal.</div><div class="signatures"><div class="sign">Responsável pelo recebimento</div><div class="sign">Cliente</div></div><div class="footer">Gerado pelo Monteiro · Notas APP</div></main></body></html>';
  var janela=window.open('','_blank','width=980,height=760');
  if(!janela){toast('Permita janelas pop-up para emitir o recibo.','error');return;}
  janela.document.open();janela.document.write(html);janela.document.close();janela.focus();
}

async function setAppNoteStatus(id,status){
  var action=status==='completed'?'concluir esta nota':'devolver esta nota para Pendente';
  if(!confirm('Deseja '+action+'?'))return;
  try{
    await api('/api/app-notes/'+encodeURIComponent(id)+'/status',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:status})});
    toast(status==='completed'?'✅ Nota concluída.':'↩ Nota devolvida para Pendente.');
    await refreshAppNotesNotifications(); loadAppNotes();
  }catch(e){toast(e.message,'error');}
}

function openAppNoteModal(id){
  var n=_appNotes.find(function(x){return x.id===id;}); if(!n)return;
  document.getElementById('app-note-id').value=n.id;
  document.getElementById('app-note-edit-client').value=n.client||'';
  document.getElementById('app-note-edit-date').value=n.note_date||'';
  document.getElementById('app-note-edit-items').value=(n.items||[]).map(function(i){var q=Number(i.quantity_provided)!==0?appNoteQty(i.quantity):'';var p=Number(i.price_provided)!==0?Number(i.unit_price||0).toFixed(2).replace('.',','):'';return [i.product||'',q,appNoteQty(i.weight==null?i.quantity:i.weight),i.unit||'',p].join(' | ');}).join('\n');
  document.getElementById('app-note-modal').style.display='flex';
}
function closeAppNoteModal(){ document.getElementById('app-note-modal').style.display='none'; }
function parseAppNoteItems(){
  var lines=document.getElementById('app-note-edit-items').value.split(/\r?\n/).filter(function(x){return x.trim();});
  return lines.map(function(line,idx){var p=line.split('|').map(function(x){return x.trim();});if(p.length<5)throw new Error('Linha '+(idx+1)+' inválida. Use Produto | Quantidade | Medida | Unidade | Valor.');var qty=p[1]===''?null:Number(p[1].replace(',','.')),weight=Number(p[2].replace(',','.')),price=p[4]===''?null:Number(p[4].replace(',','.'));if((qty!==null&&!Number.isFinite(qty))||!Number.isFinite(weight)||(price!==null&&!Number.isFinite(price)))throw new Error('Quantidade, medida ou valor inválido na linha '+(idx+1)+'.');return {product:p[0],quantity:qty,weight:weight,unit:p[3].toUpperCase(),unit_price:price};});
}
async function saveAppNote(){
  try{
    var id=document.getElementById('app-note-id').value;
    var body={client:document.getElementById('app-note-edit-client').value.trim(),date:document.getElementById('app-note-edit-date').value.trim(),items:parseAppNoteItems()};
    await api('/api/app-notes/'+encodeURIComponent(id),{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    closeAppNoteModal(); toast('✅ Nota APP atualizada.'); await refreshAppNotesNotifications(); loadAppNotes();
  }catch(e){toast(e.message,'error');}
}
async function deleteAppNote(id){
  if(!confirm('Remover permanentemente esta nota enviada pelo aplicativo?'))return;
  try{await api('/api/app-notes/'+encodeURIComponent(id),{method:'DELETE'});toast('Nota APP removida.');loadAppNotes();}catch(e){toast(e.message,'error');}
}

/* ── Calendário APP: notificações enviadas ao Android ───────────────────── */
var _appCalendarEvents=[];
var _appCalendarStatus='pending';
function appCalendarDate(v){
  if(!v)return '—';
  var p=String(v).split('-'); return p.length===3?p[2]+'/'+p[1]+'/'+p[0]:v;
}
function appCalendarTodayIso(){return new Date().toISOString().slice(0,10);}
function toggleAppCalendarRepeat(){
  var cb=document.getElementById('app-calendar-recurring');
  var box=document.getElementById('app-calendar-repeat-box');
  if(box)box.style.display=cb&&cb.checked?'':'none';
}
function switchAppCalendarStatus(status){
  _appCalendarStatus=status==='completed'?'completed':'pending';
  var p=document.getElementById('app-calendar-tab-pending'),c=document.getElementById('app-calendar-tab-completed');
  if(p)p.className='btn btn-sm '+(_appCalendarStatus==='pending'?'btn-primary':'btn-secondary');
  if(c)c.className='btn btn-sm '+(_appCalendarStatus==='completed'?'btn-primary':'btn-secondary');
  loadAppCalendar();
}
async function loadAppCalendar(){
  var wrap=document.getElementById('app-calendar-wrap'); if(!wrap)return;
  wrap.innerHTML='<div class="wa-empty" style="padding:36px">Carregando calendário...</div>';
  var q=new URLSearchParams(); q.set('status',_appCalendarStatus);
  var month=getPalFilterMonth(),year=getPalFilterYear(); if(month)q.set('month',month); if(year)q.set('year',year);
  try{
    var data=await api('/api/app-calendar'+(q.toString()?'?'+q.toString():''));
    _appCalendarEvents=data.events||[];
    renderAppCalendar(data);
    if(_appCalendarStatus==='pending')updateAppCalendarBadge(data.pending||_appCalendarEvents.length);
  }catch(e){wrap.innerHTML='<div class="wa-empty" style="padding:36px;color:#b91c1c">'+admEsc(e.message)+'</div>';}
}
function updateAppCalendarBadge(n){
  var badge=document.getElementById('pal-calendar-badge');
  var pending=document.getElementById('app-calendar-pending-count');
  if(badge){badge.textContent=n>99?'99+':String(n);badge.style.display=n?'inline-block':'none';}
  if(pending)pending.textContent=String(n||0);
}
function appCalendarRecurrenceInfo(e){
  var details=String(e&&e.details||'');
  var m=details.match(/(?:^|\n)\s*Recorr[êe]ncia:\s*(\d+)\s*\/\s*(\d+)\s*$/i);
  if(!m)return null;
  return {index:Number(m[1]||0),total:Number(m[2]||0),baseDetails:details.replace(/(?:\n\n?)?\s*Recorr[êe]ncia:\s*\d+\s*\/\s*\d+\s*$/i,'').trim()};
}
function appCalendarDisplayGroups(events){
  var groups={},order=[];
  (events||[]).forEach(function(e){
    var rec=appCalendarRecurrenceInfo(e);
    var key=rec&&rec.total>1
      ? ['rec',e.title||'',rec.baseDetails||'',rec.total,e.notify_days_before,e.reminders_per_day].join('|')
      : 'single|'+String(e.id);
    if(!groups[key]){
      groups[key]={isGroup:!!(rec&&rec.total>1),items:[],title:e.title||'',details:rec?rec.baseDetails:(e.details||''),status:e.status,notify_days_before:e.notify_days_before,reminders_per_day:e.reminders_per_day};
      order.push(key);
    }
    groups[key].items.push(e);
  });
  return order.map(function(k){
    var g=groups[k];
    g.items.sort(function(a,b){return String(a.due_date||'').localeCompare(String(b.due_date||''));});
    var first=g.items[0]||{},last=g.items[g.items.length-1]||{};
    var next=g.items.find(function(x){return x.status==='pending'&&Number(x.days_left)>=0;})||first;
    g.id=first.id; g.ids=g.items.map(function(x){return x.id;});
    g.due_date=next.due_date; g.start_date=first.due_date; g.end_date=last.due_date;
    g.days_left=next.days_left; g.in_reminder_window=g.items.some(function(x){return x.in_reminder_window;});
    g.count=g.items.length;
    g.status=g.items.every(function(x){return x.status==='completed';})?'completed':'pending';
    return g;
  });
}
function renderAppCalendar(data){
  var kpis=document.getElementById('app-calendar-kpis'),wrap=document.getElementById('app-calendar-wrap'); if(!kpis||!wrap)return;
  var displayEvents=appCalendarDisplayGroups(_appCalendarEvents);
  var urgent=_appCalendarEvents.filter(function(e){return e.in_reminder_window;}).length;
  kpis.innerHTML=''
    +'<div class="card" style="padding:12px"><div style="font-size:10px;color:var(--muted);text-transform:uppercase">📌 '+(_appCalendarStatus==='pending'?'Pendentes':'Concluídas')+'</div><div style="font-size:20px;font-weight:800;color:var(--g800);margin-top:3px">'+displayEvents.length+'</div></div>'
    +'<div class="card" style="padding:12px"><div style="font-size:10px;color:var(--muted);text-transform:uppercase">🔔 Avisando no celular</div><div style="font-size:20px;font-weight:800;color:var(--g800);margin-top:3px">'+urgent+'</div></div>'
    +'<div class="card" style="padding:12px;background:#4F46E5;color:#fff"><div style="font-size:10px;opacity:.75;text-transform:uppercase">⏱ Padrão</div><div style="font-size:15px;font-weight:800;margin-top:3px">2 dias antes · 4x ao dia</div></div>';
  if(!displayEvents.length){wrap.innerHTML='<div class="wa-empty" style="padding:42px">Nenhuma notificação '+(_appCalendarStatus==='pending'?'pendente':'concluída')+' neste período.</div>';return;}
  var canEdit=session&&['admin','editor'].includes(session.role);
  wrap.innerHTML='<table style="width:100%;min-width:840px;border-collapse:collapse;font-size:12px"><thead><tr style="background:#F1F5F3;color:var(--muted);text-transform:uppercase;font-size:9px"><th style="padding:10px 12px;text-align:left">Data</th><th style="padding:10px 12px;text-align:left">Notificação</th><th style="padding:10px 12px;text-align:center">Aviso</th><th style="padding:10px 12px;text-align:center">Status</th><th style="padding:10px 12px;text-align:right">Ações</th></tr></thead><tbody>'
    +displayEvents.map(function(e,idx){
      var badge=e.status==='completed'
        ? '<span style="background:#DCFCE7;color:#166534;border-radius:999px;padding:4px 9px;font-size:10px;font-weight:800">Concluída</span>'
        : '<span style="background:#FEF3C7;color:#92400E;border-radius:999px;padding:4px 9px;font-size:10px;font-weight:800">Pendente</span>';
      var days=e.days_left==null?'—':(e.days_left===0?'Hoje':(e.days_left>0?'Faltam '+e.days_left+' dia(s)':'Vencida'));
      var aviso=e.in_reminder_window?'🔔 Ativo no celular':(e.status==='pending'?'Aguardando janela':'—');
      var actions=canEdit?'<div style="display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap">'
        +(e.isGroup?'<button class="btn btn-secondary btn-sm" onclick="showAppCalendarSeries(\''+e.ids.join(',')+'\')">👁 Meses</button>':'<button class="btn btn-secondary btn-sm" onclick="openAppCalendarModal(\''+e.id+'\')">✏️ Editar</button>')
        +(e.status==='pending'?'<button class="btn btn-primary btn-sm" onclick="'+(e.isGroup?'setAppCalendarSeriesStatus(\''+e.ids.join(',')+'\',\'completed\')':'setAppCalendarStatus(\''+e.id+'\',\'completed\')')+'">✅ Concluir</button>':'<button class="btn btn-secondary btn-sm" onclick="'+(e.isGroup?'setAppCalendarSeriesStatus(\''+e.ids.join(',')+'\',\'pending\')':'setAppCalendarStatus(\''+e.id+'\',\'pending\')')+'">↩ Pendente</button>')
        +'<button class="btn btn-sm" style="background:#fee2e2;color:#b91c1c;border:1px solid #fecaca" onclick="'+(e.isGroup?'deleteAppCalendarSeries(\''+e.ids.join(',')+'\')':'deleteAppCalendarEvent(\''+e.id+'\')')+'">🗑 Remover</button></div>':'';
      var dateText=e.isGroup?appCalendarDate(e.start_date)+' a '+appCalendarDate(e.end_date):appCalendarDate(e.due_date);
      var subDate=e.isGroup?e.count+' meses · próxima: '+appCalendarDate(e.due_date):days;
      var details=admEsc(e.details||'')+(e.isGroup?'<div style="font-size:10px;color:#4F46E5;font-weight:900;margin-top:6px">Recorrência mensal unificada · '+e.count+' notificações</div>':'');
      return '<tr style="border-top:1px solid var(--border);background:'+(idx%2?'var(--card2)':'var(--card)')+'">'
        +'<td style="padding:12px;font-weight:900;color:var(--g800);white-space:nowrap">'+dateText+'<div style="font-size:9px;color:var(--muted);margin-top:3px">'+subDate+'</div></td>'
        +'<td style="padding:12px"><div style="font-weight:900;color:var(--g800)">'+admEsc(e.title||'Sem título')+'</div><div style="font-size:11px;color:var(--muted);margin-top:4px;white-space:pre-wrap">'+details+'</div></td>'
        +'<td style="padding:12px;text-align:center;white-space:nowrap">'+aviso+'<div style="font-size:9px;color:var(--muted);margin-top:3px">'+Number(e.notify_days_before||2)+' dias · '+Number(e.reminders_per_day||4)+'x/dia</div></td>'
        +'<td style="padding:12px;text-align:center">'+badge+'</td>'
        +'<td style="padding:12px;text-align:right">'+actions+'</td></tr>';
    }).join('')+'</tbody></table>';
}
function ensureAppCalendarModal(){
  var modal=document.getElementById('app-calendar-modal'); if(modal)return modal;
  var div=document.createElement('div'); div.id='app-calendar-modal'; div.className='modal-overlay';
  div.style.display='none'; div.style.zIndex='9100';
  div.innerHTML='<div class="modal" style="max-width:560px"><div class="modal-header"><h3 id="app-calendar-modal-title" class="modal-title">Nova notificação</h3><button class="modal-close" onclick="closeAppCalendarModal()">×</button></div>'
    +'<div style="padding:16px;display:grid;gap:10px"><input type="hidden" id="app-calendar-id">'
    +'<label style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase">Título</label><input id="app-calendar-title" class="form-input" placeholder="Ex.: Pagar funcionário X">'
    +'<label style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase">Data</label><input id="app-calendar-due" class="form-input" type="date">'
    +'<label style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase">Detalhes</label><textarea id="app-calendar-details" class="form-input" rows="4" placeholder="Informação que vai aparecer no celular"></textarea>'
    +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px"><div><label style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase">Dias antes</label><input id="app-calendar-days" class="form-input" type="number" min="0" max="30" value="2"></div><div><label style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase">Avisos por dia</label><input id="app-calendar-times" class="form-input" type="number" min="1" max="12" value="4"></div></div>'
    +'<div id="app-calendar-repeat-area" style="border:1px solid var(--border);border-radius:8px;padding:10px;background:var(--card2)"><label style="display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;color:var(--g800);cursor:pointer"><input id="app-calendar-recurring" type="checkbox" onchange="toggleAppCalendarRepeat()" style="width:16px;height:16px;accent-color:var(--g600)"> Recorrente mensal</label><div id="app-calendar-repeat-box" style="display:none;margin-top:10px"><label style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase">Por quantos meses</label><input id="app-calendar-repeat-months" class="form-input" type="number" min="1" max="60" value="1"><div style="font-size:10px;color:var(--muted);margin-top:4px">Ex.: 6 cria uma notificação por mês durante 6 meses, começando pela data escolhida.</div></div></div>'
    +'<label style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase">Status</label><select id="app-calendar-status" class="form-input"><option value="pending">Pendente</option><option value="completed">Concluída</option></select></div>'
    +'<div style="display:flex;justify-content:flex-end;gap:8px;padding:12px 16px;border-top:1px solid var(--border)"><button class="btn btn-secondary btn-sm" onclick="closeAppCalendarModal()">Cancelar</button><button class="btn btn-primary btn-sm" onclick="saveAppCalendarEvent()">💾 Salvar</button></div></div>';
  (document.getElementById('paladar-app')||document.body).appendChild(div); return div;
}
function openAppCalendarModal(id){
  var modal=ensureAppCalendarModal(),e=_appCalendarEvents.find(function(x){return x.id===id;});
  document.getElementById('app-calendar-modal-title').textContent=e?'Editar notificação':'Nova notificação';
  document.getElementById('app-calendar-id').value=e?e.id:'';
  document.getElementById('app-calendar-title').value=e?e.title:'';
  document.getElementById('app-calendar-due').value=e?e.due_date:appCalendarTodayIso();
  document.getElementById('app-calendar-details').value=e?e.details:'';
  document.getElementById('app-calendar-days').value=e?e.notify_days_before:2;
  document.getElementById('app-calendar-times').value=e?e.reminders_per_day:4;
  document.getElementById('app-calendar-status').value=e?e.status:'pending';
  var repeatArea=document.getElementById('app-calendar-repeat-area');
  var repeat=document.getElementById('app-calendar-recurring');
  var repeatMonths=document.getElementById('app-calendar-repeat-months');
  if(repeatArea)repeatArea.style.display=e?'none':'';
  if(repeat)repeat.checked=false;
  if(repeatMonths)repeatMonths.value=1;
  toggleAppCalendarRepeat();
  modal.style.display='flex';
  modal.classList.add('open');
}
function closeAppCalendarModal(){var m=document.getElementById('app-calendar-modal'); if(m){m.classList.remove('open');m.style.display='none';}}
async function saveAppCalendarEvent(){
  try{
    var id=document.getElementById('app-calendar-id').value;
    var body={
      title:document.getElementById('app-calendar-title').value.trim(),
      due_date:document.getElementById('app-calendar-due').value,
      details:document.getElementById('app-calendar-details').value.trim(),
      notify_days_before:Number(document.getElementById('app-calendar-days').value||2),
      reminders_per_day:Number(document.getElementById('app-calendar-times').value||4),
      status:document.getElementById('app-calendar-status').value,
      recurring:!id&&!!document.getElementById('app-calendar-recurring')?.checked,
      repeat_months:Number(document.getElementById('app-calendar-repeat-months')?.value||1)
    };
    var res=await api('/api/app-calendar'+(id?'/'+encodeURIComponent(id):''),{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    closeAppCalendarModal(); toast(res&&res.created&&res.created>1?'✅ '+res.created+' notificações mensais criadas.':'✅ Notificação salva.'); loadAppCalendar();
  }catch(e){toast(e.message,'error');}
}
async function setAppCalendarStatus(id,status){
  var msg=status==='completed'?'concluir esta notificação':'devolver esta notificação para pendente';
  if(!confirm('Deseja '+msg+'?'))return;
  try{await api('/api/app-calendar/'+encodeURIComponent(id)+'/status',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:status})});toast(status==='completed'?'✅ Notificação concluída.':'↩ Notificação pendente.');loadAppCalendar();}catch(e){toast(e.message,'error');}
}
async function deleteAppCalendarEvent(id){
  if(!confirm('Remover esta notificação do calendário?'))return;
  try{await api('/api/app-calendar/'+encodeURIComponent(id),{method:'DELETE'});toast('Notificação removida.');loadAppCalendar();}catch(e){toast(e.message,'error');}
}
function showAppCalendarSeries(idsCsv){
  var ids=String(idsCsv||'').split(',').filter(Boolean);
  var items=_appCalendarEvents.filter(function(e){return ids.indexOf(String(e.id))>=0;})
    .sort(function(a,b){return String(a.due_date||'').localeCompare(String(b.due_date||''));});
  var html='<div style="display:grid;gap:8px;padding:8px 4px">';
  html+=items.map(function(e,i){
    var rec=appCalendarRecurrenceInfo(e);
    var badge=e.status==='completed'
      ? '<span style="background:#DCFCE7;color:#166534;border-radius:999px;padding:2px 8px;font-size:10px;font-weight:800">Concluída</span>'
      : '<span style="background:#FEF3C7;color:#92400E;border-radius:999px;padding:2px 8px;font-size:10px;font-weight:800">Pendente</span>';
    return '<div style="display:flex;align-items:center;gap:10px;justify-content:space-between;border:1px solid var(--border);border-radius:8px;padding:10px;background:var(--card)">'
      +'<div><div style="font-weight:900;color:var(--g800)">'+appCalendarDate(e.due_date)+' <span style="font-size:10px;color:var(--muted)">#'+(rec?rec.index:i+1)+'</span></div><div style="font-size:10px;color:var(--muted);margin-top:2px">'+(e.days_left===0?'Hoje':(Number(e.days_left)>0?'Faltam '+e.days_left+' dia(s)':'—'))+'</div></div>'
      +'<div>'+badge+'</div></div>';
  }).join('');
  html+='</div>';
  var old=document.getElementById('app-calendar-series-modal');
  if(old)old.remove();
  var modal=document.createElement('div');
  modal.id='app-calendar-series-modal';
  modal.className='modal-overlay open';
  modal.style.display='flex';
  modal.style.zIndex='9200';
  modal.innerHTML='<div class="modal" style="max-width:520px"><div class="modal-header"><h3 class="modal-title">Meses da recorrência</h3><button class="modal-close" onclick="document.getElementById(\'app-calendar-series-modal\')?.remove()">×</button></div>'
    +html
    +'<div style="display:flex;justify-content:flex-end;padding:12px 4px 0"><button class="btn btn-secondary btn-sm" onclick="document.getElementById(\'app-calendar-series-modal\')?.remove()">Fechar</button></div></div>';
  (document.getElementById('paladar-app')||document.body).appendChild(modal);
}
async function setAppCalendarSeriesStatus(idsCsv,status){
  var ids=String(idsCsv||'').split(',').filter(Boolean);
  if(!ids.length)return;
  var msg=status==='completed'?'concluir todas as notificações desta recorrência':'devolver toda a recorrência para pendente';
  if(!confirm('Deseja '+msg+'?'))return;
  try{
    for(var i=0;i<ids.length;i++){
      await api('/api/app-calendar/'+encodeURIComponent(ids[i])+'/status',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:status})});
    }
    toast(status==='completed'?'✅ Recorrência concluída.':'↩ Recorrência pendente.');
    loadAppCalendar();
  }catch(e){toast(e.message,'error');}
}
async function deleteAppCalendarSeries(idsCsv){
  var ids=String(idsCsv||'').split(',').filter(Boolean);
  if(!ids.length)return;
  if(!confirm('Remover todos os meses desta recorrência?'))return;
  try{
    for(var i=0;i<ids.length;i++) await api('/api/app-calendar/'+encodeURIComponent(ids[i]),{method:'DELETE'});
    toast('Recorrência removida.');
    loadAppCalendar();
  }catch(e){toast(e.message,'error');}
}

/* ── Modal de Lançamento (multi-item) ── */
function palFmt(v){ return 'R$ '+v.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function palSetVal(id,val){ var el=document.getElementById(id); if(el) el.value = val == null ? '' : val; }

function openPaladarItemEditModal(item){
  if(!item) return;
  window._palEditingItemId = item.id;
  palSetVal('pal-edit-prod', item.product || '');
  palSetVal('pal-edit-qty', Number(item.quantity || 0));
  palSetVal('pal-edit-price', Number(item.unitprice || 0).toFixed(2));
  palSetVal('pal-edit-notes', item.notes || '');
  updatePaladarEditTotal();
  var modal = document.getElementById('paladar-item-edit-modal');
  if(modal) modal.style.display = 'flex';
  setTimeout(function(){ document.getElementById('pal-edit-prod')?.focus(); }, 50);
}

function editPaladarSaleItem(id){
  var item = window._palSaleItemsById && window._palSaleItemsById[String(id)];
  if(!item){ toast('Item não encontrado na tela. Atualize os lançamentos.', 'error'); return; }
  openPaladarItemEditModal(item);
}

function closePaladarItemEditModal(){
  var modal = document.getElementById('paladar-item-edit-modal');
  if(modal) modal.style.display = 'none';
  window._palEditingItemId = null;
}

function updatePaladarEditTotal(){
  var qty = parseFloat(document.getElementById('pal-edit-qty')?.value) || 0;
  var price = parseFloat(document.getElementById('pal-edit-price')?.value) || 0;
  var total = document.getElementById('pal-edit-total');
  if(total) total.textContent = palFmt(qty * price);
}

function editPaladarGroupClient(groupId){
  var group = window._palSaleGroupsById && window._palSaleGroupsById[String(groupId)];
  if(!group){ toast('Lançamento não encontrado na tela. Atualize a lista.', 'error'); return; }
  window._palEditingGroupId = group.sale_group;
  palSetVal('pal-group-client', group.client || '');
  var modal = document.getElementById('paladar-group-edit-modal');
  if(modal) modal.style.display = 'flex';
  setTimeout(function(){ document.getElementById('pal-group-client')?.focus(); }, 50);
}

function closePaladarGroupEditModal(){
  var modal = document.getElementById('paladar-group-edit-modal');
  if(modal) modal.style.display = 'none';
  window._palEditingGroupId = null;
}

async function savePaladarGroupEdit(){
  var groupId = window._palEditingGroupId;
  if(!groupId){ toast('Nenhum lançamento selecionado.', 'error'); return; }
  var client = document.getElementById('pal-group-client')?.value?.trim() || '';
  var btn = document.getElementById('pal-group-save-btn');
  if(btn){ btn.disabled = true; btn.textContent = 'Salvando...'; }
  try{
    var r = await fetch('/api/monteiro/sales/group/'+encodeURIComponent(groupId), {
      method:'PUT',
      headers:{'Content-Type':'application/json','x-token':(typeof session !== 'undefined' ? session.token : '') || ''},
      body:JSON.stringify({client:client})
    });
    if(!r.ok){ var err = await r.json().catch(function(){ return {detail:r.statusText}; }); throw new Error(err.detail || 'Erro ao salvar cliente'); }
    toast('Cliente atualizado com sucesso!');
    closePaladarGroupEditModal();
    await loadPaladarSales();
    await loadPaladarSummary();
    await loadPaladarClients();
  }catch(e){
    toast('Erro ao editar cliente: '+e.message, 'error');
  }finally{
    if(btn){ btn.disabled = false; btn.textContent = 'Salvar Cliente'; }
  }
}

async function savePaladarItemEdit(){
  var id = window._palEditingItemId;
  if(!id){ toast('Nenhum item selecionado para editar.', 'error'); return; }
  var product = document.getElementById('pal-edit-prod')?.value?.trim() || '';
  var quantity = parseFloat(document.getElementById('pal-edit-qty')?.value) || 0;
  var unitprice = parseFloat(document.getElementById('pal-edit-price')?.value) || 0;
  var notes = document.getElementById('pal-edit-notes')?.value || '';
  if(!product){ toast('Informe o produto.', 'error'); return; }
  if(quantity <= 0){ toast('Informe uma quantidade maior que zero.', 'error'); return; }
  if(unitprice < 0){ toast('Preço não pode ser negativo.', 'error'); return; }
  var btn = document.getElementById('pal-edit-save-btn');
  if(btn){ btn.disabled = true; btn.textContent = 'Salvando...'; }
  try{
    var r = await fetch('/api/monteiro/sales/'+encodeURIComponent(id), {
      method:'PUT',
      headers:{'Content-Type':'application/json','x-token':(typeof session !== 'undefined' ? session.token : '') || ''},
      body:JSON.stringify({product:product, quantity:quantity, unitprice:unitprice, notes:notes})
    });
    if(!r.ok){ var err = await r.json().catch(function(){ return {detail:r.statusText}; }); throw new Error(err.detail || 'Erro ao salvar edição'); }
    toast('Item atualizado com sucesso!');
    closePaladarItemEditModal();
    await loadPaladarSales();
    await loadPaladarSummary();
    await loadPaladarProducts();
    await loadPaladarClients();
  }catch(e){
    toast('Erro ao editar item: '+e.message, 'error');
  }finally{
    if(btn){ btn.disabled = false; btn.textContent = 'Salvar Alterações'; }
  }
}

var _palDriversCache = [];
var _palVehiclesCache = [];
var _palLancView = 'lancamentos';

function switchPalLancView(view){
  _palLancView = view || 'lancamentos';
  document.querySelectorAll('[data-pal-lanc-view]').forEach(function(btn){
    btn.classList.toggle('active', btn.dataset.palLancView===_palLancView);
  });
  loadPaladarSales();
}

async function uploadPaladarInvoice(groupId,file){
  if(!groupId || !file) return;
  var fd=new FormData();
  fd.append('file', file);
  var r=await fetch('/api/monteiro/sales/group/'+encodeURIComponent(groupId)+'/invoice',{
    method:'POST',
    headers:{'x-token':(typeof session !== 'undefined' ? session.token : '') || ''},
    body:fd
  });
  if(!r.ok){ var err=await r.json().catch(function(){return {detail:r.statusText};}); throw new Error(err.detail || 'Erro ao enviar nota'); }
  return await r.json();
}

function promptUploadPaladarInvoice(groupId){
  var inp=document.createElement('input');
  inp.type='file';
  inp.accept='.pdf,.xml,.jpg,.jpeg,.png,.webp,application/pdf,text/xml,application/xml,image/*';
  inp.onchange=async function(){
    var file=inp.files&&inp.files[0];
    if(!file)return;
    try{
      await uploadPaladarInvoice(groupId,file);
      toast('Nota fiscal anexada!');
      await loadPaladarSales();
    }catch(e){ toast('Erro: '+e.message,'error'); }
  };
  inp.click();
}

async function openPaladarInvoice(groupId){
  try{
    var r=await fetch('/api/monteiro/sales/group/'+encodeURIComponent(groupId)+'/invoice',{
      headers:{'x-token':(typeof session !== 'undefined' ? session.token : '') || ''}
    });
    if(!r.ok){ var err=await r.json().catch(function(){return {detail:r.statusText};}); throw new Error(err.detail || 'Nota fiscal não encontrada'); }
    var blob=await r.blob();
    var url=URL.createObjectURL(blob);
    window.open(url,'_blank');
    setTimeout(function(){ URL.revokeObjectURL(url); }, 60000);
  }catch(e){ toast('Erro: '+e.message,'error'); }
}

// Baixa em ZIP as notas fiscais marcadas; se nenhuma marcada, baixa todas as
// anexadas na tela atual (após confirmação).
async function downloadPaladarInvoicesZip(){
  var checked = Array.prototype.slice.call(document.querySelectorAll('.pal-inv-check:checked'))
    .map(function(c){ return c.getAttribute('data-sg'); }).filter(Boolean);
  var groups = checked;
  if(!groups.length){
    var all = window._palSaleGroupsById || {};
    groups = Object.keys(all).filter(function(sg){ return all[sg] && all[sg].invoice_file_path; });
    if(!groups.length){ toast('Nenhuma nota fiscal anexada para baixar.','error'); return; }
    if(!confirm('Nenhuma nota marcada. Baixar TODAS as '+groups.length+' notas anexadas nesta tela?')) return;
  }
  try{
    toast('⏳ Preparando ZIP de '+groups.length+' nota(s)...');
    var r = await fetch('/api/monteiro/invoices/zip', {
      method:'POST',
      headers:{'Content-Type':'application/json','x-token':(typeof session!=='undefined'?session.token:'')||''},
      body: JSON.stringify({groups:groups})
    });
    if(!r.ok){ var e=await r.json().catch(function(){return {detail:r.statusText};}); throw new Error(e.detail||'Erro ao gerar ZIP'); }
    var blob = await r.blob();
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = 'notas_monteiro_'+new Date().toISOString().slice(0,10)+'.zip';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
    toast('✅ Download iniciado ('+groups.length+' nota(s)).');
  }catch(e){ toast('❌ '+e.message,'error'); }
}

async function openPaladarSaleModal(){
  // Limpar campos de cabeçalho
  document.getElementById('pal-sale-date').value = new Date().toISOString().slice(0,10);
  document.getElementById('pal-sale-client').value = '';
  document.getElementById('pal-sale-nf').value = '';
  document.getElementById('pal-sale-driver').value = '';
  document.getElementById('pal-sale-vehicle').value = '';
  document.getElementById('pal-sale-plate').value = '';
  var _pa = document.getElementById('pal-plate-auto'); if(_pa) _pa.textContent = '';
  var _pw = document.getElementById('pal-plate-manual-wrap'); if(_pw) _pw.style.display = 'none';
  var _pt = document.getElementById('pal-plate-manual-toggle'); if(_pt) _pt.style.display = '';
  document.getElementById('pal-sale-notes').value = '';
  var inv=document.getElementById('pal-sale-invoice'); if(inv) inv.value='';
  var c = document.getElementById('pal-items-body');
  c.innerHTML = '';
  addPaladarItem();
  // Carregar listas de clientes, entregadores e veículos
  try{
    var clients = await api('/api/monteiro/clients/list?month=&year=');
    var cl = document.getElementById('pal-client-list');
    if(cl) cl.innerHTML = (clients||[]).map(function(d){ return '<option value="'+d.replace(/"/g,'&quot;')+'">'; }).join('');
  }catch(e){}
  // Carregar listas de entregadores e veículos do sistema principal
  try{
    var drivers = await api('/api/monteiro/drivers');
    _palDriversCache = drivers || [];
    var dl = document.getElementById('pal-driver-list');
    if(dl) dl.innerHTML = _palDriversCache.map(function(d){ return '<option value="'+d.replace(/"/g,'&quot;')+'">'; }).join('');
  }catch(e){}
  try{
    var vehicles = await api('/api/monteiro/vehicles');
    _palVehiclesCache = vehicles || [];
    var vl = document.getElementById('pal-vehicle-list');
    if(vl) vl.innerHTML = _palVehiclesCache.map(function(v){ return '<option value="'+v.name.replace(/"/g,'&quot;')+' - '+v.plate+'">'; }).join('');
    // Auto-preenche placa ao selecionar veículo cadastrado
    document.getElementById('pal-sale-vehicle').onchange = function(){
      var val = this.value.trim();
      var autoSpan = document.getElementById('pal-plate-auto');
      var plateField = document.getElementById('pal-sale-plate');
      var matched = _palVehiclesCache.find(function(v){ return (v.name+' - '+v.plate) === val; });
      if(matched){
        plateField.value = matched.plate.toUpperCase();
        if(autoSpan) autoSpan.textContent = '🔹 '+matched.plate.toUpperCase();
      } else if(!val){
        if(autoSpan) autoSpan.textContent = '';
      }
    };
  }catch(e){}
  // Listener com _palInputHandler — remove anterior se existir, depois readiciona
  if(c._palInputHandler){
    c.removeEventListener('input', c._palInputHandler);
  }
  c._palInputHandler = function(e){
    var row = e.target.closest('.pal-item-row');
    if(!row) return;
    if(e.target.classList.contains('pal-item-qty') || e.target.classList.contains('pal-item-price')){
      var qty = parseFloat(row.querySelector('.pal-item-qty')?.value) || 0;
      var price = parseFloat(row.querySelector('.pal-item-price')?.value) || 0;
      var lineTot = row.querySelector('.pal-item-total');
      if(lineTot) lineTot.textContent = palFmt(qty * price);
      recalcPaladarGrandTotal();
    }
  };
  c.addEventListener('input', c._palInputHandler);
  document.getElementById('paladar-sale-modal').style.display = 'flex';
}

function closePaladarSaleModal(){
  document.getElementById('paladar-sale-modal').style.display = 'none';
}

function addPaladarItem(){
  var c = document.getElementById('pal-items-body');
  var q = c.querySelectorAll('.pal-item-row');
  if(q.length >= MAX_MONTEIRO_ITEMS){ toast('Máximo de '+MAX_MONTEIRO_ITEMS+' itens por venda.', 'error'); return; }
  var row = document.createElement('div');
  row.className = 'pal-item-row';
  row.innerHTML =
    '<input type="text" class="pal-item-prod" list="pal-products-list" placeholder="Produto..." oninput="autoFillPrice(this)">'
    +'<input type="number" class="pal-item-qty" value="1" min="0.01" step="any">'
    +'<input type="number" class="pal-item-price" value="" min="0" step="0.01" placeholder="0,00">'
    +'<span class="pal-item-total">R$ 0,00</span>'
    +'<button class="pal-item-remove" onclick="removePaladarItem(this)">&times;</button>';
  c.appendChild(row);
  row.querySelector('.pal-item-prod')?.focus();
  updateRemoveButtons();
}

function autoFillPrice(prodInput){
  var name = prodInput.value.trim();
  if(!name) return;
  var found = _palProductsCache.find(function(p){ return p.name.toLowerCase() === name.toLowerCase(); });
  if(found && found.suggested_price > 0){
    var row = prodInput.closest('.pal-item-row');
    var priceInput = row ? row.querySelector('.pal-item-price') : (prodInput.id === 'pal-edit-prod' ? document.getElementById('pal-edit-price') : null);
    if(priceInput && !priceInput.value){
      priceInput.value = found.suggested_price.toFixed(2);
      // disparar recalculo
      var evt = new Event('input', {bubbles:true});
      priceInput.dispatchEvent(evt);
    }
  }
}

function removePaladarItem(btn){
  var c = document.getElementById('pal-items-body');
  var rows = c.querySelectorAll('.pal-item-row');
  if(rows.length <= 1) return;
  var row = btn.closest('.pal-item-row');
  if(row) row.remove();
  recalcPaladarGrandTotal();
  updateRemoveButtons();
}

function updateRemoveButtons(){
  var c = document.getElementById('pal-items-body');
  var rows = c.querySelectorAll('.pal-item-row');
  var btns = c.querySelectorAll('.pal-item-remove');
  var single = rows.length <= 1;
  btns.forEach(function(b){
    b.style.opacity = single ? '0.3' : '1';
    b.style.cursor = single ? 'not-allowed' : 'pointer';
    b.onclick = single ? function(){} : function(){ removePaladarItem(this); };
  });
}

function recalcPaladarGrandTotal(){
  var grand = 0;
  document.querySelectorAll('#pal-items-body .pal-item-row').forEach(function(row){
    var qty = parseFloat(row.querySelector('.pal-item-qty')?.value) || 0;
    var price = parseFloat(row.querySelector('.pal-item-price')?.value) || 0;
    grand += qty * price;
  });
  var el = document.getElementById('pal-grand-total');
  if(el) el.textContent = palFmt(grand);
}

async function savePaladarSale(){
  var dateVal = document.getElementById('pal-sale-date')?.value;
  var client = document.getElementById('pal-sale-client')?.value?.trim() || '';
  var nf = document.getElementById('pal-sale-nf')?.value?.trim() || '';
  var driver = document.getElementById('pal-sale-driver')?.value?.trim() || '';
  var vehicle = document.getElementById('pal-sale-vehicle')?.value?.trim() || '';
  var plate = document.getElementById('pal-sale-plate')?.value?.trim().toUpperCase() || '';
  var notes = document.getElementById('pal-sale-notes')?.value || '';
  if(!dateVal){ toast('Informe a data da venda.', 'error'); return; }
  var rows = document.querySelectorAll('#pal-items-body .pal-item-row');
  var itens = [];
  rows.forEach(function(row){
    var prod = row.querySelector('.pal-item-prod')?.value?.trim() || '';
    var qty = parseFloat(row.querySelector('.pal-item-qty')?.value) || 0;
    var price = parseFloat(row.querySelector('.pal-item-price')?.value) || 0;
    if(prod && qty > 0){
      itens.push({product:prod, quantity:qty, unitprice:price, total:parseFloat((qty * price).toFixed(2)), notes:notes});
    }
  });
  if(itens.length === 0){ toast('Adicione ao menos 1 item válido (produto + quantidade).', 'error'); return; }
  var btn = document.getElementById('pal-save-btn');
  if(btn){ btn.disabled = true; btn.textContent = 'Salvando...'; }
  try{
    var r = await fetch('/api/monteiro/sales', {
      method:'POST',
      headers:{'Content-Type':'application/json','x-token':(typeof session !== 'undefined' ? session.token : '') || ''},
      body:JSON.stringify({saledate:dateVal, items:itens, client:client, nf_number:nf, driver:driver, vehicle:vehicle, plate:plate})
    });
    if(!r.ok){ var err = await r.json().catch(function(){ return {detail:r.statusText}; }); throw new Error(err.detail || 'Erro ao salvar'); }
    var result = await r.json();
    var invFile = document.getElementById('pal-sale-invoice')?.files?.[0];
    var invoiceMsg = '';
    if(invFile && result.group){
      try{
        await uploadPaladarInvoice(result.group, invFile);
        invoiceMsg = ' Nota fiscal anexada.';
      }catch(upErr){
        invoiceMsg = ' Venda salva, mas a nota não foi anexada: '+upErr.message;
      }
    }
    toast(itens.length + ' item(ns) lançado(s) com sucesso! ✅'+invoiceMsg);
    closePaladarSaleModal();
    loadPaladarSummary();
    loadPaladarSales();
    loadPaladarClients();
  }catch(e){
    toast('Erro: '+e.message, 'error');
  }finally{
    if(btn){ btn.disabled = false; btn.textContent = '✅ Salvar Venda'; }
  }
}

async function deletePaladarSale(id){
  if(!confirm('Excluir este lançamento?')) return;
  try{
    var r = await fetch('/api/monteiro/sales/'+id, {
      method:'DELETE',
      headers:{'x-token':(typeof session !== 'undefined' ? session.token : '') || ''}
    });
    if(!r.ok){ var err = await r.json().catch(function(){ return {detail:r.statusText}; }); throw new Error(err.detail || 'Erro ao excluir'); }
    toast('Lançamento excluído com sucesso!');
    await loadPaladarSales();
    await loadPaladarSummary();
    await loadPaladarProducts();
    await loadPaladarClients();
  }catch(e){ toast('Erro ao excluir: '+e.message, 'error'); }
}

async function loadPaladarSummary(){
  var period = getPalPeriod();
  var month = getPalFilterMonth();
  var year  = getPalFilterYear();
  // Subtitle do período
  var meses = ['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  var subEl = document.getElementById('pal-period-subtitle');
  if(subEl){
    if(period==='quinzenal') subEl.textContent = '📊 Últimos 15 dias';
    else if(period==='anual' && year) subEl.textContent = '📊 Ano '+year;
    else if(period==='anual') subEl.textContent = '📊 Ano '+new Date().getFullYear();
    else if(month && year) subEl.textContent = '📊 '+meses[parseInt(month)]+' de '+year;
    else if(year) subEl.textContent = '📊 Ano '+year;
    else subEl.textContent = '📊 Todos os períodos';
  }
  // Timestamp
  var tsEl = document.getElementById('pal-update-ts');
  if(tsEl) tsEl.textContent = 'Atualizado '+new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  try{
    var data = await api('/api/monteiro/summary?period='+period+'&month='+month+'&year='+year);
    // Garantir campos seguros
    if(!data || typeof data.total_receita === 'undefined') data = {total_receita:0,total_vendas:0,ticket_medio:0,dias_produtivos:0,por_dia:[],por_produto:[],melhor_dia:{date:null,total:0,qty:0,count:0}};
    // Variação vs período anterior
    var prevData = null;
    if(period==='quinzenal'){
      try{ prevData = await api('/api/monteiro/summary?period=quinzenal_prev'); }catch(e){}
    } else {
      var prevMonth = month ? String(parseInt(month)-1).padStart(2,'0') : '';
      var prevYear = year;
      if(prevMonth === '00'){ prevMonth = '12'; prevYear = String(parseInt(year)-1); }
      if(month || year){
        try{ prevData = await api('/api/monteiro/summary?month='+prevMonth+'&year='+prevYear); }catch(e){}
      }
    }
    function fmtVar(current, previous, isCurrency){
      if(prevData === null || previous === 0) return '';
      var pct = previous > 0 ? ((current - previous) / previous * 100) : 0;
      var sinal = pct >= 0 ? '▲' : '▼';
      var cor = pct >= 0 ? '#10B981' : '#EF4444';
      var val = isCurrency ? 'R$ '+(current - previous).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}) : ((current - previous).toFixed(1).replace('.',','));
      return '<span style="color:'+cor+'">'+sinal+' '+val+' ('+pct.toFixed(1).replace('.',',')+'%)</span>';
    }
    // KPI cards
    var elReceita = document.getElementById('pal-kpi-receita');
    var elVendas  = document.getElementById('pal-kpi-vendas');
    var elTicket  = document.getElementById('pal-kpi-ticket');
    var elDias    = document.getElementById('pal-kpi-dias');
    if(elReceita) elReceita.textContent = 'R$ '+(data.total_receita||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    if(elVendas)  elVendas.textContent  = data.total_vendas||0;
    if(elTicket)  elTicket.textContent  = 'R$ '+(data.ticket_medio||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    if(elDias)    elDias.textContent    = data.dias_produtivos||0;
    if(prevData){
      var vr = document.getElementById('pal-kpi-receita-var');
      if(vr) vr.innerHTML = fmtVar(data.total_receita||0, prevData.total_receita||0, true);
      var vv = document.getElementById('pal-kpi-vendas-var');
      if(vv) vv.innerHTML = fmtVar(data.total_vendas||0, prevData.total_vendas||0, false);
      var vt = document.getElementById('pal-kpi-ticket-var');
      if(vt) vt.innerHTML = fmtVar(data.ticket_medio||0, prevData.ticket_medio||0, true);
      var vd = document.getElementById('pal-kpi-dias-var');
      if(vd) vd.innerHTML = fmtVar(data.dias_produtivos||0, prevData.dias_produtivos||0, false);
    }
    // Charts
    if(palChart1) palChart1.destroy();
    if(palChart2) palChart2.destroy();
    var barCtx = document.getElementById('chart-pal-bar');
    var donutCtx = document.getElementById('chart-pal-donut');
    if(barCtx && data.por_dia && data.por_dia.length){
      palChart1 = new Chart(barCtx, {type:'bar', data:{
        labels: data.por_dia.map(function(d){ return d.date ? d.date.slice(5) : '—'; }),
        datasets: [{ label: 'Total (R$)', data: data.por_dia.map(function(d){ return d.total||0; }), backgroundColor: '#4F46E5CC', borderRadius: 4 }]
      }, options: { responsive:true, maintainAspectRatio:false,
        plugins: { legend: { display:false }, tooltip: { callbacks: { label: function(ctx){ return ' R$ '+parseFloat(ctx.raw||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); } } } },
        scales: { y: { ticks: { callback: function(v){ return 'R$'+(v/1).toFixed(0); }, font:{size:10} }, grid: {display:false} }, x: { grid: {display:false}, ticks: {font:{size:9}} } }
      }});
    } else if(barCtx) {
      palChart1 = new Chart(barCtx, {type:'bar', data:{labels:[], datasets:[{data:[], backgroundColor:'#4F46E5CC'}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});
    }
    if(donutCtx && data.por_produto && data.por_produto.length){
      var cores = ['#4F46E5','#6366F1','#818CF8','#10B981','#14B8A6','#0EA5E9'];
      palChart2 = new Chart(donutCtx, {type:'doughnut', data:{
        labels: data.por_produto.map(function(p){ return p.product; }),
        datasets: [{ data: data.por_produto.map(function(p){ return p.total||0; }), backgroundColor: data.por_produto.map(function(_,i){ return cores[i % cores.length]; }), borderWidth: 2, borderColor: '#fff' }]
      }, options: { responsive:true, maintainAspectRatio:false,
        plugins: { legend: { position:'bottom', labels:{font:{size:10}, boxWidth:10, padding:8} }, tooltip: { callbacks: { label: function(ctx){
          var tot = ctx.dataset.data.reduce(function(a,b){ return a+b; },0);
          var pct = tot > 0 ? ((ctx.raw / tot) * 100).toFixed(1) : 0;
          return ' '+ctx.label+': R$ '+parseFloat(ctx.raw||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+' ('+pct+'%)';
        }}} }
      }});
    } else if(donutCtx) {
      palChart2 = new Chart(donutCtx, {type:'doughnut', data:{labels:[], datasets:[{data:[],backgroundColor:[]}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});
    }
    // Top produtos
    var prodEl = document.getElementById('pal-top-produtos');
    if(prodEl && data.por_produto && data.por_produto.length){
      var maxVal = data.por_produto[0].total||0;
      prodEl.innerHTML = data.por_produto.map(function(p, i){
        var pct = maxVal > 0 ? ((p.total||0) / maxVal * 100).toFixed(0) : 0;
        return '<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--border);background:'+(i%2===0?'var(--card)':'var(--g50)')+'">'
          +'<div style="width:26px;height:26px;border-radius:50%;background:#4F46E5;color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0">'+(i+1)+'</div>'
          +'<div style="flex:1;min-width:0">'
          +'<div style="font-size:13px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+p.product+'</div>'
          +'<div style="display:flex;align-items:center;gap:6px;margin-top:5px">'
          +'<div style="flex:1;height:5px;background:var(--border);border-radius:3px;overflow:hidden">'
          +'<div style="height:100%;width:'+pct+'%;background:linear-gradient(90deg,#4F46E5,#818CF8);border-radius:3px"></div></div></div></div>'
          +'<div style="text-align:right;flex-shrink:0">'
          +'<div style="font-size:14px;font-weight:700;color:#4F46E5;font-family:monospace">R$ '+(p.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</div>'
          +'<div style="font-size:10px;color:var(--muted)">'+(p.qty||0).toLocaleString('pt-BR',{maximumFractionDigits:1})+' un. · '+(p.count||0)+' venda'+((p.count||0)===1?'':'s')+'</div>'
          +'</div></div>';
      }).join('');
    } else if(prodEl) {
      prodEl.innerHTML = '<div style="color:var(--muted);padding:14px;text-align:center">Nenhum produto no período.</div>';
    }
    // Melhor Dia
    var melEl = document.getElementById('pal-melhor-dia');
    if(melEl && data.melhor_dia && data.melhor_dia.date){
      var md = data.melhor_dia;
      melEl.innerHTML = '<div style="display:flex;align-items:center;justify-content:space-between"><span><strong>'+(md.date||'—')+'</strong> — '+(md.qty||0)+' item(ns), '+(md.count||0)+' venda'+((md.count||0)===1?'':'s')+'</span><span style="color:#4F46E5;font-weight:700;font-family:monospace;font-size:16px">R$ '+(md.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</span></div>';
    } else if(melEl) {
      melEl.innerHTML = '<span style="color:var(--muted)">Sem dados no período.</span>';
    }
  }catch(e){
    toast('Erro ao carregar resumo Monteiro: '+e.message, 'error');
  }
}

async function loadPaladarSales(){
  var period = getPalPeriod();
  var month = getPalFilterMonth();
  var year  = getPalFilterYear();
  var prod  = document.getElementById('pal-filter-product')?.value.trim() || '';
  var cli   = document.getElementById('pal-filter-client')?.value.trim() || '';
  var nf    = document.getElementById('pal-filter-nf')?.value.trim() || '';
  var drv   = document.getElementById('pal-filter-driver')?.value.trim() || '';
  var vpl   = document.getElementById('pal-filter-vehicle')?.value.trim() || '';
  var wrap  = document.getElementById('pal-lanc-table-wrap');
  if(!wrap) return;
  var params = '?period='+period+'&month='+month+'&year='+year;
  if(prod) params += '&product='+encodeURIComponent(prod);
  if(cli)  params += '&client='+encodeURIComponent(cli);
  if(nf)   params += '&nf_number='+encodeURIComponent(nf);
  if(drv)  params += '&driver='+encodeURIComponent(drv);
  if(vpl)  params += '&vehicle_plate='+encodeURIComponent(vpl);
  try{
    var data = await api('/api/monteiro/sales'+params);
    if(_palLancView === 'notas'){
      data = (data||[]).filter(function(g){ return !!g.invoice_file_path; });
    }
    if(!data.length){
      wrap.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted)">'+(_palLancView==='notas'?'Nenhuma nota fiscal enviada neste período. Use <b>Anexar nota</b> nos lançamentos antigos.':'Nenhum lançamento Monteiro encontrado.')+'</div>';
      return;
    }
    var html = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="background:#4F46E5;color:#fff">'
      +'<th style="padding:8px 6px;text-align:center;width:28px"></th>'
      +'<th style="padding:8px 10px;text-align:left">Data</th><th style="padding:8px 10px;text-align:left">Cliente</th>'
      +'<th style="padding:8px 10px;text-align:left">NF</th><th style="padding:8px 6px;text-align:left">Entregador</th>'
      +'<th style="padding:8px 6px;text-align:left">Veículo / Placa</th>'
      +'<th style="padding:8px 10px;text-align:right">Total NF</th><th style="padding:8px 10px;text-align:center">Itens</th><th style="padding:8px 10px;text-align:center">Nota fiscal</th><th style="padding:8px 10px;text-align:center">Ações</th></tr></thead><tbody>';
    var expanded = window._palExpandedGroups || {};
    window._palSaleItemsById = {};
    window._palSaleGroupsById = {};
    data.forEach(function(g, idx){
      var sg = g.sale_group;
      window._palSaleGroupsById[String(sg)] = g;
      var isExp = expanded[sg];
      var rowBg = idx%2===0 ? 'var(--card)' : 'var(--g50)';
      var hasInvoice = !!g.invoice_file_path;
      var invoiceCell = hasInvoice
        ? '<input type="checkbox" class="pal-inv-check" data-sg="'+String(sg).replace(/"/g,'&quot;')+'" onclick="event.stopPropagation()" title="Selecionar para download" style="margin-right:6px;vertical-align:middle;cursor:pointer;width:15px;height:15px">'+'<button class="btn btn-sm" style="background:#DCFCE7;color:#166534;border:none;padding:4px 8px;border-radius:6px;cursor:pointer;font-size:11px;margin-right:4px" onclick="openPaladarInvoice(\''+sg+'\')" title="'+((g.invoice_original_name||'Ver nota fiscal').replace(/"/g,'&quot;'))+'">👁️ Ver</button><button class="btn btn-sm" style="background:#EEF2FF;color:#4F46E5;border:none;padding:4px 8px;border-radius:6px;cursor:pointer;font-size:11px" onclick="promptUploadPaladarInvoice(\''+sg+'\')" title="Trocar nota fiscal">↻ Trocar</button>'
        : '<button class="btn btn-sm" style="background:#FEF3C7;color:#92400E;border:none;padding:4px 8px;border-radius:6px;cursor:pointer;font-size:11px" onclick="promptUploadPaladarInvoice(\''+sg+'\')" title="Enviar nota fiscal">⬆️ Anexar</button>';
      html += '<tr style="border-bottom:1px solid var(--border);background:'+rowBg+'">'
        +'<td style="padding:8px 6px;text-align:center"><span onclick="togglePalGroup(\''+sg+'\')" style="cursor:pointer;font-size:13px;user-select:none">'+(isExp?'▼':'▶')+'</span></td>'
        +'<td style="padding:8px 10px">'+(g.saledate||'—')+'</td>'
        +'<td style="padding:8px 10px;font-size:11px">'+(g.client||'—')+'</td>'
        +'<td style="padding:8px 10px;font-size:11px;font-weight:600">'+(g.nf_number||'—')+'</td>'
        +'<td style="padding:8px 6px;font-size:11px">'+(g.driver||'—')+'</td>'
        +'<td style="padding:8px 6px;font-size:11px">'+((g.vehicle && g.plate) ? g.vehicle+' — <span style="font-family:monospace;font-size:10px">'+g.plate+'</span>' : (g.plate ? '<span style="font-family:monospace">'+g.plate+'</span>' : (g.vehicle||'—')))+'</td>'
        +'<td style="padding:8px 10px;text-align:right;font-family:monospace;font-weight:700;color:#4F46E5">R$ '+(g.total_group||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
        +'<td style="padding:8px 10px;text-align:center;font-size:11px">'+(g.items?.length||0)+'</td>'
        +'<td style="padding:8px 10px;text-align:center;white-space:nowrap">'+invoiceCell+'</td>'
        +'<td style="padding:8px 10px;text-align:center;white-space:nowrap">'
        +'<button class="btn btn-sm" style="background:#EEF2FF;color:#4F46E5;border:none;padding:4px 9px;border-radius:6px;cursor:pointer;font-size:11px;margin-right:4px" onclick="editPaladarGroupClient(\''+sg+'\')" title="Editar cliente">✎</button>'
        +'<button class="btn btn-sm" style="background:var(--red-l);color:var(--red);border:none;padding:4px 9px;border-radius:6px;cursor:pointer;font-size:11px" onclick="deletePaladarGroup(\''+sg+'\')" title="Excluir NF">🗑️</button></td>'
        +'</tr>';
      // Itens expandidos
      if(isExp && g.items && g.items.length){
        g.items.forEach(function(it, iIdx){
          window._palSaleItemsById[String(it.id)] = it;
          html += '<tr style="background:'+rowBg+';font-size:11px">'
            +'<td style="padding:4px 6px"></td>'
            +'<td style="padding:4px 10px;color:var(--muted)" colspan="2">📦 '+(it.product||'—')+'</td>'
            +'<td style="padding:4px 10px;text-align:right;font-family:monospace">'+(it.quantity||0).toLocaleString('pt-BR',{maximumFractionDigits:2})+'</td>'
            +'<td style="padding:4px 10px;text-align:right;font-family:monospace">R$ '+(it.unitprice||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:4px 10px;text-align:right;font-family:monospace;font-weight:600;color:var(--g800)">R$ '+(it.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:4px 6px" colspan="2"></td>'
            +'<td style="padding:4px 10px;text-align:center;white-space:nowrap">'
            +'<button class="btn btn-sm" style="background:#EEF2FF;color:#4F46E5;border:none;padding:2px 7px;border-radius:5px;cursor:pointer;font-size:10px;margin-right:4px" onclick="editPaladarSaleItem('+it.id+')" title="Editar item">✎</button>'
            +'<button class="btn btn-sm" style="background:var(--red-l);color:var(--red);border:none;padding:2px 7px;border-radius:5px;cursor:pointer;font-size:10px" onclick="deletePaladarSale('+it.id+')" title="Excluir item">✕</button></td>'
            +'</tr>';
        });
      }
    });
    html += '</tbody></table></div>';
    wrap.innerHTML = html;
  }catch(e){
    wrap.innerHTML = '<div style="color:var(--red);padding:14px">Erro: '+e.message+'</div>';
  }
}

function togglePalGroup(sg){
  if(!window._palExpandedGroups) window._palExpandedGroups = {};
  window._palExpandedGroups[sg] = !window._palExpandedGroups[sg];
  loadPaladarSales();
}

async function deletePaladarGroup(sg){
  if(!confirm('Excluir todo o grupo NF "'+sg+'"?')) return;
  try{
    var r = await fetch('/api/monteiro/sales/group/'+encodeURIComponent(sg), {
      method:'DELETE',
      headers:{'x-token':(typeof session !== 'undefined' ? session.token : '') || ''}
    });
    if(!r.ok){ var err = await r.json().catch(function(){ return {detail:r.statusText}; }); throw new Error(err.detail || 'Erro ao excluir grupo'); }
    toast('Grupo excluído com sucesso!');
    await loadPaladarSales();
    await loadPaladarSummary();
    await loadPaladarProducts();
    await loadPaladarClients();
  }catch(e){ toast('Erro: '+e.message, 'error'); }
}

var _palProductsCache = [];

async function loadPaladarProducts(){
  try{
    var data = await api('/api/monteiro/products'+(document.getElementById('pal-prod-search')?.value?.trim() ? '?search='+encodeURIComponent(document.getElementById('pal-prod-search').value.trim()) : ''));
    if(!Array.isArray(data)) data = [];
    _palProductsCache = data;
    // Datalist do modal de venda
    var dl = document.getElementById('pal-products-list');
    if(dl) dl.innerHTML = data.map(function(p){ return '<option value="'+p.name+'">'; }).join('');
    // Tabela da aba produtos
    var prodList = document.getElementById('pal-prod-list-wrap');
    if(prodList){
      if(!data.length){
        var q = document.getElementById('pal-prod-search')?.value?.trim();
        prodList.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--muted)">'
          +'<div style="font-size:32px;margin-bottom:8px">📦</div>'
          +'<div style="font-size:14px;font-weight:600;margin-bottom:4px">'+(q?'Nenhum produto encontrado para "'+q+'"':'Nenhum produto cadastrado')+'</div>'
          +'<div style="font-size:12px">Clique em <strong>Novo Produto</strong> para começar.</div></div>';
        return;
      }
      prodList.innerHTML = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="background:#4F46E5;color:#fff">'
        +'<th style="padding:8px 10px;text-align:left">Produto</th>'
        +'<th style="padding:8px 10px;text-align:right">Preço Sugerido</th>'
        +'<th style="padding:8px 10px;text-align:center">Status</th>'
        +'<th style="padding:8px 10px;text-align:center">Ações</th></tr></thead><tbody>'
        + data.map(function(p, i){
          var status = p.active ? '<span style="color:#22c55e">Ativo</span>' : '<span style="color:var(--muted)">Inativo</span>';
          var price = p.suggested_price ? 'R$ '+p.suggested_price.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}) : '—';
          return '<tr style="border-bottom:1px solid var(--border);background:'+(i%2===0?'var(--card)':'var(--g50)')+'">'
            +'<td style="padding:8px 10px;font-weight:600">'+p.name+'</td>'
            +'<td style="padding:8px 10px;text-align:right;font-family:monospace;color:#4F46E5;font-weight:600">'+price+'</td>'
            +'<td style="padding:8px 10px;text-align:center;font-size:11px">'+status+'</td>'
            +'<td style="padding:8px 10px;text-align:center;white-space:nowrap">'
            +'<button class="btn btn-sm" onclick="editPaladarProduct('+p.id+')" style="background:var(--purple-l);color:#4F46E5;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-size:11px;margin-right:4px">✏️</button>'
            +'<button class="btn btn-sm" onclick="deletePaladarProduct('+p.id+')" style="background:var(--red-l);color:var(--red);border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-size:11px">🗑️</button>'
            +'</td></tr>';
        }).join('')
        +'</tbody></table></div>';
    }
  }catch(e){ /* silencioso */ }
}

/* ── Aba Clientes Monteiro ── */
var _palClientFilterCacheKey='', _palClientFilterNames=[];

async function ensurePaladarClientFilterOptions(period, month, year, selected){
  var sel=document.getElementById('pal-filter-cli-name');
  if(!sel || sel.tagName!=='SELECT')return;
  var key=[period,month,year].join('|');
  if(_palClientFilterCacheKey!==key || !_palClientFilterNames.length){
    try{
      var base=await api('/api/monteiro/clients/summary?period='+period+'&month='+month+'&year='+year);
      _palClientFilterNames=(base.clientes||[]).map(function(c){return c.client||'';}).filter(Boolean);
      _palClientFilterCacheKey=key;
    }catch(e){}
  }
  updatePaladarClientFilterOptions(_palClientFilterNames.map(function(n){return {client:n};}), selected||sel.value||'');
}

async function loadPaladarClients(){
  var period = getPalPeriod();
  var month = getPalFilterMonth();
  var year  = getPalFilterYear();
  var cli   = document.getElementById('pal-filter-cli-name')?.value.trim() || '';
  await ensurePaladarClientFilterOptions(period, month, year, cli);
  var params = '?period='+period+'&month='+month+'&year='+year+(cli?'&client_filter='+encodeURIComponent(cli):'');
  try{
    var data = await api('/api/monteiro/clients/summary'+params);
    // Cards
    document.getElementById('pal-cli-total').textContent = 'R$ '+(data.total_vendido||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    document.getElementById('pal-cli-count').textContent = data.total_clientes||0;
    document.getElementById('pal-cli-ticket').textContent = 'R$ '+(data.ticket_medio||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    var liderEl = document.getElementById('pal-cli-lider');
    if(data.cliente_lider && data.cliente_lider.client){
      liderEl.innerHTML = '<span style="font-weight:700">'+data.cliente_lider.client+'</span> <span style="font-family:monospace;font-size:11px">R$ '+data.cliente_lider.total.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</span>';
    } else {
      liderEl.textContent = '—';
    }
    var clis = data.clientes || [];
    updatePaladarClientFilterOptions(clis, cli);
    // Chart de barras
    if(palChart3) palChart3.destroy();
    var barCtx = document.getElementById('chart-pal-cli-bar');
    if(barCtx && clis.length){
      var labels = clis.map(function(c){ return c.client && c.client.length > 14 ? c.client.slice(0,12)+'…' : (c.client||'—'); });
      var values = clis.map(function(c){ return c.total||0; });
      palChart3 = new Chart(barCtx, {type:'bar', data:{
        labels: labels, datasets: [{ label:'Total (R$)', data: values, backgroundColor:'#4F46E5CC', borderRadius: 4 }]
      }, options: { responsive:true, maintainAspectRatio:false,
        plugins: { legend:{display:false}, tooltip:{callbacks:{label:function(ctx){return ' R$ '+parseFloat(ctx.raw||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});}}} },
        scales: { y:{ticks:{callback:function(v){return'R$'+(v/1).toFixed(0);},font:{size:10}},grid:{display:false}}, x:{grid:{display:false},ticks:{font:{size:8}}}}
      }});
    } else if(barCtx) {
      palChart3 = new Chart(barCtx, {type:'bar', data:{labels:[],datasets:[{data:[],backgroundColor:'#4F46E5CC'}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});
    }
    // Donut
    if(palChart4) palChart4.destroy();
    var donutCtx = document.getElementById('chart-pal-cli-donut');
    if(donutCtx && clis.length){
      var cores = ['#4F46E5','#6366F1','#818CF8','#10B981','#14B8A6','#0EA5E9','#F59E0B','#EF4444'];
      var donutLabels = clis.slice(0,8).map(function(c){ return c.client && c.client.length > 16 ? c.client.slice(0,14)+'…' : (c.client||'—'); });
      var donutValues = clis.slice(0,8).map(function(c){ return c.total||0; });
      palChart4 = new Chart(donutCtx, {type:'doughnut', data:{
        labels: donutLabels, datasets:[{ data: donutValues, backgroundColor: donutLabels.map(function(_,i){return cores[i%cores.length];}), borderWidth:2, borderColor:'#fff' }]
      }, options: { responsive:true, maintainAspectRatio:false,
        plugins: { legend:{position:'bottom',labels:{font:{size:9},boxWidth:8,padding:6}}, tooltip:{callbacks:{label:function(ctx){
          var tot = ctx.dataset.data.reduce(function(a,b){return a+b;},0);
          return ' '+ctx.label+': R$ '+parseFloat(ctx.raw||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+' ('+(tot>0?(ctx.raw/tot*100).toFixed(1):0)+'%)';
        }}}}
      }});
    } else if(donutCtx) {
      palChart4 = new Chart(donutCtx, {type:'doughnut', data:{labels:[],datasets:[{data:[],backgroundColor:[]}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});
    }
    // Tabela
    var tblWrap = document.getElementById('pal-cli-table-wrap');
    if(!tblWrap) return;
    if(!clis.length){
      tblWrap.innerHTML = '<div style="text-align:center;padding:30px;color:var(--muted)">Nenhum cliente com vendas no período.</div>';
      return;
    }
    tblWrap.innerHTML = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="background:#4F46E5;color:#fff">'
      +'<th style="padding:8px 10px;text-align:left">Cliente</th><th style="padding:8px 10px;text-align:right">Vendas</th>'
      +'<th style="padding:8px 10px;text-align:right">Quantidade</th><th style="padding:8px 10px;text-align:right">Total</th>'
      +'<th style="padding:8px 10px;text-align:right">Média/Venda</th><th style="padding:8px 10px;text-align:right">Última Compra</th></tr></thead><tbody>'
      + clis.map(function(c, i){
        var cname=(c.client||'—').replace(/'/g,"\'");
        return '<tr style="border-bottom:1px solid var(--border);background:'+(i%2===0?'var(--card)':'var(--g50)')+'">'
          +'<td style="padding:8px 10px;font-weight:600;cursor:pointer;color:#4F46E5" onclick="showPaladarClientDetail(\''+cname+'\')">🔍 '+(c.client||'—')+'</td>'
          +'<td style="padding:8px 10px;text-align:right;font-family:monospace">'+(c.num_vendas||0)+'</td>'
          +'<td style="padding:8px 10px;text-align:right;font-family:monospace">'+(c.qty_total||0).toLocaleString('pt-BR',{maximumFractionDigits:1})+'</td>'
          +'<td style="padding:8px 10px;text-align:right;font-family:monospace;font-weight:700;color:#4F46E5">R$ '+(c.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
          +'<td style="padding:8px 10px;text-align:right;font-family:monospace">R$ '+(c.media_venda||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
          +'<td style="padding:8px 10px;text-align:right;font-size:11px">'+(c.ultima_compra||'—')+'</td>'
          +'</tr>';
      }).join('')
      +'</tbody></table></div>';
  }catch(e){
    toast('Erro ao carregar clientes Monteiro: '+e.message, 'error');
  }
}

function updatePaladarClientFilterOptions(clis, selected){
  var sel=document.getElementById('pal-filter-cli-name');
  if(!sel || sel.tagName!=='SELECT')return;
  var names=(clis||[]).map(function(c){return c.client||'';}).filter(Boolean);
  if(selected && names.indexOf(selected)<0)names.unshift(selected);
  names=[...new Set(names)].sort(function(a,b){return a.localeCompare(b,'pt-BR');});
  var current=selected || sel.value || '';
  sel.innerHTML='<option value="">Todos os clientes</option>'+names.map(function(n){
    return '<option value="'+String(n).replace(/"/g,'&quot;')+'" '+(n===current?'selected':'')+'>'+n+'</option>';
  }).join('');
  sel.value=current;
}

// ── Detalhe do cliente ──
async function showPaladarClientDetail(client){
  var period=getPalPeriod(), month=getPalFilterMonth(), year=getPalFilterYear();
  var params='?client='+encodeURIComponent(client)+'&period='+period+'&month='+month+'&year='+year;
  document.getElementById('pal-det-name').textContent=client;
  var pLabel={quinzenal:'Últimos 15 dias',mensal:'Mês '+month+'/'+year,anual:'Ano '+year};
  document.getElementById('pal-det-period').textContent='('+(pLabel[period]||'Período selecionado')+')';
  document.getElementById('pal-cli-detail').style.display='block';
  try{
    var r=await api('/api/monteiro/clients/report'+params);
    var sm=r||{};
    // Summary cards
    var sumEl=document.getElementById('pal-det-summary');
    sumEl.innerHTML=''
      +'<div style="background:#4F46E5;color:#fff;border-radius:var(--radius);padding:10px"><div style="font-size:9px;opacity:.7">💰 Total</div><div style="font-size:15px;font-weight:700;font-family:monospace;margin-top:2px">R$ '+(sm.total_vendido||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</div></div>'
      +'<div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:10px"><div style="font-size:9px;color:var(--muted)">📦 Itens</div><div style="font-size:15px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:2px">'+(sm.qty_total||0).toLocaleString('pt-BR',{maximumFractionDigits:1})+'</div></div>'
      +'<div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:10px"><div style="font-size:9px;color:var(--muted)">📋 Vendas</div><div style="font-size:15px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:2px">'+(sm.num_vendas||0)+'</div></div>'
      +'<div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:10px"><div style="font-size:9px;color:var(--muted)">🎯 Ticket médio</div><div style="font-size:15px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:2px">R$ '+(sm.ticket_medio||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</div></div>'
      +'<div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:10px"><div style="font-size:9px;color:var(--muted)">📅 Última compra</div><div style="font-size:12px;font-weight:700;color:var(--g800);margin-top:2px">'+(sm.ultima_compra||'—')+'</div></div>';
    // Products table
    var prods=sm.produtos||[];
    var prodEl=document.getElementById('pal-det-prods');
    var topProd=sm.produto_mais_comprado;
    if(!prods.length){
      prodEl.innerHTML='<div style="text-align:center;padding:16px;color:var(--muted);font-size:12px">Nenhum produto encontrado no período.</div>';
    } else {
      prodEl.innerHTML='<table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="background:#4F46E5;color:#fff">'
        +'<th style="padding:6px 8px;text-align:left">Produto</th><th style="padding:6px 8px;text-align:right">Qtd</th>'
        +'<th style="padding:6px 8px;text-align:right">Total R$</th><th style="padding:6px 8px;text-align:right">Preço médio</th>'
        +'<th style="padding:6px 8px;text-align:right">Ocorrências</th></tr></thead><tbody>'
        +prods.map(function(p,i){
          var star=(p.product===topProd)?' ⭐':'';
          return '<tr style="border-bottom:1px solid var(--border);background:'+(i%2===0?'var(--card)':'var(--g50)')+'">'
            +'<td style="padding:6px 8px;font-weight:600">'+p.product+star+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace">'+(p.qty||0).toLocaleString('pt-BR',{maximumFractionDigits:1})+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-weight:700;color:#4F46E5">R$ '+(p.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace">R$ '+(p.preco_medio||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace">'+(p.ocorrencias||0)+'</td></tr>';
        }).join('')
        +'</tbody></table>';
    }
    // NFs table
    var notas=sm.notas||[];
    var notasEl=document.getElementById('pal-det-notas');
    if(!notas.length){
      notasEl.innerHTML='<div style="text-align:center;padding:16px;color:var(--muted);font-size:12px">Nenhuma nota fiscal no período.</div>';
    } else {
      notasEl.innerHTML='<table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="background:#4F46E5;color:#fff">'
        +'<th style="padding:6px 8px;text-align:left">Data</th><th style="padding:6px 8px;text-align:left">NF</th>'
        +'<th style="padding:6px 8px;text-align:left">Produtos</th><th style="padding:6px 8px;text-align:right">Qtd</th>'
        +'<th style="padding:6px 8px;text-align:right">Total R$</th><th style="padding:6px 8px;text-align:right">Itens</th>'
        +'<th style="padding:6px 8px;text-align:left">Entregador</th><th style="padding:6px 8px;text-align:left">Veículo</th>'
        +'<th style="padding:6px 8px;text-align:left">Obs</th></tr></thead><tbody>'
        +notas.map(function(n,i){
          var prodsList=(n.produtos||'').length>50 ? (n.produtos||'').slice(0,48)+'…' : (n.produtos||'');
          var veic=n.veiculo||'';
          var obs=n.observacoes||'';
          return '<tr style="border-bottom:1px solid var(--border);background:'+(i%2===0?'var(--card)':'var(--g50)')+'">'
            +'<td style="padding:6px 8px;font-size:10px">'+(n.saledate||'')+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+(n.nf||'')+'</td>'
            +'<td style="padding:6px 8px;font-size:10px" title="'+(n.produtos||'').replace(/"/g,'&quot;')+'">'+prodsList+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-size:10px">'+(n.qty||0).toLocaleString('pt-BR',{maximumFractionDigits:1})+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-weight:700;color:#4F46E5;font-size:10px">R$ '+(n.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-size:10px">'+n.itens+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+n.entregador+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+veic+'</td>'
            +'<td style="padding:6px 8px;font-size:10px;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+obs.replace(/"/g,'&quot;')+'">'+obs+'</td></tr>';
        }).join('')
        +'</tbody></table>';
    }
  }catch(e){
    document.getElementById('pal-det-prods').innerHTML='<div style="text-align:center;padding:16px;color:var(--red);font-size:12px">'+e.message+'</div>';
  }
}

// ── Export functions ──
async function _downloadBlob(url, filename, btn, fallbackUrl){
  if(btn){
    if(btn.dataset.loading==='1') return;
    btn.dataset.loading='1';
    var orig=btn.textContent;
    btn.textContent='⏳ Gerando...';
    btn.style.opacity='.6';
    btn.disabled=true;
  }
  async function _tryFetch(u){
    var r=await fetch(u,{headers:{'x-token':session?.token||''}});
    if(!r.ok){
      var err='';
      try{var raw=await r.text();try{var j=JSON.parse(raw);err=j.detail||j.message||raw;}catch(e2){err=raw;}}catch(_){err='Erro '+r.status;}
      throw err;
    }
    var ct=r.headers.get('content-type')||'';
    if(ct.indexOf('application/pdf')===-1 && filename.indexOf('.pdf')!==-1){
      var txt=await r.text();
      try{var j2=JSON.parse(txt);throw j2.detail||j2.erro||'Resposta inesperada: '+txt.slice(0,200);}catch(e3){throw txt.slice(0,300);}
    }
    var blob=await r.blob();
    if(blob.size===0) throw 'PDF gerado vazio';
    return blob;
  }
  try{
    var blob;
    try{ blob=await _tryFetch(url); }catch(e){
      console.warn('PDF main route failed, trying fallback:', e);
      if(fallbackUrl){ try{ blob=await _tryFetch(fallbackUrl); showExportError('Modo alternativo ativado (dados simplificados)'); }catch(e2){ throw e2; } }
      else throw e;
    }
    var a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=filename||'download';
    document.body.appendChild(a); a.click();
    setTimeout(function(){
      document.body.removeChild(a); URL.revokeObjectURL(a.href);
      if(btn) resetBtn(btn,orig);
    },500);
    toast('📄 '+filename+' baixado','success');
  }catch(e){
    showExportError('Erro: '+(e.message||e||'Falha na requisicao'));
    if(btn) resetBtn(btn,orig);
  }
}
function resetBtn(btn,orig){
  if(!btn) return;
  btn.textContent=orig; btn.style.opacity='1'; btn.disabled=false;
  delete btn.dataset.loading;
}
function showExportError(msg){
  // Toast principal (agora visível acima do overlay com z-index 9999)
  toast(msg,'error');
  // Fallback: exibe dentro do Monteiro se existir
  var palBody=document.getElementById('pal-items-body');
  if(palBody){
    var errEl=document.createElement('div');
    errEl.style.cssText='position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#B71C1C;color:#fff;padding:12px 20px;border-radius:10px;font-size:13px;font-weight:600;z-index:9999;max-width:90vw;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.3);animation:fadeIn .2s ease';
    errEl.textContent=msg;
    errEl.id='pal-export-err';
    var old=document.getElementById('pal-export-err');
    if(old) old.remove();
    document.body.appendChild(errEl);
    setTimeout(function(){ errEl.style.opacity='0'; errEl.style.transition='opacity .3s'; setTimeout(function(){if(errEl.parentNode) errEl.parentNode.removeChild(errEl);},400); },4000);
  }
}
function exportPaladarClientPDF(btn){
  var client=document.getElementById('pal-det-name').textContent;
  var p=getPalPeriod(), m=getPalFilterMonth(), y=getPalFilterYear();
  var url='/api/monteiro/clients/report/pdf?client='+encodeURIComponent(client)+'&period='+p+'&month='+m+'&year='+y;
  _downloadBlob(url,'monteiro_'+client.replace(/[^a-zA-Z0-9]/g,'_')+'.pdf',btn);
}
function exportPaladarClientExcel(client){
  var p=getPalPeriod(), m=getPalFilterMonth(), y=getPalFilterYear();
  _downloadBlob('/api/monteiro/clients/report/excel?client='+encodeURIComponent(client)+'&period='+p+'&month='+m+'&year='+y,'monteiro_'+client.replace(/[^a-zA-Z0-9]/g,'_')+'.xlsx');
}
function exportPaladarAllPDF(btn){
  var p=getPalPeriod(), m=getPalFilterMonth(), y=getPalFilterYear();
  var url='/api/monteiro/clients/report/pdf?period='+p+'&month='+m+'&year='+y;
  _downloadBlob(url,'monteiro_todos_clientes.pdf',btn);
}
function exportPaladarAllExcel(){
  var p=getPalPeriod(), m=getPalFilterMonth(), y=getPalFilterYear();
  _downloadBlob('/api/monteiro/clients/report/excel?period='+p+'&month='+m+'&year='+y,'monteiro_todos_clientes.xlsx');
}

// ── Pagamentos ──
var _paymentsCache = null;
var _pagamentosData = []; // cache for edit

function switchPaymentDetailTab(tab){
  document.querySelectorAll('.pal-pay-tab').forEach(function(btn){
    btn.classList.toggle('active', btn.dataset.payTab===tab);
  });
  document.querySelectorAll('.pal-pay-tab-panel').forEach(function(panel){
    panel.classList.toggle('active', panel.dataset.payPanel===tab);
  });
}

function _pagParams(){
  var c=document.getElementById('pal-pag-cliente')?.value.trim()||'';
  var period=document.getElementById('pal-filter-period')?.value||'mensal';
  var m=document.getElementById('pal-filter-month')?.value||'';
  var y=document.getElementById('pal-filter-year')?.value||'';
  return {client:c, period:period, month:m, year:y};
}

function _pagMoney(v){ return 'R$ '+(Number(v||0)).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function _pagDateObj(s){
  if(!s)return null;
  var p=String(s).slice(0,10).split('-').map(Number);
  return p.length===3?new Date(p[0],p[1]-1,p[2]):null;
}
function _pagDateBR(d){
  if(!d)return '';
  return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0')+'/'+d.getFullYear();
}
function _pagMonthDays(y,m){ return new Date(Number(y),Number(m),0).getDate(); }
function _pagShortDate(sOrDate){
  var d=sOrDate instanceof Date?sOrDate:_pagDateObj(sOrDate);
  if(!d)return '';
  return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0');
}
function _pagRangeLabel(start,end){
  if(!start&&!end)return '';
  var a=_pagShortDate(start), b=_pagShortDate(end||start);
  return a===b?a:(a+' a '+b);
}
function _pagBuildPaidBands(vendas,pagamentos){
  var notes=(vendas||[]).map(function(v){
    return {date:_pagDateObj(v.saledate), dateRaw:v.saledate, nf:v.nf_number||'', total:Number(v.total||0), left:Number(v.total||0)};
  }).filter(function(n){return n.date&&n.total>0;}).sort(function(a,b){return a.date-b.date;});
  var pays=(pagamentos||[]).map(function(p){
    return {id:p.id, date:_pagDateObj(p.payment_date), dateRaw:p.payment_date, amount:Number(p.amount||0), type:p.payment_type||'', notes:p.notes||''};
  }).filter(function(p){return p.date&&p.amount>0;}).sort(function(a,b){return a.date-b.date;});
  var bands=[], idx=0;
  pays.forEach(function(pg){
    var left=pg.amount;
    var band={kind:'paid',id:pg.id,paymentDate:pg.dateRaw,amount:pg.amount,allocated:0,start:null,end:null,nfs:[],partial:false,credit:0};
    while(left>0 && idx<notes.length){
      var n=notes[idx];
      if(n.left<=0){idx++;continue;}
      var use=Math.min(left,n.left);
      if(!band.start)band.start=n.date;
      band.end=n.date;
      band.allocated+=use;
      left-=use;
      n.left-=use;
      if(n.nf && band.nfs.indexOf(n.nf)<0)band.nfs.push(n.nf);
      if(n.left>0){band.partial=true;break;}
      idx++;
    }
    band.credit=left;
    if(band.allocated>0 || band.credit>0)bands.push(band);
  });
  var remaining=notes.filter(function(n){return n.left>0;});
  if(remaining.length){
    bands.push({
      kind:'open',
      amount:remaining.reduce(function(a,n){return a+n.left;},0),
      start:remaining[0].date,
      end:remaining[remaining.length-1].date,
      nfs:remaining.map(function(n){return n.nf;}).filter(Boolean),
      count:remaining.length
    });
  }
  if(!bands.length && notes.length){
    bands.push({kind:'open',amount:notes.reduce(function(a,n){return a+n.total;},0),start:notes[0].date,end:notes[notes.length-1].date,nfs:notes.map(function(n){return n.nf;}).filter(Boolean),count:notes.length});
  }
  return bands;
}
function _pagPaidBandsHtml(report){
  var bands=_pagBuildPaidBands(report.vendas||[],report.pagamentos||[]);
  if(!bands.length)return '<div class="wa-empty">Nenhuma nota ou pagamento para montar faixas de cobertura.</div>';
  return '<div class="pal-paid-band-grid">'+bands.map(function(b){
    if(b.kind==='open'){
      return '<div class="pal-paid-band open">'
        +'<div class="pal-paid-band-title">Em aberto</div>'
        +'<div class="pal-paid-band-range">'+_pagRangeLabel(b.start,b.end)+'</div>'
        +'<div class="pal-paid-band-value" style="color:#991b1b">'+_pagMoney(b.amount)+'</div>'
        +'<div class="pal-paid-band-meta">Valor pendente no período'+(b.nfs&&b.nfs.length?' · ref. NF '+b.nfs.slice(0,4).join(', ')+(b.nfs.length>4?'...':''):'')+'</div>'
      +'</div>';
    }
    var cls=b.partial?'partial':'paid';
    var title=b.partial?'Pago parcialmente':'Pago';
    var color=b.partial?'#92400e':'#166534';
    return '<div class="pal-paid-band '+cls+'">'
      +'<div class="pal-paid-band-title">'+title+'</div>'
      +'<div class="pal-paid-band-range">'+(b.start?_pagRangeLabel(b.start,b.end):'Crédito sem nota vinculada')+'</div>'
      +'<div class="pal-paid-band-value" style="color:'+color+'">'+_pagMoney(b.allocated||b.amount)+'</div>'
      +'<div class="pal-paid-band-meta">Pagamento em '+_pagShortDate(b.paymentDate)+' · recebido '+_pagMoney(b.amount)+(b.credit>0?' · crédito sobrando '+_pagMoney(b.credit):'')+(b.nfs&&b.nfs.length?' · NF '+b.nfs.slice(0,4).join(', ')+(b.nfs.length>4?'...':''):'')+'</div>'
      +(b.id?'<div style="display:flex;gap:6px;margin-top:10px">'
        +'<button onclick="openEditPaymentModal('+b.id+')" title="Editar este pagamento" style="flex:1;background:#4F46E5;color:#fff;border:none;border-radius:6px;padding:5px 8px;font-size:11px;font-weight:700;cursor:pointer">✎ Editar</button>'
        +'<button onclick="deletePayment('+b.id+')" title="Excluir este pagamento" style="flex:1;background:#EF4444;color:#fff;border:none;border-radius:6px;padding:5px 8px;font-size:11px;font-weight:700;cursor:pointer">✕ Excluir</button>'
        +'</div>':'')
    +'</div>';
  }).join('')+'</div>';
}
function _pagBuildCoveragePeriods(period,month,year,vendas,pagamentos){
  var now=new Date();
  var y=Number(year)||now.getFullYear();
  var m=Number(month)||now.getMonth()+1;
  var list=[];
  if(period==='quinzenal'){
    var last=_pagMonthDays(y,m);
    list=[
      {key:y+'-'+String(m).padStart(2,'0')+'-H1',start:new Date(y,m-1,1),end:new Date(y,m-1,15),label:'01/'+String(m).padStart(2,'0')+' - 15/'+String(m).padStart(2,'0')},
      {key:y+'-'+String(m).padStart(2,'0')+'-H2',start:new Date(y,m-1,16),end:new Date(y,m-1,last),label:'16/'+String(m).padStart(2,'0')+' - '+String(last).padStart(2,'0')+'/'+String(m).padStart(2,'0')}
    ];
  }else if(period==='anual'){
    list=[{key:String(y),start:new Date(y,0,1),end:new Date(y,11,31),label:'01/01 - 31/12/'+y}];
  }else{
    if(month){
      list=[{key:y+'-'+String(m).padStart(2,'0'),start:new Date(y,m-1,1),end:new Date(y,m-1,_pagMonthDays(y,m)),label:'01/'+String(m).padStart(2,'0')+' - '+String(_pagMonthDays(y,m)).padStart(2,'0')+'/'+String(m).padStart(2,'0')}];
    }else{
      for(var i=1;i<=12;i++){
        list.push({key:y+'-'+String(i).padStart(2,'0'),start:new Date(y,i-1,1),end:new Date(y,i-1,_pagMonthDays(y,i)),label:String(i).padStart(2,'0')+'/'+y});
      }
    }
  }
  list.forEach(function(p){p.notes=0;p.periodPayments=0;p.allocated=0;p.balance=0;p.status='open';p.statusLabel='Aberto';p.isCurrent=now>=p.start&&now<=p.end;});
  function inPeriod(d,p){ return d && d>=p.start && d<=p.end; }
  (vendas||[]).forEach(function(v){
    var d=_pagDateObj(v.saledate);
    var p=list.find(function(x){return inPeriod(d,x);});
    if(p)p.notes+=Number(v.total||0);
  });
  (pagamentos||[]).forEach(function(pg){
    var d=_pagDateObj(pg.payment_date);
    var p=list.find(function(x){return inPeriod(d,x);});
    if(p)p.periodPayments+=Number(pg.amount||0);
  });
  var payments=(pagamentos||[]).map(function(pg){return {date:_pagDateObj(pg.payment_date),amount:Number(pg.amount||0),left:Number(pg.amount||0)};})
    .sort(function(a,b){return (a.date||0)-(b.date||0);});
  list.forEach(function(periodRow){
    var need=periodRow.notes;
    payments.forEach(function(pg){
      if(need<=0||pg.left<=0)return;
      var use=Math.min(need,pg.left);
      periodRow.allocated+=use;
      pg.left-=use;
      need-=use;
    });
    periodRow.balance=Math.max(0,periodRow.notes-periodRow.allocated);
    if(periodRow.notes<=0 && periodRow.periodPayments<=0 && periodRow.end>now){ periodRow.status='future'; periodRow.statusLabel='Em aberto'; }
    else if(periodRow.notes<=0 && periodRow.periodPayments<=0){ periodRow.status='future'; periodRow.statusLabel='Sem notas'; }
    else if(periodRow.balance<=0){ periodRow.status='paid'; periodRow.statusLabel='Pago'; }
    else if(periodRow.allocated>0 || periodRow.periodPayments>0){ periodRow.status='partial'; periodRow.statusLabel='Parcial'; }
    else { periodRow.status='open'; periodRow.statusLabel='Aberto'; }
  });
  return list;
}

function renderPaymentCoverage(report,params){
  var el=document.getElementById('pag-coverage-wrap');
  if(!el)return;
  el.innerHTML=_pagPaidBandsHtml(report);
}

function buildPeriods(nts, pp) {
  if (!nts || !nts.length) return [];
  const dates = nts.map(n => n.saledate || n.date || '').filter(Boolean).sort();
  if (!dates.length) return [];
  const firstDate = new Date(dates[0] + 'T00:00:00');
  const lastDate = new Date(dates[dates.length - 1] + 'T00:00:00');
  const periods = [];
  let cur = new Date(firstDate.getFullYear(), firstDate.getMonth(), 1);
  while (cur <= lastDate) {
    const y = cur.getFullYear();
    const m = cur.getMonth();
    const lastDay = new Date(y, m + 1, 0).getDate();
    periods.push({
      start: new Date(y, m, 1),
      end: new Date(y, m, 15),
      label: `01/${String(m + 1).padStart(2, '0')} – 15/${String(m + 1).padStart(2, '0')}/${y}`
    });
    periods.push({
      start: new Date(y, m, 16),
      end: new Date(y, m, lastDay),
      label: `16/${String(m + 1).padStart(2, '0')} – ${lastDay}/${String(m + 1).padStart(2, '0')}/${y}`
    });
    cur = new Date(y, m + 1, 1);
  }
  const toYMD = d => d.toISOString().slice(0, 10);
  let carryover = 0;
  return periods.map(function (p) {
    const ps = toYMD(p.start);
    const pe = toYMD(p.end);
    const periodNts = nts.filter(n => {
      const d = n.saledate || n.date || '';
      return d >= ps && d <= pe;
    });
    const periodPps = (pp || []).filter(p2 => {
      const d = p2.payment_date || p2.paymentdate || p2.date || '';
      return d >= ps && d <= pe;
    });
    const periodTotal = periodNts.reduce((a, n) => a + (parseFloat(n.total) || 0), 0);
    const periodPaid = periodPps.reduce((a, p2) => a + (parseFloat(p2.amount) || 0), 0);
    const payDate = periodPps.length ? (periodPps[0].payment_date || periodPps[0].paymentdate || periodPps[0].date || '') : null;
    const totalAvailable = periodPaid + carryover;
    const allocated = Math.min(totalAvailable, periodTotal);
    const newCarry = Math.max(0, totalAvailable - periodTotal);
    let kind = 'open';
    if (periodTotal <= 0 && !periodNts.length) {
      carryover = newCarry;
      return null;
    }
    if (allocated >= periodTotal && periodTotal > 0) kind = 'paid';
    else if (allocated > 0) kind = 'partial';
    carryover = newCarry;
    return {
      kind,
      label: p.label,
      amount: periodTotal,
      allocated,
      payment: payDate ? new Date(payDate + 'T00:00:00').toLocaleDateString('pt-BR') : null,
      credit: newCarry
    };
  }).filter(Boolean);
}

function renderCoverageBands(nts, pp, containerEl) {
  if (!containerEl) return;
  if (!nts || !nts.length) {
    containerEl.innerHTML = '';
    return;
  }
  const periods = buildPeriods(nts, pp);
  if (!periods.length) {
    containerEl.innerHTML = '';
    return;
  }
  const moneyFmt = v => (v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  let html = '<div style="margin:12px 0 6px;">';
  html += '<div style="font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px;">Cobertura por período</div>';
  html += '<div class="pal-paid-band-grid">';
  periods.forEach(function (b) {
    const cls = b.kind === 'paid' ? 'paid' : b.kind === 'partial' ? 'partial' : 'open';
    const label = cls === 'paid' ? '✅ Pago' : cls === 'partial' ? '⚠️ Parcial' : '🔴 Em aberto';
    html += `<div class="pal-paid-band ${cls}">`;
    html += `<div class="pal-paid-band-title">${label}</div>`;
    html += `<div class="pal-paid-band-range">${b.label}</div>`;
    html += `<div class="pal-paid-band-value">${moneyFmt(b.allocated || b.amount)}</div>`;
    html += '<div class="pal-paid-band-meta">';
    if (b.payment) html += `Pago em ${b.payment}`;
    if (b.credit > 0) html += ` · Crédito: ${moneyFmt(b.credit)}`;
    html += '</div></div>';
  });
  html += '</div></div>';
  containerEl.innerHTML = html;
}

function _loadPagClientList(){
  var el=document.getElementById('pal-pag-cliente');
  if(!el) return;
  try{
    var period=document.getElementById('pal-filter-period')?.value||'mensal';
    var m=document.getElementById('pal-filter-month')?.value||'';
    var y=document.getElementById('pal-filter-year')?.value||'';
    api('/api/monteiro/clients/list?period='+period+'&month='+m+'&year='+y).then(function(list){
      var dl=document.getElementById('pal-client-list');
      if(dl) dl.innerHTML=(list||[]).map(function(d){return '<option value="'+d.replace(/"/g,'&quot;')+'">';}).join('');
    });
  }catch(e){}
}

async function loadPaladarPayments(){
  var p=_pagParams();
  var params='?client='+encodeURIComponent(p.client)+'&period='+p.period+'&month='+p.month+'&year='+p.year;
  // Carregar lista de clientes no datalist
  _loadPagClientList();
  // Se não há cliente, mostrar hint
  if(!p.client){
    ['pag-total-vendido','pag-total-pago','pag-saldo','pag-num-notas','pag-num-pagamentos'].forEach(function(id){
      var el=document.getElementById(id); if(el) el.textContent='—';
    });
    document.getElementById('pag-ultimo-pagamento').textContent='—';
    document.getElementById('pag-progress-bar').style.width='0%';
    document.getElementById('pag-progress-text').textContent='0% quitado';
    var badge=document.getElementById('pag-active-client');
    if(badge){ badge.style.display='none'; badge.textContent=''; }
    var start=document.getElementById('pag-start-hint'); if(start) start.style.display='flex';
    var cards=document.getElementById('pag-summary-cards'); if(cards) cards.style.display='none';
    var progress=document.getElementById('pag-progress-wrap'); if(progress) progress.style.display='none';
    var covCard=document.getElementById('pag-coverage-card'); if(covCard) covCard.style.display='none';
    document.getElementById('pag-notas-wrap').innerHTML='<div class="pal-pay-empty-compact">Selecione um cliente para ver as notas do período.</div>';
    document.getElementById('pag-pagamentos-wrap').innerHTML='<div class="pal-pay-empty-compact">Selecione um cliente para ver os pagamentos registrados.</div>';
    document.getElementById('pag-coverage-wrap').innerHTML='';
    var bandsEmpty=document.getElementById('pal-coverage-bands'); if(bandsEmpty) bandsEmpty.innerHTML='';
    document.getElementById('pag-extrato-wrap').innerHTML='<div class="pal-pay-empty-compact">Selecione um cliente para ver o extrato cronológico.</div>';
    return;
  }
  var start=document.getElementById('pag-start-hint'); if(start) start.style.display='none';
  var cards=document.getElementById('pag-summary-cards'); if(cards) cards.style.display='grid';
  var progress=document.getElementById('pag-progress-wrap'); if(progress) progress.style.display='block';
  var covCard=document.getElementById('pag-coverage-card'); if(covCard) covCard.style.display='';
  var badge=document.getElementById('pag-active-client');
  if(badge){ badge.style.display='inline-block'; badge.textContent='👤 Cliente: '+p.client; }
  // Summary
  try{
    var s=await api('/api/monteiro/payments/summary'+params);
    document.getElementById('pag-total-vendido').textContent='R$ '+(s.total_vendido||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    document.getElementById('pag-total-pago').textContent='R$ '+(s.total_pago||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    var saldo=s.saldo||0;
    var saldoEl=document.getElementById('pag-saldo');
    if(saldo<=0){
      saldoEl.innerHTML='✅ R$ 0,00 <span style="font-size:10px;font-weight:400">(quitado)</span>';
      saldoEl.style.color='#22c55e';
    } else {
      saldoEl.innerHTML='🔴 R$ '+saldo.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+' <span style="font-size:10px;font-weight:400">(pendente)</span>';
      saldoEl.style.color='#EF4444';
    }
    document.getElementById('pag-num-notas').textContent=s.num_notas||0;
    document.getElementById('pag-num-pagamentos').textContent=s.num_pagamentos||0;
    document.getElementById('pag-ultimo-pagamento').textContent=s.ultimo_pagamento||'—';
    // Progress bar
    var tv=s.total_vendido||0;
    var tp=s.total_pago||0;
    var pct=tv>0?Math.min(100,(tp/tv)*100):0;
    document.getElementById('pag-progress-bar').style.width=pct+'%';
    document.getElementById('pag-progress-text').textContent=pct.toFixed(1)+'% quitado';
  }catch(e){ console.warn('pag summary:',e); }
  // Report
  try{
    var r=await api('/api/monteiro/payments/report'+params);
    _paymentsCache=r;
    renderPaymentCoverage(r,p);
    var bandsEl=document.getElementById('pal-coverage-bands');
    renderCoverageBands(r.vendas||[], r.pagamentos||[], bandsEl);
    // Notas
    var nEl=document.getElementById('pag-notas-wrap');
    var vendas=r.vendas||[];
    if(!vendas.length){
      nEl.innerHTML='<div class="wa-empty">Nenhuma nota no período para este cliente.</div>';
    } else {
      nEl.innerHTML='<div class="pal-pay-scroll" style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="background:#4F46E5;color:#fff">'
        +'<th style="padding:6px 8px;text-align:left">Data</th><th style="padding:6px 8px;text-align:left">NF</th>'
        +'<th style="padding:6px 8px;text-align:right">Qtd</th><th style="padding:6px 8px;text-align:right">Valor</th>'
        +'<th style="padding:6px 8px;text-align:left">Entregador</th></tr></thead><tbody>'
        +vendas.map(function(v,i){
          return '<tr style="border-bottom:1px solid var(--border);background:'+(i%2===0?'var(--card)':'var(--g50)')+'">'
            +'<td style="padding:6px 8px;font-size:10px">'+(v.saledate||'')+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+(v.nf_number||'—')+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-size:10px">'+(v.qty||0).toLocaleString('pt-BR',{maximumFractionDigits:1})+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-weight:700;color:#4F46E5;font-size:10px">R$ '+(v.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+(v.entregador||'')+'</td></tr>';
        }).join('')
        +'</tbody><tfoot><tr style="background:var(--g50);font-weight:700"><td colspan="3" style="padding:6px 8px;text-align:right;font-size:11px">Total:</td>'
        +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-size:11px;color:#4F46E5">R$ '+(r.total_vendas||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
        +'<td></td></tr></tfoot></table></div>';
    }
    // Pagamentos
    var pEl=document.getElementById('pag-pagamentos-wrap');
    var pags=r.pagamentos||[];
    if(!pags.length){
      pEl.innerHTML='<div class="wa-empty">Nenhum pagamento registrado para este cliente.</div>';
    } else {
      pEl.innerHTML='<div class="pal-pay-scroll" style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="background:#4F46E5;color:#fff">'
        +'<th style="padding:6px 8px;text-align:left">Data</th><th style="padding:6px 8px;text-align:right">Valor</th>'
        +'<th style="padding:6px 8px;text-align:left">Tipo</th><th style="padding:6px 8px;text-align:left">Competência</th>'
        +'<th style="padding:6px 8px;text-align:left">Obs</th><th style="padding:6px 8px;text-align:center">Ação</th></tr></thead><tbody>'
        +pags.map(function(p,i){
          return '<tr style="border-bottom:1px solid var(--border);background:'+(i%2===0?'var(--card)':'var(--g50)')+'">'
            +'<td style="padding:6px 8px;font-size:10px">'+p.payment_date+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-weight:700;color:#22c55e;font-size:10px">R$ '+(p.amount||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+p.payment_type+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+(p.month||'')+'/'+(p.year||'')+'</td>'
            +'<td style="padding:6px 8px;font-size:10px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+(p.notes||'').replace(/"/g,'&quot;')+'">'+(p.notes||'')+'</td>'
            +'<td style="padding:6px 8px;text-align:center;white-space:nowrap">'
        +'<button onclick="openEditPaymentModal('+p.id+')" title="Editar pagamento" style="background:#4F46E5;color:#fff;border:none;border-radius:5px;padding:3px 9px;font-size:10px;font-weight:700;cursor:pointer;margin-right:4px">✎ Editar</button>'
        +'<button onclick="deletePayment('+p.id+')" title="Excluir pagamento" style="background:#EF4444;color:#fff;border:none;border-radius:5px;padding:3px 9px;font-size:10px;font-weight:700;cursor:pointer">✕ Excluir</button></td></tr>';
        }).join('')
        +'</tbody></table></div>';
      _pagamentosData = pags;
    }
    // Extrato
    var eEl=document.getElementById('pag-extrato-wrap');
    var ext=r.extrato||[];
    if(!ext.length){
      eEl.innerHTML='<div class="wa-empty">Nenhum movimento no período para este cliente.</div>';
    } else {
      var saldoCorrente=0;
      eEl.innerHTML='<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="background:#4F46E5;color:#fff">'
        +'<th style="padding:6px 8px;text-align:left">Data</th><th style="padding:6px 8px;text-align:left">Descrição</th>'
        +'<th style="padding:6px 8px;text-align:right">Valor</th><th style="padding:6px 8px;text-align:right">Saldo</th></tr></thead><tbody>'
        +ext.map(function(e,i){
          var val=e.valor||0;
          var isPagamento=e.tipo==='pagamento';
          var isTotal=e.tipo==='total_notas';
          saldoCorrente+=val;
          var cor=isPagamento?'#22c55e':(isTotal?'#4F46E5':'var(--g800)');
          var bg=i%2===0?'var(--card)':'var(--g50)';
          if(isTotal) bg='var(--g100)';
          return '<tr style="border-bottom:1px solid var(--border);background:'+bg+';font-weight:'+(isTotal?'700':'400')+'">'
            +'<td style="padding:6px 8px;font-size:10px">'+(e.data||'')+'</td>'
            +'<td style="padding:6px 8px;font-size:10px">'+(e.descricao||'')+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-size:10px;color:'+cor+'">R$ '+Math.abs(val).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td>'
            +'<td style="padding:6px 8px;text-align:right;font-family:monospace;font-weight:700;font-size:10px;color:'+(saldoCorrente<=0?'#22c55e':'#EF4444')+'">R$ '+Math.abs(saldoCorrente).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'</td></tr>';
        }).join('')
        +'</tbody></table></div>';
    }
  }catch(e){ console.warn('pag report:',e); }
}

function openPaymentModal(){
  document.getElementById('pag-edit-id').value='';
  document.getElementById('pag-modal-title').textContent='💰 Lançar Pagamento';
  var now=new Date();
  document.getElementById('pag-cliente').value=document.getElementById('pal-pag-cliente')?.value||'';
  document.getElementById('pag-data').value=now.toISOString().slice(0,10);
  document.getElementById('pag-valor').value='';
  document.getElementById('pag-comp-month').value=String(now.getMonth()+1).padStart(2,'0');
  document.getElementById('pag-comp-year').value=String(now.getFullYear());
  document.getElementById('pag-tipo').value='repasse';
  document.getElementById('pag-obs').value='';
  document.getElementById('pag-modal-err').style.display='none';
  document.getElementById('pal-pag-modal').style.display='flex';
}

function openEditPaymentModal(id){
  var pag = _pagamentosData.find(function(p){ return p.id == id; });
  if(!pag){ toast('Pagamento não encontrado.','error'); return; }
  document.getElementById('pag-edit-id').value = id;
  document.getElementById('pag-modal-title').textContent = '✎ Editar Pagamento';
  document.getElementById('pag-cliente').value = pag.client || '';
  document.getElementById('pag-data').value = pag.payment_date || '';
  document.getElementById('pag-valor').value = pag.amount || '';
  document.getElementById('pag-comp-month').value = (pag.month||'').padStart(2,'0');
  document.getElementById('pag-comp-year').value = String(pag.year||'');
  document.getElementById('pag-tipo').value = pag.payment_type || 'repasse';
  document.getElementById('pag-obs').value = pag.notes || '';
  document.getElementById('pag-modal-err').style.display='none';
  document.getElementById('pal-pag-modal').style.display='flex';
}

function closePaymentModal(){
  document.getElementById('pal-pag-modal').style.display='none';
}

async function savePayment(){
  var editId = document.getElementById('pag-edit-id').value;
  var client=document.getElementById('pag-cliente').value.trim();
  var pdate=document.getElementById('pag-data').value;
  var amount=parseFloat(document.getElementById('pag-valor').value);
  var errEl=document.getElementById('pag-modal-err');
  if(!client||!pdate||!amount||amount<=0){
    errEl.textContent='Preencha cliente, data e valor válido.';
    errEl.style.display='block'; return;
  }
  var month=document.getElementById('pag-comp-month').value||pdate.slice(5,7);
  var year=document.getElementById('pag-comp-year').value||pdate.slice(0,4);
  var body={
    client:client, payment_date:pdate, amount:amount,
    month:month, year:year,
    payment_type:document.getElementById('pag-tipo').value,
    notes:document.getElementById('pag-obs').value.trim()
  };
  errEl.style.display='none';
  try{
    if(editId){
      await api('/api/monteiro/payments/'+editId,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      toast('✅ Pagamento atualizado!');
    } else {
      await api('/api/monteiro/payments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      toast('✅ Pagamento lançado!');
    }
    closePaymentModal();
    loadPaladarPayments();
  }catch(e){ errEl.textContent=e.message; errEl.style.display='block'; }
}

async function deletePayment(id){
  if(!confirm('Excluir este pagamento?')) return;
  try{
    await api('/api/monteiro/payments/'+id,{method:'DELETE'});
    toast('Pagamento removido.');
    loadPaladarPayments();
  }catch(e){ toast(e.message,'error'); }
}

function _paymentExportFilename(ext){
  var p=_pagParams();
  var client=(p.client||'todos_clientes').trim()||'todos_clientes';
  var safeClient=client.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]+/g,'_').replace(/^_+|_+$/g,'').toUpperCase();
  var comp='';
  if(p.month&&p.year) comp=p.month+'-'+p.year;
  else if(p.year) comp=p.year;
  else comp=(p.period||'periodo');
  return safeClient+'_'+comp+'.'+ext;
}

function exportPaymentsPDF(btn){
  var p=_pagParams();
  var url='/api/monteiro/payments/report/pdf?client='+encodeURIComponent(p.client)+'&period='+p.period+'&month='+p.month+'&year='+p.year;
  _downloadBlob(url,_paymentExportFilename('pdf'),btn);
}

function exportPaymentsExcel(){
  var p=_pagParams();
  _downloadBlob('/api/monteiro/payments/report/excel?client='+encodeURIComponent(p.client)+'&period='+p.period+'&month='+p.month+'&year='+p.year,_paymentExportFilename('xlsx'));
}

/* ── CRUD de Produtos Monteiro ── */
function openPaladarProductModal(){
  document.getElementById('pal-product-modal-title').textContent = '📦 Novo Produto';
  document.getElementById('pal-prod-name').value = '';
  document.getElementById('pal-prod-price').value = '';
  document.getElementById('pal-prod-edit-id').value = '';
  document.getElementById('paladar-product-modal').style.display = 'flex';
  document.getElementById('pal-prod-name').focus();
}

function closePaladarProductModal(){
  document.getElementById('paladar-product-modal').style.display = 'none';
}

function editPaladarProduct(id){
  var p = _palProductsCache.find(function(x){ return x.id === id; });
  if(!p) return;
  document.getElementById('pal-product-modal-title').textContent = '✏️ Editar Produto';
  document.getElementById('pal-prod-name').value = p.name;
  document.getElementById('pal-prod-price').value = p.suggested_price || '';
  document.getElementById('pal-prod-edit-id').value = id;
  document.getElementById('paladar-product-modal').style.display = 'flex';
  document.getElementById('pal-prod-name').focus();
}

async function savePaladarProduct(){
  var name = document.getElementById('pal-prod-name').value.trim();
  var price = parseFloat(document.getElementById('pal-prod-price').value) || 0;
  var editId = document.getElementById('pal-prod-edit-id').value;
  if(!name){ toast('Informe o nome do produto.', 'error'); return; }
  var btn = document.getElementById('pal-prod-save-btn');
  if(btn){ btn.disabled = true; btn.textContent = 'Salvando...'; }
  try{
    if(editId){
      await fetch('/api/monteiro/products/'+editId, {
        method:'PUT',
        headers:{'Content-Type':'application/json','x-token':(typeof session !== 'undefined' ? session.token : '') || ''},
        body:JSON.stringify({name:name, suggested_price:price})
      });
      toast('Produto atualizado!');
    } else {
      var r = await fetch('/api/monteiro/products', {
        method:'POST',
        headers:{'Content-Type':'application/json','x-token':(typeof session !== 'undefined' ? session.token : '') || ''},
        body:JSON.stringify({name:name, suggested_price:price})
      });
      var d = await r.json();
      if(!r.ok) throw new Error(d.error || 'Erro ao criar');
      toast('Produto criado!');
    }
    closePaladarProductModal();
    await loadPaladarProducts();
  }catch(e){ toast('Erro: '+e.message, 'error'); }
  finally{ if(btn){ btn.disabled = false; btn.textContent = '✅ Salvar'; } }
}

async function deletePaladarProduct(id){
  if(!confirm('Excluir este produto?')) return;
  try{
    var r = await fetch('/api/monteiro/products/'+id, {
      method:'DELETE',
      headers:{'x-token':(typeof session !== 'undefined' ? session.token : '') || ''}
    });
    if(!r.ok) throw new Error('Erro ao excluir');
    toast('Produto excluído!');
    await loadPaladarProducts();
  }catch(e){ toast('Erro: '+e.message, 'error'); }
}

// ── GESTAO UI ADDON: Painel de risco de avarias por cliente ────────────────
let avRiskChart=null, avRiskTrendChart=null, _avRiskRows=[];
let _avCalendarDayData={};

function _mgmtEsc(v){
  return String(v == null ? '' : v).replace(/[&<>"']/g,function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}
function _mgmtMonthName(m){ return MONTHS[(Number(m)||1)-1] || ''; }
function _mgmtYM(s){ return s && s.length >= 7 ? s.slice(0,7) : ''; }
function _mgmtRiskLevel(rate,value,count){
  rate=Number(rate||0);
  if(rate > 25) return {key:'high',label:'Alto risco'};
  if(rate > 15) return {key:'med',label:'Atenção'};
  return {key:'low',label:'Controlado'};
}
function _mgmtAvariaRiskScore(r){
  return (Number(r.rate||0)*1000000) + (Number(r.avTotal||0)*10) + Number(r.avCount||0);
}
function _mgmtSortAvariaRiskRows(rows, sort){
  rows.sort(function(a,b){
    if(sort==='score'){
      return (Number(b.rate||0)-Number(a.rate||0))
        || (Number(b.avTotal||0)-Number(a.avTotal||0))
        || (Number(b.avCount||0)-Number(a.avCount||0));
    }
    return Number(b[sort]||0)-Number(a[sort]||0);
  });
  return rows;
}
function _mgmtSetVal(id,value){ var el=document.getElementById(id); if(el) el.textContent=value; }
function _mgmtFilterAvariaClient(client){
  var sel=document.getElementById('cal-client');
  if(sel){ sel.value=client || ''; renderAvariaCalendar(); }
}
function _mgmtOpenClientesTab(){
  var btn=document.querySelector(".tab[onclick*='clientes']");
  if(btn) switchTab(btn,'clientes');
}

function _avGroupDayRows(rows,type){
  var map={};
  rows.forEach(function(s){
    var cl=(s.client||'Sem cliente').trim();
    var key=cl+'|'+(s.nf_number||'')+'|'+(s.sale_date||'');
    var p=prodCanonicalName(s.product,s.sale_type)||s.product||'Sem produto';
    if(!map[key])map[key]={client:cl,nf:s.nf_number||'',date:s.sale_date||'',total:0,qty:0,count:0,products:{},type:type};
    map[key].total+=Math.abs(Number(s.total||0));
    map[key].qty+=Math.abs(Number(s.quantity||0));
    map[key].count++;
    map[key].products[p]=map[key].products[p]||{product:p,total:0,qty:0,count:0};
    map[key].products[p].total+=Math.abs(Number(s.total||0));
    map[key].products[p].qty+=Math.abs(Number(s.quantity||0));
    map[key].products[p].count++;
  });
  return Object.values(map).sort(function(a,b){return b.total-a.total;}).map(function(r){
    r.products=Object.values(r.products).sort(function(a,b){return b.total-a.total;});
    return r;
  });
}

function _avClientMonthRowsHtml(rows,kind){
  if(!rows.length)return '<div class="av-day-empty">Nenhum registro neste lado do mês.</div>';
  var grouped=_avGroupDayRows(rows,kind);
  return grouped.map(function(r){
    var prods=r.products.slice(0,4).map(function(p){
      return _mgmtEsc(p.product)+' ('+p.qty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.)';
    }).join(', ');
    var color=kind==='bad'?'#991b1b':'#166534';
    return '<div class="av-day-row">'
      +'<div class="av-day-client"><span>'+(_mgmtEsc(r.date||''))+(r.nf?' · NF '+_mgmtEsc(r.nf):'')+'</span><span class="mono" style="color:'+color+'">'+fmt(r.total)+'</span></div>'
      +'<div class="av-day-meta"><span>'+r.count+' registro(s)</span><span>'+r.qty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</span></div>'
      +'<div class="av-day-products" title="'+prods+'">'+prods+'</div>'
    +'</div>';
  }).join('');
}

function showAvariaClientMonthDetail(client){
  var target=document.getElementById('av-day-detail');
  if(!target)return;
  var yearSel=(document.getElementById('cal-year')&&document.getElementById('cal-year').value)||String(new Date().getFullYear());
  var monthSel=(document.getElementById('cal-month')&&document.getElementById('cal-month').value)||String(new Date().getMonth()+1).padStart(2,'0');
  var ym=yearSel+'-'+monthSel;
  var clean=String(client||'').trim();
  var vendas=allSales.filter(function(s){return s.sale_type!=='AVARIA' && _mgmtYM(s.sale_date)===ym && (s.client||'').trim()===clean;});
  var avarias=allSales.filter(function(s){return s.sale_type==='AVARIA' && _mgmtYM(s.sale_date)===ym && (s.client||'').trim()===clean;});
  var vendVal=vendas.reduce(function(a,s){return a+Math.abs(Number(s.total||0));},0);
  var avVal=avarias.reduce(function(a,s){return a+Math.abs(Number(s.total||0));},0);
  var vendQty=vendas.reduce(function(a,s){return a+Math.abs(Number(s.quantity||0));},0);
  var avQty=avarias.reduce(function(a,s){return a+Math.abs(Number(s.quantity||0));},0);
  var rate=vendVal>0?avVal/vendVal*100:0;
  target.innerHTML='<div class="av-day-detail">'
    +'<div class="av-day-detail-head">'
      +'<div><div style="font-size:13px;font-weight:900;color:var(--g800)">'+_mgmtEsc(clean)+' - '+_mgmtMonthName(monthSel)+' '+yearSel+'</div>'
      +'<div style="font-size:11px;color:var(--muted)">Resumo do cliente no mês: o que foi entregue/faturado e o que retornou como avaria.</div></div>'
      +'<div style="display:flex;gap:6px;flex-wrap:wrap">'
        +'<span class="risk-badge low">Entregue '+fmt(vendVal)+'</span>'
        +'<span class="risk-badge high">Retornado '+fmt(avVal)+'</span>'
        +'<span class="risk-badge med">Taxa '+rate.toFixed(1).replace('.',',')+'%</span>'
      +'</div>'
    +'</div>'
    +'<div class="mgmt-kpi-grid" style="padding:12px;margin:0;border-bottom:1px solid var(--border)">'
      +'<div class="mgmt-kpi ok"><div class="mgmt-kpi-label">Entregue no mês</div><div class="mgmt-kpi-value">'+fmt(vendVal)+'</div><div class="mgmt-kpi-sub">'+vendas.length+' registros · '+vendQty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</div></div>'
      +'<div class="mgmt-kpi danger"><div class="mgmt-kpi-label">Retornado / avariado</div><div class="mgmt-kpi-value">'+fmt(avVal)+'</div><div class="mgmt-kpi-sub">'+avarias.length+' ocorrências · '+avQty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</div></div>'
      +'<div class="mgmt-kpi warn"><div class="mgmt-kpi-label">Impacto</div><div class="mgmt-kpi-value">'+rate.toFixed(1).replace('.',',')+'%</div><div class="mgmt-kpi-sub">sobre o valor entregue ao cliente</div></div>'
    +'</div>'
    +'<div class="av-day-detail-grid">'
      +'<div class="av-day-col good"><div class="av-day-col-title"><span>Entregue / faturado no mês</span><span>'+vendas.length+' registro(s)</span></div>'+_avClientMonthRowsHtml(vendas,'good')+'</div>'
      +'<div class="av-day-col bad"><div class="av-day-col-title"><span>Avariado / retornado no mês</span><span>'+avarias.length+' ocorrência(s)</span></div>'+_avClientMonthRowsHtml(avarias,'bad')+'</div>'
    +'</div>'
  +'</div>';
  target.scrollIntoView({behavior:'smooth',block:'start'});
}

function _avDayRowsHtml(rows,kind){
  if(!rows.length)return '<div class="av-day-empty">Nenhum registro neste lado do dia.</div>';
  return rows.map(function(r){
    var prods=r.products.slice(0,3).map(function(p){return p.product+' ('+p.qty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.)';}).join(', ');
    var more=r.products.length>3?' +'+(r.products.length-3):'';
    return '<div class="av-day-row">'
      +'<div class="av-day-client"><span>'+_mgmtEsc(r.client)+'</span><span class="mono" style="color:'+(kind==='bad'?'#991b1b':'#166534')+'">'+fmt(r.total)+'</span></div>'
      +'<div class="av-day-meta">'
        +'<span>'+r.count+' registro(s)</span>'
        +'<span>'+r.qty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</span>'
        +(r.nf?'<span>NF '+_mgmtEsc(r.nf)+'</span>':'')
        +'<button class="btn btn-secondary btn-sm" style="padding:2px 7px;font-size:10px" onclick="showAvariaClientMonthDetail('+JSON.stringify(r.client).replace(/"/g,'&quot;')+')">Ver cliente</button>'
      +'</div>'
      +'<div class="av-day-products" title="'+_mgmtEsc(prods)+'">'+_mgmtEsc(prods)+_mgmtEsc(more)+'</div>'
    +'</div>';
  }).join('');
}

function showAvariaDayDetail(day,focus){
  var data=_avCalendarDayData[day];
  var target=document.getElementById('av-day-detail');
  if(!data||!target)return;
  var vendRows=_avGroupDayRows(data.vendas||[],'vendas');
  var avRows=_avGroupDayRows(data.avarias||[],'avarias');
  var rate=data.vendVal>0?(data.avVal/data.vendVal*100):0;
  target.innerHTML='<div class="av-day-detail">'
    +'<div class="av-day-detail-head">'
      +'<div><div style="font-size:13px;font-weight:800;color:var(--g800)">Dia '+day+' - '+_mgmtEsc(data.label)+'</div>'
      +'<div style="font-size:11px;color:var(--muted)">Clique em "Ver cliente" para filtrar o calendário e analisar a recorrência daquele cliente.</div></div>'
      +'<div style="display:flex;gap:6px;flex-wrap:wrap">'
        +'<span class="risk-badge low">Entregue '+fmt(data.vendVal)+'</span>'
        +'<span class="risk-badge high">Avaria '+fmt(data.avVal)+'</span>'
        +'<span class="risk-badge med">Taxa '+rate.toFixed(1).replace('.',',')+'%</span>'
      +'</div>'
    +'</div>'
    +'<div class="av-day-detail-grid">'
      +'<div class="av-day-col good" style="'+(focus==='vendas'?'box-shadow:0 0 0 2px rgba(22,163,74,.22)':'')+'"><div class="av-day-col-title"><span>Entregue / faturado</span><span>'+vendRows.length+' cliente(s)</span></div>'+_avDayRowsHtml(vendRows,'good')+'</div>'
      +'<div class="av-day-col bad" style="'+(focus==='avarias'?'box-shadow:0 0 0 2px rgba(220,38,38,.22)':'')+'"><div class="av-day-col-title"><span>Avariado / retornado</span><span>'+avRows.length+' cliente(s)</span></div>'+_avDayRowsHtml(avRows,'bad')+'</div>'
    +'</div>'
  +'</div>';
  target.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function _mgmtSetCompactFilter(id,value,rerender){
  var el=document.getElementById(id);
  if(el)el.value=value;
  document.querySelectorAll('[data-filter-target="'+id+'"]').forEach(function(btn){
    btn.classList.toggle('active', String(btn.dataset.value)===String(value));
  });
  if(rerender==='calendar')renderAvariaCalendar();
  else renderAvariaRanking();
}

function switchAvariaView(view){
  const lista=document.getElementById('av-lista');
  const clientes=document.getElementById('av-clientes');
  const btnL=document.getElementById('av-btn-lista');
  const btnC=document.getElementById('av-btn-clientes');
  if(view==='clientes'){
    if(lista)lista.style.display='none';
    if(clientes){clientes.style.display='block';initAvariaCalendar();}
    if(btnL){btnL.style.background='transparent';btnL.style.color='var(--muted)';}
    if(btnC){btnC.style.background='#B71C1C';btnC.style.color='#fff';}
  }else{
    if(lista)lista.style.display='block';
    if(clientes)clientes.style.display='none';
    if(btnL){btnL.style.background='#B71C1C';btnL.style.color='#fff';}
    if(btnC){btnC.style.background='transparent';btnC.style.color='var(--muted)';}
  }
}

function initAvariaCalendar(){
  const el=document.getElementById('av-clientes'); if(!el)return;
  const avarias=allSales.filter(function(s){return s.sale_type==='AVARIA';});
  const clients=[...new Set(avarias.map(function(s){return (s.client||'').trim();}).filter(Boolean))].sort();
  const now=new Date(); const curY=now.getFullYear(), curM=String(now.getMonth()+1).padStart(2,'0');
  const clientOpts='<option value="">Todos os clientes</option>'+clients.map(function(c){
    return '<option value="'+_mgmtEsc(c)+'">'+_mgmtEsc(c)+'</option>';
  }).join('');
  const monthOpts=MONTHS.map(function(m,i){
    var v=String(i+1).padStart(2,'0');
    return '<option value="'+v+'"'+(v===curM?' selected':'')+'>'+m+'</option>';
  }).join('');
  const years=[curY,curY-1,curY-2,curY+1].filter(function(v,i,a){return a.indexOf(v)===i;}).sort(function(a,b){return b-a;});
  const yearOpts=years.map(function(y){return '<option value="'+y+'"'+(y===curY?' selected':'')+'>'+y+'</option>';}).join('');
  const monthBtns=MONTHS.map(function(m,i){
    var v=String(i+1).padStart(2,'0');
    return '<button type="button" class="mgmt-chip '+(v===curM?'active':'')+'" data-filter-target="cal-month" data-value="'+v+'" onclick="_mgmtSetCompactFilter(\'cal-month\',\''+v+'\',\'calendar\')">'+MS[i]+'</button>';
  }).join('');
  const yearBtns=years.map(function(y){
    return '<button type="button" class="mgmt-chip neutral '+(y===curY?'active':'')+'" data-filter-target="cal-year" data-value="'+y+'" onclick="_mgmtSetCompactFilter(\'cal-year\',\''+y+'\',\'calendar\')">'+y+'</button>';
  }).join('');
  el.innerHTML=
    '<div class="mgmt-page-head">'
      +'<div><h2 class="mgmt-title">Painel de risco por cliente</h2>'
      +'<div class="mgmt-subtitle">Clientes com maior impacto financeiro, taxa de avaria, recorrência e evolução mensal.</div></div>'
      +'<button class="btn btn-secondary btn-sm" onclick="renderAvariaCalendar()">↺ Atualizar</button>'
    +'</div>'
    +'<div class="mgmt-filterbar compact">'
      +'<div class="mgmt-filter-group mgmt-client-filter"><div class="mgmt-filter-label">Cliente</div><select id="cal-client" class="filt" onchange="renderAvariaCalendar()">'+clientOpts+'</select></div>'
      +'<select id="cal-month" class="filt mgmt-hidden-select" onchange="renderAvariaCalendar()">'+monthOpts+'</select>'
      +'<select id="cal-year" class="filt mgmt-hidden-select" onchange="renderAvariaCalendar()">'+yearOpts+'</select>'
      +'<select id="av-risk-sort" class="filt mgmt-hidden-select" onchange="renderAvariaRanking()">'
        +'<option value="score">Risco por taxa</option><option value="avTotal">Valor avariado</option>'
        +'<option value="rate">Taxa de avaria</option><option value="avCount">Ocorrências</option>'
      +'</select>'
      +'<select id="av-risk-level" class="filt mgmt-hidden-select" onchange="renderAvariaRanking()">'
        +'<option value="">Todos os níveis</option><option value="high">Alto risco</option><option value="med">Atenção</option><option value="low">Controlado</option>'
      +'</select>'
      +'<div class="mgmt-filter-group"><div class="mgmt-filter-label">Mês</div><div class="mgmt-segment">'+monthBtns+'</div></div>'
      +'<div class="mgmt-filter-group"><div class="mgmt-filter-label">Ano</div><div class="mgmt-segment">'+yearBtns+'</div></div>'
      +'<div class="mgmt-filter-group"><div class="mgmt-filter-label">Ordenar</div><div class="mgmt-segment">'
        +'<button type="button" class="mgmt-chip neutral active" data-filter-target="av-risk-sort" data-value="score" onclick="_mgmtSetCompactFilter(\'av-risk-sort\',\'score\',\'ranking\')" title="Taxa primeiro, depois valor e ocorrências">Risco</button>'
        +'<button type="button" class="mgmt-chip neutral" data-filter-target="av-risk-sort" data-value="avTotal" onclick="_mgmtSetCompactFilter(\'av-risk-sort\',\'avTotal\',\'ranking\')">Valor</button>'
        +'<button type="button" class="mgmt-chip neutral" data-filter-target="av-risk-sort" data-value="rate" onclick="_mgmtSetCompactFilter(\'av-risk-sort\',\'rate\',\'ranking\')">Taxa</button>'
        +'<button type="button" class="mgmt-chip neutral" data-filter-target="av-risk-sort" data-value="avCount" onclick="_mgmtSetCompactFilter(\'av-risk-sort\',\'avCount\',\'ranking\')">Ocorr.</button>'
      +'</div></div>'
      +'<div class="mgmt-filter-group"><div class="mgmt-filter-label">Nível</div><div class="mgmt-segment">'
        +'<button type="button" class="mgmt-chip neutral active" data-filter-target="av-risk-level" data-value="" onclick="_mgmtSetCompactFilter(\'av-risk-level\',\'\',\'ranking\')">Todos</button>'
        +'<button type="button" class="mgmt-chip" data-filter-target="av-risk-level" data-value="high" onclick="_mgmtSetCompactFilter(\'av-risk-level\',\'high\',\'ranking\')">Alto</button>'
        +'<button type="button" class="mgmt-chip" data-filter-target="av-risk-level" data-value="med" onclick="_mgmtSetCompactFilter(\'av-risk-level\',\'med\',\'ranking\')">Atenção</button>'
        +'<button type="button" class="mgmt-chip neutral" data-filter-target="av-risk-level" data-value="low" onclick="_mgmtSetCompactFilter(\'av-risk-level\',\'low\',\'ranking\')">Ok</button>'
      +'</div></div>'
    +'</div>'
    +'<div id="av-risk-kpis" class="mgmt-kpi-grid"></div>'
    +'<div class="mgmt-grid-2" style="grid-template-columns:minmax(0,1.55fr) minmax(300px,.7fr)">'
      +'<div class="mgmt-surface">'
        +'<div class="chart-title">Calendário operacional - entregue x avariado</div>'
        +'<div id="av-calendar"></div>'
        +'<div id="av-cal-footer" style="margin-top:12px"></div>'
      +'</div>'
      +'<div class="mgmt-surface"><div class="chart-title">Alertas executivos</div><div id="av-risk-alerts" class="risk-alerts"></div></div>'
    +'</div>'
    +'<div class="mgmt-grid-2">'
      +'<div class="mgmt-surface"><div class="chart-title">Evolução mensal de avarias</div><div class="risk-chart-box"><canvas id="av-risk-trend"></canvas></div></div>'
      +'<div class="mgmt-surface"><div class="chart-title">Produtos/causas recorrentes</div><div id="av-risk-products" class="risk-mini-list"></div></div>'
    +'</div>'
    +'<div class="mgmt-surface" style="margin-bottom:14px"><div class="chart-title">Clientes mais problemáticos</div><div class="risk-chart-box"><canvas id="av-risk-chart"></canvas></div></div>'
    +'<div class="mgmt-surface">'
      +'<div id="av-ranking-title" class="chart-title">Ranking de risco por cliente</div>'
      +'<div id="av-ranking-content"></div>'
    +'</div>';
  renderAvariaCalendar();
}

function _buildAvariaRiskLocal(yearSel,monthSel,clientFilter){
  function inMonth(s){ return s.sale_date && s.sale_date.slice(0,7)===(yearSel+'-'+monthSel); }
  var avarias=allSales.filter(function(s){return s.sale_type==='AVARIA' && inMonth(s);});
  var vendas=allSales.filter(function(s){return s.sale_type!=='AVARIA' && inMonth(s);});
  if(clientFilter){
    avarias=avarias.filter(function(s){return (s.client||'').trim()===clientFilter;});
    vendas=vendas.filter(function(s){return (s.client||'').trim()===clientFilter;});
  }
  var byClient={};
  avarias.forEach(function(s){
    var cl=(s.client||'Sem cliente').trim();
    var p=prodCanonicalName(s.product,s.sale_type)||s.product||'Sem produto';
    byClient[cl]=byClient[cl]||{client:cl,avTotal:0,avQty:0,avCount:0,avDays:{},saleTotal:0,saleCount:0,products:{}};
    byClient[cl].avTotal+=Math.abs(Number(s.total||0)); byClient[cl].avQty+=Math.abs(Number(s.quantity||0)); byClient[cl].avCount++;
    if(s.sale_date)byClient[cl].avDays[s.sale_date]=1;
    byClient[cl].products[p]=byClient[cl].products[p]||{product:p,total:0,qty:0,count:0};
    byClient[cl].products[p].total+=Math.abs(Number(s.total||0)); byClient[cl].products[p].qty+=Math.abs(Number(s.quantity||0)); byClient[cl].products[p].count++;
  });
  vendas.forEach(function(s){
    var cl=(s.client||'Sem cliente').trim(); if(!byClient[cl])return;
    byClient[cl].saleTotal+=Math.abs(Number(s.total||0)); byClient[cl].saleCount++;
  });
  var rows=Object.values(byClient).map(function(r){
    r.rate=r.saleTotal>0 ? (r.avTotal/r.saleTotal*100) : 0;
    r.days=Object.keys(r.avDays).length;
    r.products=Object.values(r.products).sort(function(a,b){return b.total-a.total;});
    var level=_mgmtRiskLevel(r.rate,r.avTotal,r.avCount); r.level=level.key; r.levelLabel=level.label;
    r.score=_mgmtAvariaRiskScore(r);
    return r;
  });
  var trend=MONTHS.map(function(_,i){
    var ym=yearSel+'-'+String(i+1).padStart(2,'0');
    var av=allSales.filter(function(s){return s.sale_type==='AVARIA' && _mgmtYM(s.sale_date)===ym;}).reduce(function(a,s){return a+Math.abs(Number(s.total||0));},0);
    return {month:String(i+1).padStart(2,'0'),total_avaria:av};
  });
  var totalAvaria=rows.reduce(function(a,r){return a+r.avTotal;},0);
  var totalVendas=vendas.reduce(function(a,s){return a+Math.abs(Number(s.total||0));},0);
  return {source:'local',summary:{total_avaria:totalAvaria,total_vendas:totalVendas,taxa_geral:totalVendas>0?totalAvaria/totalVendas*100:0,clientes_afetados:rows.length,ocorrencias:avarias.length},clients:rows,trend:trend};
}

async function _loadAvariaRiskData(yearSel,monthSel,clientFilter){
  var qs='year='+encodeURIComponent(yearSel)+'&month='+encodeURIComponent(monthSel);
  if(clientFilter) qs+='&client='+encodeURIComponent(clientFilter);
  try{ return await api('/api/avarias/client-risk?'+qs); }
  catch(e){ return _buildAvariaRiskLocal(yearSel,monthSel,clientFilter); }
}

function renderAvariaOperationalCalendar(yearSel,monthSel,clientFilter){
  var calEl=document.getElementById('av-calendar');
  var footEl=document.getElementById('av-cal-footer');
  if(!calEl)return;
  var ym=yearSel+'-'+monthSel;
  var vendas=allSales.filter(function(s){
    return s.sale_type!=='AVARIA' && _mgmtYM(s.sale_date)===ym && (!clientFilter || (s.client||'').trim()===clientFilter);
  });
  var avarias=allSales.filter(function(s){
    return s.sale_type==='AVARIA' && _mgmtYM(s.sale_date)===ym && (!clientFilter || (s.client||'').trim()===clientFilter);
  });
  var byDay={};
  vendas.forEach(function(s){
    var d=Number((s.sale_date||'').slice(8,10)); if(!d)return;
    byDay[d]=byDay[d]||{vendVal:0,vendQty:0,vendCount:0,avVal:0,avQty:0,avCount:0,products:{},vendas:[],avarias:[]};
    byDay[d].vendVal+=Math.abs(Number(s.total||0));
    byDay[d].vendQty+=Math.abs(Number(s.quantity||0));
    byDay[d].vendCount++;
    byDay[d].vendas.push(s);
  });
  avarias.forEach(function(s){
    var d=Number((s.sale_date||'').slice(8,10)); if(!d)return;
    var p=prodCanonicalName(s.product,s.sale_type)||s.product||'Sem produto';
    byDay[d]=byDay[d]||{vendVal:0,vendQty:0,vendCount:0,avVal:0,avQty:0,avCount:0,products:{},vendas:[],avarias:[]};
    byDay[d].avVal+=Math.abs(Number(s.total||0));
    byDay[d].avQty+=Math.abs(Number(s.quantity||0));
    byDay[d].avCount++;
    byDay[d].avarias.push(s);
    byDay[d].products[p]=byDay[d].products[p]||{product:p,total:0,qty:0,count:0};
    byDay[d].products[p].total+=Math.abs(Number(s.total||0));
    byDay[d].products[p].qty+=Math.abs(Number(s.quantity||0));
    byDay[d].products[p].count++;
  });
  var yearNum=Number(yearSel), monthNum=Number(monthSel);
  var first=new Date(yearNum,monthNum-1,1);
  var daysInMonth=new Date(yearNum,monthNum,0).getDate();
  var startDow=first.getDay(); startDow=startDow===0?6:startDow-1;
  var dNames=['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];
  var totalCells=Math.ceil((startDow+daysInMonth)/7)*7;
  var today=new Date();
  _avCalendarDayData={};
  var html='<div class="av-cal" style="border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--card)">'
    +'<div class="av-cal-head" style="display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--g800);color:#fff;padding:12px 14px;flex-wrap:wrap">'
      +'<div><div style="font-size:15px;font-weight:800">'+_mgmtMonthName(monthSel)+' '+yearSel+'</div><div style="font-size:11px;opacity:.78">'+(clientFilter?'Cliente: '+_mgmtEsc(clientFilter):'Todos os clientes')+'</div></div>'
      +'<div style="display:flex;gap:8px;font-size:11px;flex-wrap:wrap"><span>🟢 Entregue/faturado</span><span>🔴 Avariado/retornado</span></div>'
    +'</div>'
    +'<div class="av-cal-weekdays" style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-bottom:1px solid var(--border)">';
  dNames.forEach(function(d,i){
    html+='<div style="padding:7px;text-align:center;font-size:10px;font-weight:800;text-transform:uppercase;color:'+(i>=5?'#B71C1C':'var(--muted)')+';border-right:'+(i<6?'1px solid var(--border)':'none')+'">'+d+'</div>';
  });
  html+='</div><div class="av-cal-grid" style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr))">';
  for(var cell=0;cell<totalCells;cell++){
    var day=cell-startDow+1;
    var valid=day>=1 && day<=daysInMonth;
    var data=valid?byDay[day]:null;
    var weekend=(cell%7)>=5;
    var isToday=valid && day===today.getDate() && monthNum===today.getMonth()+1 && yearNum===today.getFullYear();
    var bg=!valid?'var(--g50)':(data&&data.avVal?'#fff7f7':(data&&data.vendVal?'#f7fff8':(weekend?'#fafafa':'var(--card)')));
    html+='<div class="av-cal-day '+(valid?'valid':'empty')+' '+(data?'has-movement':'no-movement')+'" style="min-height:112px;padding:7px;border-right:'+((cell%7)<6?'1px solid var(--border)':'none')+';border-bottom:'+(cell<totalCells-7?'1px solid var(--border)':'none')+';background:'+bg+';overflow:hidden">';
    if(valid){
      if(data){
        data.label=_mgmtMonthName(monthSel)+' '+yearSel;
        _avCalendarDayData[day]=data;
      }
      html+='<div style="display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:5px">'
        +'<span style="'+(isToday?'background:#B71C1C;color:#fff;border-radius:999px;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;':'')+'font-size:12px;font-weight:800">'+day+'</span>'
        +(data&&data.avVal?'<span style="font-size:9px;font-weight:800;color:#B71C1C;background:#fee2e2;border-radius:999px;padding:2px 6px">'+data.avCount+' av.</span>':'')
      +'</div>';
      if(data&&data.vendVal){
        html+='<button type="button" class="av-cal-action" onclick="showAvariaDayDetail('+day+',\'vendas\')" style="background:#dcfce7;border-left:3px solid #16a34a;border-radius:5px;padding:4px 5px;margin-bottom:4px;line-height:1.25">'
          +'<div style="font-size:9px;color:#166534;font-weight:800">Entregue</div>'
          +'<div style="font-size:10px;color:#14532d;font-family:monospace;font-weight:800">'+fmt(data.vendVal)+'</div>'
          +'<div style="font-size:9px;color:#166534">'+data.vendCount+' reg. · '+data.vendQty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</div>'
        +'</button>';
      }
      if(data&&data.avVal){
        var top=Object.values(data.products).sort(function(a,b){return b.total-a.total;})[0];
        var rate=data.vendVal>0?(data.avVal/data.vendVal*100):0;
        html+='<button type="button" class="av-cal-action" onclick="showAvariaDayDetail('+day+',\'avarias\')" style="background:#fee2e2;border-left:3px solid #dc2626;border-radius:5px;padding:4px 5px;line-height:1.25">'
          +'<div style="font-size:9px;color:#991b1b;font-weight:800">Avariado / retornado</div>'
          +'<div style="font-size:10px;color:#991b1b;font-family:monospace;font-weight:800">'+fmt(data.avVal)+'</div>'
          +'<div style="font-size:9px;color:#991b1b">'+data.avCount+' reg. · '+data.avQty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</div>'
          +(top?'<div title="'+_mgmtEsc(top.product)+'" style="font-size:9px;color:#7f1d1d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:2px">'+_mgmtEsc(top.product)+'</div>':'')
          +(data.vendVal>0?'<div style="font-size:9px;color:#9a3412;margin-top:2px">Taxa do dia: <b>'+rate.toFixed(1).replace('.',',')+'%</b></div>':'')
        +'</button>';
      }
      if(!data){
        html+='<div style="font-size:11px;color:var(--muted);opacity:.55;padding-top:20px;text-align:center">sem movimento</div>';
      }
    }
    html+='</div>';
  }
  html+='</div></div>';
  html+='<div id="av-day-detail"></div>';
  calEl.innerHTML=html;
  var vendVal=vendas.reduce(function(a,s){return a+Math.abs(Number(s.total||0));},0);
  var avVal=avarias.reduce(function(a,s){return a+Math.abs(Number(s.total||0));},0);
  var vendQty=vendas.reduce(function(a,s){return a+Math.abs(Number(s.quantity||0));},0);
  var avQty=avarias.reduce(function(a,s){return a+Math.abs(Number(s.quantity||0));},0);
  var daysAv=Object.keys(byDay).filter(function(d){return byDay[d].avVal>0;}).length;
  if(footEl){
    footEl.innerHTML='<div class="mgmt-kpi-grid" style="margin-bottom:0">'
      +'<div class="mgmt-kpi ok"><div class="mgmt-kpi-label">Entregue no filtro</div><div class="mgmt-kpi-value">'+fmt(vendVal)+'</div><div class="mgmt-kpi-sub">'+vendas.length+' registros · '+vendQty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</div></div>'
      +'<div class="mgmt-kpi danger"><div class="mgmt-kpi-label">Retornado / avariado</div><div class="mgmt-kpi-value">'+fmt(avVal)+'</div><div class="mgmt-kpi-sub">'+avarias.length+' ocorrências · '+avQty.toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</div></div>'
      +'<div class="mgmt-kpi warn"><div class="mgmt-kpi-label">Taxa de retorno</div><div class="mgmt-kpi-value">'+(vendVal>0?(avVal/vendVal*100).toFixed(1).replace('.',','):'0,0')+'%</div><div class="mgmt-kpi-sub">'+daysAv+' dia(s) com avaria no mês</div></div>'
    +'</div>';
  }
}

async function renderAvariaCalendar(){
  const yearSel=(document.getElementById('cal-year')&&document.getElementById('cal-year').value)||String(new Date().getFullYear());
  const monthSel=(document.getElementById('cal-month')&&document.getElementById('cal-month').value)||String(new Date().getMonth()+1).padStart(2,'0');
  const clientFilter=(document.getElementById('cal-client')&&document.getElementById('cal-client').value)||'';
  var kpi=document.getElementById('av-risk-kpis');
  if(kpi)kpi.innerHTML='<div class="loader"><div class="spin"></div>Carregando risco...</div>';
  const data=await _loadAvariaRiskData(yearSel,monthSel,clientFilter);
  _avRiskRows=(data.clients||[]).map(function(r){
    r.avTotal=Number(r.avTotal||r.total_avaria||0); r.avQty=Number(r.avQty||r.qtd_avaria||0); r.avCount=Number(r.avCount||r.ocorrencias||0);
    r.saleTotal=Number(r.saleTotal||r.total_vendas||0); r.rate=Number(r.rate||r.taxa_avaria||0);
    var lvl=_mgmtRiskLevel(r.rate,r.avTotal,r.avCount); r.level=lvl.key; r.levelLabel=lvl.label;
    r.score=_mgmtAvariaRiskScore(r);
    r.products=r.products||[];
    return r;
  });
  renderAvariaRiskSummary(data,yearSel,monthSel);
  renderAvariaOperationalCalendar(yearSel,monthSel,clientFilter);
  renderAvariaRiskTrend(data.trend||[],yearSel);
  renderAvariaRiskProducts(_avRiskRows);
  renderAvariaRanking();
}

function _renderAvariaProjectionHtml(total,vendas,yearSel,monthSel){
  var now=new Date();
  var yearNum=Number(yearSel), monthNum=Number(monthSel);
  var daysInMonth=new Date(yearNum,monthNum,0).getDate();
  var isCurrent=(now.getFullYear()===yearNum && now.getMonth()+1===monthNum);
  var elapsed=isCurrent ? Math.max(1,now.getDate()) : daysInMonth;
  var remaining=isCurrent ? Math.max(0,daysInMonth-elapsed) : 0;
  var avg=elapsed>0 ? total/elapsed : 0;
  var projected=isCurrent ? avg*daysInMonth : total;
  var projectedPct=vendas>0 ? projected/vendas*100 : 0;
  var trend=projected>total*1.15?'Acelerado':(projected<total*.85?'Reduzindo':'Estável');
  return '<div class="mgmt-kpi danger">'
    +'<div class="mgmt-kpi-label">Projeção de avaria</div>'
    +'<div class="mgmt-kpi-value">'+fmt(projected)+'</div>'
    +'<div class="mgmt-kpi-sub">'+_mgmtMonthName(monthSel)+' '+yearSel+' · atual '+fmt(total)+'</div>'
    +'<div class="mgmt-kpi-sub">'+fmt(avg)+'/dia · '+projectedPct.toFixed(2).replace('.',',')+'% projetado · '+trend+(isCurrent?' · faltam '+remaining+'d':' · mês fechado')+'</div>'
  +'</div>';
}

function renderAvariaRiskSummary(data,yearSel,monthSel){
  var s=data.summary||{};
  var total=Number(s.total_avaria||0), vendas=Number(s.total_vendas||0), taxa=Number(s.taxa_geral||0);
  var high=_avRiskRows.filter(function(r){return r.level==='high';}).length;
  var kpi=document.getElementById('av-risk-kpis');
  if(kpi)kpi.innerHTML=_renderAvariaProjectionHtml(total,vendas,yearSel,monthSel)
    +'<div class="mgmt-kpi danger"><div class="mgmt-kpi-label">Valor avariado</div><div class="mgmt-kpi-value">'+fmt(total)+'</div><div class="mgmt-kpi-sub">'+(s.ocorrencias||0)+' ocorrências no período</div></div>'
    +'<div class="mgmt-kpi warn"><div class="mgmt-kpi-label">Taxa geral</div><div class="mgmt-kpi-value">'+taxa.toFixed(1).replace('.',',')+'%</div><div class="mgmt-kpi-sub">sobre '+fmt(vendas)+' em vendas</div></div>'
    +'<div class="mgmt-kpi"><div class="mgmt-kpi-label">Clientes afetados</div><div class="mgmt-kpi-value">'+(s.clientes_afetados||_avRiskRows.length)+'</div><div class="mgmt-kpi-sub">'+high+' em alto risco</div></div>'
    +'<div class="mgmt-kpi ok"><div class="mgmt-kpi-label">Receita líquida</div><div class="mgmt-kpi-value">'+fmt(vendas-total)+'</div><div class="mgmt-kpi-sub">vendas menos avarias</div></div>';
  var alerts=document.getElementById('av-risk-alerts');
  if(alerts){
    var top=_mgmtSortAvariaRiskRows(_avRiskRows.slice(),'score')[0];
    var recurrent=_avRiskRows.filter(function(r){return r.avCount>=3;}).length;
    alerts.innerHTML=(top?'<div class="risk-alert '+(top.level==='high'?'high':'med')+'"><span class="risk-dot"></span><div><b>'+_mgmtEsc(top.client)+'</b><div class="risk-mini-sub">Maior risco: '+fmt(top.avTotal)+' em avarias, '+top.rate.toFixed(1).replace('.',',')+'% de taxa e '+top.avCount+' ocorrências.</div></div></div>':'')
      +'<div class="risk-alert '+(taxa>25?'high':(taxa>15?'med':''))+'"><span class="risk-dot"></span><div><b>Taxa do período</b><div class="risk-mini-sub">'+taxa.toFixed(1).replace('.',',')+'% de avaria sobre vendas. Controlado até 10%, atenção acima de 15% e alto risco acima de 25%.</div></div></div>'
      +'<div class="risk-alert '+(recurrent?'med':'')+'"><span class="risk-dot"></span><div><b>Recorrência</b><div class="risk-mini-sub">'+recurrent+' cliente(s) com 3 ou mais ocorrências no período.</div></div></div>';
  }
}

function renderAvariaRiskTrend(trend,yearSel){
  var c=document.getElementById('av-risk-trend'); if(!c)return;
  if(avRiskTrendChart)avRiskTrendChart.destroy();
  avRiskTrendChart=new Chart(c,{type:'line',data:{labels:MS,datasets:[{label:'Avarias',data:MONTHS.map(function(_,i){
    var m=String(i+1).padStart(2,'0'); var row=(trend||[]).find(function(r){return String(r.month).padStart(2,'0')===m;});
    return Number(row?(row.total_avaria||row.total||0):0);
  }),borderColor:'#dc2626',backgroundColor:'rgba(220,38,38,.12)',fill:true,tension:.32,pointRadius:3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){return fmt(ctx.raw);}}}},scales:{x:{grid:{display:false}},y:{ticks:{callback:function(v){return fmt(v);}},grid:{color:'var(--border)'}}}}});
}

function renderAvariaRiskProducts(rows){
  var el=document.getElementById('av-risk-products'); if(!el)return;
  var map={};
  rows.forEach(function(r){(r.products||[]).forEach(function(p){
    var name=p.product||p[0]||'Sem produto'; map[name]=map[name]||{product:name,total:0,qty:0,count:0};
    map[name].total+=Number(p.total||p.total_avaria||0); map[name].qty+=Number(p.qty||p.qtd||0); map[name].count+=Number(p.count||p.ocorrencias||0);
  });});
  var list=Object.values(map).sort(function(a,b){return b.total-a.total;}).slice(0,6);
  el.innerHTML=list.length?list.map(function(p,i){return '<div class="risk-mini-item"><div class="risk-mini-title"><span>'+_mgmtEsc(p.product)+'</span><span style="color:#b91c1c;font-family:monospace">'+fmt(p.total)+'</span></div><div class="risk-mini-sub">'+p.count+' ocorrências · '+Number(p.qty||0).toLocaleString('pt-BR',{maximumFractionDigits:1})+' un.</div></div>';}).join(''):'<div class="empty">Nenhum produto com avaria no filtro.</div>';
}

function renderAvariaRanking(){
  var el=document.getElementById('av-ranking-content'); if(!el)return;
  var titleEl=document.getElementById('av-ranking-title');
  var monthSel=(document.getElementById('cal-month')&&document.getElementById('cal-month').value)||String(new Date().getMonth()+1).padStart(2,'0');
  var yearSel=(document.getElementById('cal-year')&&document.getElementById('cal-year').value)||String(new Date().getFullYear());
  var sort=(document.getElementById('av-risk-sort')&&document.getElementById('av-risk-sort').value)||'score';
  var level=(document.getElementById('av-risk-level')&&document.getElementById('av-risk-level').value)||'';
  if(titleEl)titleEl.textContent='Ranking de risco por cliente - '+_mgmtMonthName(monthSel)+' '+yearSel;
  var rows=_avRiskRows.slice();
  if(level)rows=rows.filter(function(r){return r.level===level;});
  _mgmtSortAvariaRiskRows(rows, sort);
  if(!rows.length){el.innerHTML='<div class="empty">Nenhuma avaria encontrada para os filtros selecionados.</div>';return;}
  var max=Math.max.apply(null,rows.map(function(r){return sort==='score'?Number(r.rate||0):Number(r[sort]||r.avTotal||0);}));
  renderAvariaRiskChart(rows.slice(0,10));
  var sortNote=sort==='score'
    ? '<div style="font-size:11px;color:var(--muted);margin:0 0 8px">Critério do ranking: <b>taxa de avaria</b> primeiro, depois <b>valor avariado</b> e <b>ocorrências</b> como desempate.</div>'
    : '<div style="font-size:11px;color:var(--muted);margin:0 0 8px">Ordenação atual por: <b>'+({avTotal:'valor avariado',rate:'taxa de avaria',avCount:'ocorrências'}[sort]||'risco')+'</b>.</div>';
  el.innerHTML=sortNote+'<div class="risk-table-wrap"><table class="risk-table"><thead><tr>'
    +'<th>Cliente</th><th class="r">Taxa</th><th class="r">Avariado</th><th class="r">Ocorr.</th><th>Severidade</th><th class="r">Ações</th>'
    +'</tr></thead><tbody>'+rows.map(function(r,i){
      var badge='<span class="risk-badge '+r.level+'">'+r.levelLabel+'</span>';
      var products=(r.products||[]).slice(0,2).map(function(p){return p.product||p[0];}).filter(Boolean).join(', ');
      var barVal=sort==='score'?Number(r.rate||0):Number(r[sort]||r.avTotal||0);
      var clientArg=JSON.stringify(r.client).replace(/"/g,'&quot;');
      return '<tr>'
        +'<td data-label="Cliente"><div class="risk-client-cell"><span class="risk-rank '+(i<3?'top':'')+'">'+(i+1)+'</span><div style="min-width:0"><button type="button" class="risk-name risk-name-btn" title="Ver entregue e retornado do mês" onclick="showAvariaClientMonthDetail('+clientArg+')">'+_mgmtEsc(r.client)+'</button><div class="risk-meta">'+_mgmtEsc(products||'Sem produto destacado')+'</div><div class="risk-meta">Base entregue: '+fmt(r.saleTotal||0)+'</div></div></div></td>'
        +'<td data-label="Taxa" class="r mono">'+Number(r.rate||0).toFixed(1).replace('.',',')+'%</td>'
        +'<td data-label="Avariado" class="r mono" style="font-weight:800;color:#b91c1c">'+fmt(r.avTotal)+'</td>'
        +'<td data-label="Ocorr." class="r mono">'+r.avCount+'</td>'
        +'<td data-label="Severidade"><div class="risk-bar"><span style="width:'+Math.max(6,Math.round((barVal/(max||1))*100))+'%"></span></div><div style="margin-top:5px">'+badge+'</div><div style="font-size:10px;color:var(--muted);margin-top:4px">Risco: taxa '+Number(r.rate||0).toFixed(1).replace('.',',')+'% · '+fmt(r.avTotal)+'</div></td>'
        +'<td data-label="Ações"><div class="risk-actions"><button class="btn btn-secondary btn-sm" title="Ver entregue e retornado do mês" onclick="showAvariaClientMonthDetail('+clientArg+')">👁</button><button class="btn btn-secondary btn-sm" title="Filtrar calendário por cliente" onclick="_mgmtFilterAvariaClient('+clientArg+')">📅</button><button class="btn btn-secondary btn-sm" title="Abrir Clientes" onclick="_mgmtOpenClientesTab()">👤</button></div></td>'
      +'</tr>';
    }).join('')+'</tbody></table></div>';
}

function renderAvariaRiskChart(rows){
  var c=document.getElementById('av-risk-chart'); if(!c)return;
  if(avRiskChart)avRiskChart.destroy();
  avRiskChart=new Chart(c,{type:'bar',data:{labels:rows.map(function(r){return String(r.client||'').length>18?String(r.client).slice(0,17)+'…':r.client;}),datasets:[{data:rows.map(function(r){return r.avTotal;}),backgroundColor:rows.map(function(r){return r.level==='high'?'#dc2626':(r.level==='med'?'#f97316':'#22c55e');}),borderRadius:6}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){var r=rows[ctx.dataIndex];return fmt(ctx.raw)+' · '+Number(r.rate||0).toFixed(1).replace('.',',')+'% · '+r.avCount+' ocorr.';}}}},scales:{x:{ticks:{callback:function(v){return fmt(v);}},grid:{color:'var(--border)'}},y:{grid:{display:false}}}}});
}
</script>


<!-- Modal de data de entrega da nota -->
<div class="modal-overlay" id="delivery-date-modal" style="display:none" role="dialog" aria-modal="true" aria-label="Confirmar entrega da nota">
  <div class="modal" style="max-width:380px">
    <div class="modal-header">
      <div style="font-size:14px;font-weight:700;color:var(--g800)">📋 Confirmar entrega da nota</div>
      <button class="modal-close" onclick="closeDeliveryModal()" aria-label="Fechar">×</button>
    </div>
    <div style="padding:18px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--ink);margin-bottom:6px">Data da entrega</label>
      <input type="date" id="delivery-date-input" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px">
      <div id="delivery-date-help" style="font-size:11px;color:var(--muted);margin-top:6px">Confirme a data em que esta nota fiscal foi entregue ao cliente.</div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--border);background:var(--g50)">
      <button class="btn btn-secondary btn-sm" onclick="closeDeliveryModal()">Cancelar</button>
      <button class="btn btn-primary btn-sm" id="delivery-date-confirm" onclick="confirmDeliveryDate()">✅ Confirmar</button>
    </div>
  </div>
</div>




<!-- Modal: Confirmar entrega em massa -->
<div class="modal-overlay" id="bulk-delivery-modal" style="display:none" role="dialog" aria-modal="true" aria-label="Confirmar entrega em massa">
  <div class="modal" style="max-width:420px">
    <div class="modal-header">
      <div style="font-size:14px;font-weight:700;color:var(--g800)">📋 Confirmar entrega em massa</div>
      <button class="modal-close" onclick="closeBulkDeliveryModal()" aria-label="Fechar">×</button>
    </div>
    <div style="padding:18px">
      <div style="font-size:13px;color:var(--ink);margin-bottom:14px">
        Confirmar entrega de <b><span id="bulk-delivery-count">0</span></b> nota(s) selecionada(s).
        Todas receberão a mesma data de entrega.
      </div>
      <label style="display:block;font-size:12px;font-weight:600;color:var(--ink);margin-bottom:6px">Data da entrega (aplicada a todas)</label>
      <input type="date" id="bulk-delivery-date-input" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px">
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--border);background:var(--g50)">
      <button class="btn btn-secondary btn-sm" onclick="closeBulkDeliveryModal()">Cancelar</button>
      <button class="btn btn-primary btn-sm" onclick="confirmBulkDelivery()">✅ Confirmar todas</button>
    </div>
  </div>
</div>

<!-- Modal: Marcar boletos como pagos em massa (PR 3.5) -->
<div class="modal-overlay" id="bulk-pay-modal" style="display:none" role="dialog" aria-modal="true" aria-label="Marcar boletos como pagos em massa">
  <div class="modal" style="max-width:440px">
    <div class="modal-header">
      <div style="font-size:14px;font-weight:700;color:var(--g800)">💰 Marcar boletos como pagos</div>
      <button class="modal-close" onclick="closeBulkPayModal()" aria-label="Fechar">×</button>
    </div>
    <div style="padding:18px">
      <div style="font-size:13px;color:var(--ink);margin-bottom:6px">
        Marcar <b><span id="bulk-pay-count">0</span></b> boleto(s) como pagos —
        total <b style="color:#1B5E20"><span id="bulk-pay-total">R$ 0,00</span></b>.
      </div>
      <div style="font-size:11px;color:var(--muted);margin-bottom:14px">A mesma data de pagamento será aplicada a todos.</div>
      <label style="display:block;font-size:12px;font-weight:600;color:var(--ink);margin-bottom:6px">Data do pagamento</label>
      <input type="date" id="bulk-pay-date-input" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px">
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--border);background:var(--g50)">
      <button class="btn btn-secondary btn-sm" onclick="closeBulkPayModal()">Cancelar</button>
      <button class="btn btn-primary btn-sm" onclick="confirmBulkPay()" id="bulk-pay-confirm-btn">✅ Confirmar todos</button>
    </div>
  </div>
</div>

<!-- Barra flutuante de ação em massa -->
<div id="bulk-action-bar" style="display:none;position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--g800);color:#fff;border-radius:12px;padding:10px 14px;box-shadow:0 8px 24px rgba(0,0,0,.28);z-index:9997;align-items:center;gap:10px;flex-wrap:wrap;max-width:calc(100vw - 100px)">
  <button class="btn btn-primary btn-sm" style="background:#fff;color:var(--g800);font-weight:700" onclick="openBulkDeliveryModal()" id="bulk-action-btn">
    <span id="bulk-action-label">✅ Marcar 0 notas como entregues</span>
  </button>
  <button class="btn btn-secondary btn-sm" style="background:transparent;color:#fff;border:1px solid rgba(255,255,255,.4)" onclick="clearBulkSelection()" aria-label="Cancelar seleção">
    ✕ Cancelar seleção
  </button>
</div>


<!-- Modal mini: confirmar desfazer entrega -->
<div class="modal-overlay" id="undo-deliver-modal" style="display:none" role="dialog" aria-modal="true" aria-label="Confirmar desfazer entrega">
  <div class="modal" style="max-width:380px">
    <div class="modal-header">
      <div style="font-size:14px;font-weight:700;color:var(--g800)">↩ Desfazer entrega</div>
      <button class="modal-close" onclick="closeUndoModal()" aria-label="Fechar">×</button>
    </div>
    <div style="padding:18px">
      <div style="font-size:13px;color:var(--ink);margin-bottom:6px">
        Deseja mover esta nota de volta para Pendentes?
      </div>
      <div id="undo-modal-client" style="font-size:12px;color:var(--muted);font-style:italic">—</div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--border);background:var(--g50)">
      <button class="btn btn-secondary btn-sm" onclick="closeUndoModal()">Cancelar</button>
      <button class="btn btn-primary btn-sm" onclick="confirmUndoDelivery()" style="background:#B71C1C">↩ Confirmar</button>
    </div>
  </div>
</div>
<!-- Botão Voltar ao Topo flutuante -->
<button id="btn-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Voltar ao topo" style="display:none;position:fixed;bottom:76px;right:20px;z-index:150;width:38px;height:38px;border-radius:50%;background:var(--g800);color:#fff;border:none;font-size:16px;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.28);transition:opacity .2s,transform .2s;align-items:center;justify-content:center;opacity:0">↑</button>

<!-- Sino de notificações flutuante -->
<button class="notif-bell" id="notif-bell" onclick="toggleNotificationDrawer()" aria-label="Abrir notas pendentes" title="Notas pendentes">
  🔔
  <span class="notif-badge zero" id="notif-badge" aria-live="polite">0</span>
</button>

<!-- Modo TV — painel fullscreen para escritório/sala (acionado via menu de usuário) -->
<div id="tv-mode" role="region" aria-label="Modo TV - Painel">
  <div class="tv-header">
    <div class="tv-brand">
      <img class="tv-logo" src="/logo.png" alt="Menina dos Raios" onerror="this.style.display='none'">
      <div class="tv-brand-text">
        <h1>Menina dos Raios Ltda<small id="tv-period">—</small></h1>
      </div>
    </div>
    <div class="tv-clock">
      <div id="tv-time">--:--</div>
      <small id="tv-date">—</small>
      <span class="tv-live" id="tv-refresh-label">AO VIVO</span>
    </div>
  </div>

  <!-- Ticker — últimas vendas em rolagem contínua -->
  <div class="tv-ticker">
    <div class="tv-ticker-inner" id="tv-ticker-inner"><span style="opacity:.5">Carregando últimas vendas…</span></div>
  </div>

  <div class="tv-slides">
    <!-- Slide 1 (padrão): visão geral -->
    <div id="tv-slide-1" class="tv-slide tv-slide-fg">

      <!-- Canais de venda -->
      <div class="tv-channels" id="tv-channels">
        <div class="tv-channel" data-ch="NF">
          <div class="tv-channel-icon">📋</div>
          <div class="tv-channel-info">
            <div class="tv-channel-label">NF-e</div>
            <div class="tv-channel-value" id="tv-ch-nf-val">R$ 0</div>
            <div class="tv-channel-pct"><span id="tv-ch-nf-pct">0%</span> · <span id="tv-ch-nf-cnt">0</span> vendas</div>
            <div class="tv-channel-bar"><div class="tv-channel-bar-fill" id="tv-ch-nf-bar" style="width:0%"></div></div>
          </div>
        </div>
        <div class="tv-channel" data-ch="PR">
          <div class="tv-channel-icon">🌱</div>
          <div class="tv-channel-info">
            <div class="tv-channel-label">Produtor Rural</div>
            <div class="tv-channel-value" id="tv-ch-pr-val">R$ 0</div>
            <div class="tv-channel-pct"><span id="tv-ch-pr-pct">0%</span> · <span id="tv-ch-pr-cnt">0</span> vendas</div>
            <div class="tv-channel-bar"><div class="tv-channel-bar-fill" id="tv-ch-pr-bar" style="width:0%"></div></div>
          </div>
        </div>
        <div class="tv-channel" data-ch="AVULSO">
          <div class="tv-channel-icon">📦</div>
          <div class="tv-channel-info">
            <div class="tv-channel-label">Avulso</div>
            <div class="tv-channel-value" id="tv-ch-av-val">R$ 0</div>
            <div class="tv-channel-pct"><span id="tv-ch-av-pct">0%</span> · <span id="tv-ch-av-cnt">0</span> vendas</div>
            <div class="tv-channel-bar"><div class="tv-channel-bar-fill" id="tv-ch-av-bar" style="width:0%"></div></div>
          </div>
        </div>
      </div>

      <!-- 6 KPIs -->
      <div class="tv-kpis">
        <div class="tv-kpi">
          <div class="tv-kpi-label">Faturamento do Mês</div>
          <div class="tv-kpi-value" id="tv-kpi-fatur">R$ 0</div>
          <div class="tv-kpi-sub" id="tv-kpi-fatur-sub">—</div>
        </div>
        <div class="tv-kpi">
          <div class="tv-kpi-label">Vendas Realizadas</div>
          <div class="tv-kpi-value" id="tv-kpi-vendas">0</div>
          <div class="tv-kpi-sub" id="tv-kpi-vendas-sub">—</div>
        </div>
        <div class="tv-kpi">
          <div class="tv-kpi-label">Ticket Médio</div>
          <div class="tv-kpi-value" id="tv-kpi-ticket">R$ 0</div>
          <div class="tv-kpi-sub">por venda</div>
        </div>
        <div class="tv-kpi">
          <div class="tv-kpi-label">Dias Produtivos</div>
          <div class="tv-kpi-value" id="tv-kpi-dias">0</div>
          <div class="tv-kpi-sub" id="tv-kpi-dias-sub">média —/dia</div>
        </div>
        <div class="tv-kpi danger">
          <div class="tv-kpi-label">⚠️ Avarias do Mês</div>
          <div class="tv-kpi-value" id="tv-kpi-avaria">R$ 0</div>
          <div class="tv-kpi-sub" id="tv-kpi-avaria-sub">—</div>
          <div id="tv-kpi-avaria-proj" style="font-size:11px;opacity:.85;margin-top:5px;padding-top:5px;border-top:1px solid rgba(252,165,165,.2)"></div>
        </div>
        <div class="tv-kpi meta" id="tv-kpi-meta">
          <div class="tv-kpi-label">🎯 Meta do Mês</div>
          <div class="tv-kpi-value" id="tv-kpi-meta-val">—</div>
          <div class="tv-meta-progress" id="tv-meta-bar-wrap" style="display:none">
            <div class="tv-meta-progress-fill" id="tv-meta-bar-fill" style="width:0%"></div>
          </div>
          <div class="tv-kpi-sub" id="tv-kpi-meta-sub">Meta não definida</div>
        </div>
      </div>

      <!-- Grid principal: 2 colunas (gráfico + top 5) -->
      <div class="tv-grid">
        <div class="tv-card">
          <div class="tv-card-title">Vendas (14 dias)</div>
          <svg class="tv-chart" id="tv-chart" viewBox="0 0 700 180" preserveAspectRatio="none"></svg>
        </div>
        <div class="tv-card">
          <div class="tv-card-title">Top 5 Clientes</div>
          <ul class="tv-top-list" id="tv-top-list">
            <li class="tv-empty">Carregando…</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Slide 2 (alternativo): rankings expandidos -->
    <div id="tv-slide-2" class="tv-slide tv-slide-bg">
      <div class="tv-grid">
        <div class="tv-card">
          <div class="tv-card-title">🏅 Top 8 Clientes</div>
          <ul class="tv-top-list" id="tv-top10-list">
            <li class="tv-empty">—</li>
          </ul>
        </div>
        <div class="tv-card">
          <div class="tv-card-title">⚠️ Projeção de Avarias</div>
          <div class="tv-avaria-proj-bar" id="tv-avaria-proj-bar">
            <div class="tv-avaria-proj-row"><!-- populated dynamically --></div>
            <div class="tv-avaria-proj-row"><!-- populated dynamically --></div>
          </div>
          <div class="tv-avaria-proj-divider"></div>
          <div class="tv-avaria-split">
            <div class="tv-avaria-split-col">
              <div class="tv-avaria-split-label">Clientes</div>
              <ul class="tv-avaria-list" id="tv-avaria-detail-list">
                <li class="tv-empty">—</li>
              </ul>
            </div>
            <div class="tv-avaria-split-col">
              <div class="tv-avaria-split-label">Produtos</div>
              <ul class="tv-avaria-list" id="tv-avaria-product-list">
                <li class="tv-empty">—</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="tv-card">
          <div class="tv-card-title">📊 Canais por Semana</div>
          <svg class="tv-weekly-bars" id="tv-weekly-bars" viewBox="0 0 700 200" preserveAspectRatio="none"></svg>
          <div class="tv-weekly-legend">
            <span><span style="display:inline-block;width:10px;height:10px;background:#86efac;border-radius:2px;margin-right:5px;vertical-align:middle"></span>NF-e</span>
            <span><span style="display:inline-block;width:10px;height:10px;background:#fbbf24;border-radius:2px;margin-right:5px;vertical-align:middle"></span>PR</span>
            <span><span style="display:inline-block;width:10px;height:10px;background:#60a5fa;border-radius:2px;margin-right:5px;vertical-align:middle"></span>Avulso</span>
          </div>
        </div>
        <div class="tv-card">
          <div class="tv-card-title">🏆 Entregadores</div>
          <ul class="tv-drivers-list" id="tv-drivers-detail-list">
            <li class="tv-empty">—</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Slide 3 (alternativo): Meta & Projeção -->
    <div id="tv-slide-3" class="tv-slide tv-slide-bg">

      <!-- Hero principal: meta, faturado, projeção + barra dupla + status -->
      <div class="tv-meta-hero" id="tv-meta-hero">
        <!-- Conteúdo preenchido dinamicamente por _tvRenderMetaSlide() -->
      </div>

      <!-- 5 cards de detalhe (ritmo atual, ideal, dias restantes, falta, necessário/dia) -->
      <div class="tv-meta-cards" id="tv-meta-cards">
        <!-- Conteúdo preenchido dinamicamente por _tvRenderMetaSlide() -->
      </div>

    </div>
  </div>

  <div class="tv-footer">
    <button class="tv-exit" onclick="exitTVMode()" aria-label="Sair do Modo TV">← Sair do Modo TV</button>
    <span class="center-info">
      <span class="tv-slide-dots" id="tv-slide-dots">
        <span class="tv-slide-dot active" data-slide="0"></span>
        <span class="tv-slide-dot" data-slide="1"></span>
        <span class="tv-slide-dot" data-slide="2"></span>
      </span>
      Atualização automática a cada 30 segundos · Pressione Esc para sair
    </span>
    <span id="tv-footer-version" style="opacity:.5">1.0.73</span>
  </div>
</div>
<div class="notif-drawer-overlay" id="notif-drawer-overlay" onclick="toggleNotificationDrawer()"></div>
<aside class="notif-drawer" id="notif-drawer" role="dialog" aria-label="Notas pendentes" aria-modal="true">
  <div class="notif-drawer-header">
    <div style="font-size:14px;font-weight:700">📋 Notas Pendentes <span id="drawer-count">0</span></div>
    <button class="notif-drawer-close" onclick="toggleNotificationDrawer()" aria-label="Fechar">×</button>
  </div>
  <div class="notif-drawer-body" id="notif-drawer-body">
    <div class="empty" style="text-align:center;color:var(--muted);padding:32px">Nenhuma nota pendente.</div>
  </div>
</aside>

<!-- ── MOBILE NAV DRAWER ── -->
<div class="nav-drawer-overlay" id="nav-drawer-overlay" onclick="toggleMobileNav()"></div>
<aside class="nav-drawer" id="nav-drawer" role="dialog" aria-label="Menu de navegação" aria-modal="true">
  <div class="nav-drawer-header">
    <img src="/logo.png" alt="" onerror="this.style.display='none'">
    <h2>Menina dos Raios Ltda</h2>
  </div>
  <div class="nav-drawer-user">
    <div class="nd-avatar" id="nd-avatar">—</div>
    <div>
      <div class="nd-name" id="nd-name">—</div>
      <div class="nd-role" id="nd-role">—</div>
    </div>
  </div>
  <div class="nav-drawer-body">
    <div class="nav-drawer-section-title">Principal</div>
    <button class="nav-drawer-item" data-tab="consolidado" onclick="closeNavAndSwitch(this,'consolidado')"><span class="nd-icon">📊</span>Consolidado</button>
    <button class="nav-drawer-item" data-tab="nf" onclick="closeNavAndSwitch(this,'nf')"><span class="nd-icon">🧾</span>NF-e</button>
    <button class="nav-drawer-item" data-tab="pr" onclick="closeNavAndSwitch(this,'pr')"><span class="nd-icon">🌱</span>Prod. Rural</button>
    <button class="nav-drawer-item" data-tab="avulso" onclick="closeNavAndSwitch(this,'avulso')"><span class="nd-icon">💵</span>Avulso</button>
    <button class="nav-drawer-item" data-tab="avaria" onclick="closeNavAndSwitch(this,'avaria')"><span class="nd-icon">⚠️</span>Avarias</button>
    <button class="nav-drawer-item" data-tab="projecao" onclick="closeNavAndSwitch(this,'projecao')"><span class="nd-icon">🏭</span>Projeção</button>
    <button class="nav-drawer-item" data-tab="grafico" onclick="closeNavAndSwitch(this,'grafico')"><span class="nd-icon">📈</span>Gráfico</button>
    <button class="nav-drawer-item" data-tab="pendentes" onclick="closeNavAndSwitch(this,'pendentes')"><span class="nd-icon">📋</span>Notas <span class="nd-badge" id="nd-badge-pendentes" style="display:none">0</span></button>
    <div class="nav-drawer-section-title">Consultas</div>
    <button class="nav-drawer-item" data-tab="clientes" onclick="closeNavAndSwitch(this,'clientes')"><span class="nd-icon">👥</span>Clientes</button>
    <button class="nav-drawer-item" data-tab="boletos" onclick="closeNavAndSwitch(this,'boletos')"><span class="nd-icon">💰</span>Boletos</button>
    <button class="nav-drawer-item" data-tab="orcamento" onclick="closeNavAndSwitch(this,'orcamento')"><span class="nd-icon">📝</span>Orçamento</button>
    <button class="nav-drawer-item" data-tab="produtividade" onclick="closeNavAndSwitch(this,'produtividade')"><span class="nd-icon">📊</span>Produtividade</button>
    <button class="nav-drawer-item" data-tab="produtos" onclick="closeNavAndSwitch(this,'produtos')"><span class="nd-icon">📦</span>Produtos</button>
    <div class="nav-drawer-divider"></div>
    <button class="nav-drawer-item" onclick="toggleMobileNav();openPaladarApp()"><span class="nd-icon">🍽️</span>Monteiro</button>
    <button class="nav-drawer-item" data-tab="config" onclick="closeNavAndSwitch(this,'config')"><span class="nd-icon">⚙️</span>Configurações</button>
  </div>
  <div class="nav-drawer-footer">
    <button class="nd-footer-btn" onclick="toggleMobileNav();toggleTheme()"><span id="nd-theme-icon">🌙</span> Tema</button>
    <button class="nd-footer-btn" onclick="toggleMobileNav();enterTVMode()">📺 TV</button>
    <button class="nd-footer-btn danger" onclick="toggleMobileNav();doLogout()">⬅ Sair</button>
  </div>
</aside>

<!-- ── PALADAR APP (overlay fullscreen independente) ── -->
<div id="paladar-app">
  <!-- Header -->
  <div style="background:#4F46E5;color:#fff;padding:14px 20px;display:flex;align-items:center;gap:12px;flex-shrink:0">
    <div style="font-size:22px;font-weight:800;letter-spacing:-.03em;display:flex;align-items:center;gap:8px">🍽️ Monteiro</div>
    <div style="font-size:12px;opacity:.7;font-weight:400">Sistema de Vendas Independente</div>
    <div style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <button onclick="openOrcamentoFromMonteiro()" title="Abrir Orçamentos" style="background:#7C3AED;color:#fff;border:1px solid rgba(255,255,255,.35);padding:7px 16px;border-radius:8px;font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;transition:background .15s;box-shadow:0 8px 18px rgba(40,20,80,.18);margin-right:8px">📝 Orçamentos</button>
      <button onclick="openPaladarSaleModal()" style="background:rgba(255,255,255,.2);color:#fff;border:none;padding:7px 14px;border-radius:8px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:background .15s">➕ Lançar Venda</button>
      <button onclick="closePaladarApp()" style="background:rgba(255,255,255,.15);color:#fff;border:none;padding:7px 14px;border-radius:8px;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;transition:background .15s">✕ Fechar</button>
    </div>
  </div>

  <!-- Sub-nav -->
  <div style="display:flex;gap:2px;padding:10px 20px;background:var(--card);border-bottom:2px solid var(--border);flex-shrink:0">
    <button id="pal-tab-painel" onclick="switchPaladarTab('painel')" style="padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:#4F46E5;color:#fff">📊 Painel</button>
    <button id="pal-tab-lanc" onclick="switchPaladarTab('lancamentos')" style="padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:transparent;color:var(--muted)">📋 Lançamentos</button>
    <button id="pal-tab-prod" onclick="switchPaladarTab('produtos')" style="padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:transparent;color:var(--muted)">📦 Produtos</button>
    <button id="pal-tab-clientes" onclick="switchPaladarTab('clientes')" style="padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:transparent;color:var(--muted)">👥 Clientes</button>
    <button id="pal-tab-pagamentos" onclick="switchPaladarTab('pagamentos')" style="padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:transparent;color:var(--muted)">💰 Pagamentos</button>
    <button id="pal-tab-notasapp" onclick="switchPaladarTab('notasapp')" style="padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:transparent;color:var(--muted)">📱 Notas APP <span id="pal-app-notes-badge" style="display:none;margin-left:4px;background:#DC2626;color:#fff;border-radius:999px;padding:1px 6px;font-size:9px">0</span></button>
    <button id="pal-tab-calendario" onclick="switchPaladarTab('calendario')" style="padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:transparent;color:var(--muted)">📅 Calendário <span id="pal-calendar-badge" style="display:none;margin-left:4px;background:#DC2626;color:#fff;border-radius:999px;padding:1px 6px;font-size:9px">0</span></button>
    <div style="margin-left:auto;display:flex;gap:6px;align-items:center">
      <select id="pal-filter-period" class="filt" style="font-size:11px;padding:4px 8px" onchange="togglePalPeriodFields();(function(){var a=document.querySelector('#pal-view-painel,#pal-view-lancamentos,#pal-view-clientes,#pal-view-pagamentos');if(a){if(a.id==='pal-view-painel')loadPaladarSummary();else if(a.id==='pal-view-lancamentos')loadPaladarSales();else if(a.id==='pal-view-clientes')loadPaladarClients();else if(a.id==='pal-view-pagamentos')loadPaladarPayments();}})()">
        <option value="mensal">Mensal</option>
        <option value="quinzenal">Quinzenal</option>
        <option value="anual">Anual</option>
      </select>
      <select id="pal-filter-month" class="filt" style="font-size:11px;padding:4px 8px">
        <option value="">Todos os meses</option>
        <option value="01">Janeiro</option><option value="02">Fevereiro</option>
        <option value="03">Março</option><option value="04">Abril</option>
        <option value="05">Maio</option><option value="06">Junho</option>
        <option value="07">Julho</option><option value="08">Agosto</option>
        <option value="09">Setembro</option><option value="10">Outubro</option>
        <option value="11">Novembro</option><option value="12">Dezembro</option>
      </select>
      <select id="pal-filter-year" class="filt" style="font-size:11px;padding:4px 8px">
        <option value="">Todos os anos</option>
        <option value="2024">2024</option><option value="2025">2025</option>
        <option value="2026">2026</option><option value="2027">2027</option>
      </select>
      <button class="btn btn-secondary btn-sm" onclick="loadPaladarSummary();loadPaladarSales();loadPaladarClients();loadPaladarPayments();loadAppNotes();loadAppCalendar()" style="font-size:11px;padding:4px 10px">🔍 Filtrar</button>
    </div>
  </div>

  <!-- Conteúdo rolável -->
  <div style="flex:1;overflow-y:auto;padding:20px">
    <!-- VISTA: Painel -->
    <div id="pal-view-painel">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;flex-wrap:wrap;gap:4px">
        <div id="pal-period-subtitle" style="font-size:13px;font-weight:600;color:var(--muted)">📊 Resumo do Período</div>
        <div id="pal-update-ts" style="font-size:10px;color:var(--muted);opacity:.6">—</div>
      </div>
      <div id="pal-kpi-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px">
        <div style="background:#4F46E5;color:#fff;border-radius:var(--radius);padding:14px">
          <div style="font-size:10px;opacity:.7;text-transform:uppercase;margin-bottom:4px">💰 Receita Total</div>
          <div style="font-size:20px;font-weight:700;font-family:monospace" id="pal-kpi-receita">—</div>
          <div id="pal-kpi-receita-var" style="font-size:11px;margin-top:3px;font-weight:500"></div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:14px">
          <div style="font-size:10px;color:var(--muted);text-transform:uppercase;margin-bottom:4px">🛒 Vendas</div>
          <div style="font-size:20px;font-weight:700;font-family:monospace;color:var(--g800)" id="pal-kpi-vendas">—</div>
          <div id="pal-kpi-vendas-var" style="font-size:11px;margin-top:3px;font-weight:500"></div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:14px">
          <div style="font-size:10px;color:var(--muted);text-transform:uppercase;margin-bottom:4px">🎯 Ticket Médio</div>
          <div style="font-size:20px;font-weight:700;font-family:monospace;color:var(--g800)" id="pal-kpi-ticket">—</div>
          <div id="pal-kpi-ticket-var" style="font-size:11px;margin-top:3px;font-weight:500"></div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:14px">
          <div style="font-size:10px;color:var(--muted);text-transform:uppercase;margin-bottom:4px">📅 Dias Produtivos</div>
          <div style="font-size:20px;font-weight:700;font-family:monospace;color:var(--g800)" id="pal-kpi-dias">—</div>
          <div id="pal-kpi-dias-var" style="font-size:11px;margin-top:3px;font-weight:500"></div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1.6fr 1fr;gap:14px;margin-bottom:18px">
        <div class="card" style="padding:14px">
          <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:10px">📈 Receita por Dia</div>
          <div style="height:220px"><canvas id="chart-pal-bar"></canvas></div>
        </div>
        <div class="card" style="padding:14px">
          <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:10px">🥧 Por Produto</div>
          <div style="height:200px"><canvas id="chart-pal-donut"></canvas></div>
        </div>
      </div>
      <div class="card" style="padding:14px">
        <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:10px">🏆 Top Produtos</div>
        <div id="pal-top-produtos"></div>
      </div>
      <div class="card" style="padding:14px;margin-top:14px">
        <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:8px">🏆 Melhor Dia</div>
        <div id="pal-melhor-dia" style="color:var(--muted);font-size:12px">—</div>
      </div>
    </div>

    <!-- VISTA: Lançamentos -->
    <div id="pal-view-lancamentos" style="display:none">
      <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;align-items:center">
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-right:6px">
          <button type="button" class="pal-lanc-view-btn active" data-pal-lanc-view="lancamentos" onclick="switchPalLancView('lancamentos')">📋 Lançamentos</button>
          <button type="button" class="pal-lanc-view-btn" data-pal-lanc-view="notas" onclick="switchPalLancView('notas')">🧾 Notas fiscais enviadas</button>
        </div>
        <input type="text" id="pal-filter-product" class="form-input" placeholder="Filtrar por produto..." style="font-size:12px;padding:5px 10px;width:140px" oninput="loadPaladarSales()">
        <input type="text" id="pal-filter-client" class="form-input" placeholder="Cliente..." style="font-size:12px;padding:5px 10px;width:130px" oninput="loadPaladarSales()">
        <input type="text" id="pal-filter-nf" class="form-input" placeholder="NF..." style="font-size:12px;padding:5px 10px;width:110px" oninput="loadPaladarSales()">
        <input type="text" id="pal-filter-driver" class="form-input" placeholder="Entregador..." style="font-size:12px;padding:5px 10px;width:120px" oninput="loadPaladarSales()">
        <input type="text" id="pal-filter-vehicle" class="form-input" placeholder="Veículo / Placa..." style="font-size:12px;padding:5px 10px;width:140px" oninput="loadPaladarSales()">
        <button type="button" onclick="downloadPaladarInvoicesZip()" title="Baixar em ZIP as notas fiscais marcadas (ou todas as anexadas nesta tela, se nenhuma marcada)" style="border:1.5px solid #166534;color:#166534;background:#DCFCE7;padding:6px 12px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap">⬇️ Baixar notas (ZIP)</button>
      </div>
      <div id="pal-lanc-table-wrap"><div class="loader"><div class="spin"></div></div></div>
    </div>

    <!-- VISTA: Produtos (cadastro CRUD) -->
    <div id="pal-view-produtos" style="display:none">
      <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;align-items:center">
        <button onclick="openPaladarProductModal()" style="border:1.5px solid #4F46E5;color:#4F46E5;background:transparent;padding:6px 12px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit">➕ Novo Produto</button>
        <input type="text" id="pal-prod-search" class="form-input" placeholder="Buscar produto..." style="font-size:12px;padding:5px 10px;width:200px" oninput="loadPaladarProducts()">
      </div>
      <div id="pal-prod-list-wrap"><div class="loader"><div class="spin"></div></div></div>
    </div>

    <!-- VISTA: Clientes -->
    <div id="pal-view-clientes" style="display:none">
      <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;align-items:center">
        <select id="pal-filter-cli-name" class="form-input" style="font-size:12px;padding:5px 10px;width:220px" onchange="loadPaladarClients()">
          <option value="">Todos os clientes</option>
        </select>
        <button class="btn btn-secondary btn-sm" onclick="loadPaladarClients()" style="font-size:11px;padding:4px 10px">🔍 Filtrar</button>
        <div style="flex:1"></div>
        <button class="btn btn-sm" onclick="exportPaladarAllExcel()" style="font-size:11px;padding:4px 10px;background:#22c55e;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:600;font-family:inherit">📥 Excel todos</button>
        <button class="btn btn-sm" onclick="exportPaladarAllPDF(this)" style="font-size:11px;padding:4px 10px;background:#EF4444;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:600;font-family:inherit">📄 PDF todos</button>
      </div>
      <div id="pal-cli-summary" style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px">
        <div style="background:#4F46E5;color:#fff;border-radius:var(--radius);padding:12px">
          <div style="font-size:10px;opacity:.7;text-transform:uppercase">💰 Total Vendido</div>
          <div style="font-size:18px;font-weight:700;font-family:monospace;margin-top:4px" id="pal-cli-total">—</div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
          <div style="font-size:10px;color:var(--muted);text-transform:uppercase">👥 Clientes</div>
          <div style="font-size:18px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:4px" id="pal-cli-count">—</div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
          <div style="font-size:10px;color:var(--muted);text-transform:uppercase">🎯 Ticket Médio</div>
          <div style="font-size:18px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:4px" id="pal-cli-ticket">—</div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
          <div style="font-size:10px;color:var(--muted);text-transform:uppercase">🏆 Cliente Líder</div>
          <div style="font-size:13px;font-weight:700;color:var(--g800);margin-top:4px" id="pal-cli-lider">—</div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
        <div class="card" style="padding:14px">
          <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:8px">📊 Vendas por Cliente</div>
          <div style="height:220px"><canvas id="chart-pal-cli-bar"></canvas></div>
        </div>
        <div class="card" style="padding:14px">
          <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:8px">🥧 Participação</div>
          <div style="height:200px"><canvas id="chart-pal-cli-donut"></canvas></div>
        </div>
      </div>
      <div class="card" style="padding:14px">
        <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:8px">📋 Demonstrativo por Cliente</div>
        <div id="pal-cli-table-wrap"><div class="loader"><div class="spin"></div></div></div>
      </div>

      <!-- Detalhe do cliente -->
      <div id="pal-cli-detail" style="display:none;margin-top:16px">
        <div class="card" style="padding:16px">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:12px">
            <div style="font-size:14px;font-weight:700;color:var(--g800)">
              📋 <span id="pal-det-name"></span>
              <span style="font-size:11px;font-weight:400;color:var(--muted);margin-left:8px" id="pal-det-period"></span>
            </div>
            <div style="display:flex;gap:6px">
              <button class="btn btn-sm" onclick="exportPaladarClientExcel(document.getElementById('pal-det-name').textContent)" style="background:#22c55e;color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit">📥 Exportar Excel</button>
              <button class="btn btn-sm" onclick="exportPaladarClientPDF(this)" style="background:#EF4444;color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit">📄 Exportar PDF</button>
              <button class="btn btn-sm" onclick="document.getElementById('pal-cli-detail').style.display='none'" style="background:var(--card2);color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;font-family:inherit">✕ Fechar</button>
            </div>
          </div>
          <!-- Resumo -->
          <div id="pal-det-summary" style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:14px"></div>
          <!-- Produtos -->
          <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:6px">📦 Produtos comprados</div>
          <div id="pal-det-prods" style="overflow-x:auto;margin-bottom:14px"></div>
          <!-- Notas -->
          <div style="font-size:12px;font-weight:700;color:var(--g800);margin-bottom:6px">📄 Notas fiscais do período</div>
          <div id="pal-det-notas" style="overflow-x:auto"></div>
        </div>
      </div>
    </div>

  <!-- VISTA: Notas enviadas pelo aplicativo Android -->
  <div id="pal-view-notasapp" style="display:none;padding:14px">
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
      <div>
        <div style="font-size:17px;font-weight:800;color:var(--g800)">📱 Notas APP</div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px">Uma nota por cliente em cada dia, reunindo todos os envios e o valor total acumulado.</div>
      </div>
      <div style="flex:1"></div>
      <input id="app-notes-client" type="search" placeholder="🔎 Filtrar cliente..." oninput="debounceAppNotes()" style="width:240px;max-width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--ink);font:inherit;font-size:12px">
      <button class="btn btn-secondary btn-sm" onclick="loadAppNotes()">↻ Atualizar</button>
    </div>
    <div style="display:flex;gap:6px;margin-bottom:14px;border-bottom:1px solid var(--border);padding-bottom:8px">
      <button id="app-notes-tab-pending" class="btn btn-primary btn-sm" onclick="switchAppNotesStatus('pending')">⏳ Pendentes <span id="app-notes-pending-count">0</span></button>
      <button id="app-notes-tab-completed" class="btn btn-secondary btn-sm" onclick="switchAppNotesStatus('completed')">✅ Concluídas</button>
    </div>
    <div id="app-notes-kpis" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px"></div>
    <div class="card" style="padding:0;overflow:hidden">
      <div id="app-notes-wrap" style="overflow-x:auto"><div class="wa-empty" style="padding:36px">Carregando...</div></div>
    </div>
  </div>

  <!-- VISTA: Calendário de notificações do aplicativo Android -->
  <div id="pal-view-calendario" style="display:none;padding:14px">
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
      <div>
        <div style="font-size:17px;font-weight:800;color:var(--g800)">📅 Calendário</div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px">Notificações internas enviadas para o sino do aplicativo no celular.</div>
      </div>
      <div style="flex:1"></div>
      <button class="btn btn-primary btn-sm" onclick="openAppCalendarModal()">➕ Nova notificação</button>
      <button class="btn btn-secondary btn-sm" onclick="loadAppCalendar()">↻ Atualizar</button>
    </div>
    <div style="display:flex;gap:6px;margin-bottom:14px;border-bottom:1px solid var(--border);padding-bottom:8px">
      <button id="app-calendar-tab-pending" class="btn btn-primary btn-sm" onclick="switchAppCalendarStatus('pending')">⏳ Pendentes <span id="app-calendar-pending-count">0</span></button>
      <button id="app-calendar-tab-completed" class="btn btn-secondary btn-sm" onclick="switchAppCalendarStatus('completed')">✅ Concluídas</button>
    </div>
    <div id="app-calendar-kpis" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px"></div>
    <div class="card" style="padding:0;overflow:hidden">
      <div id="app-calendar-wrap" style="overflow-x:auto"><div class="wa-empty" style="padding:36px">Carregando calendário...</div></div>
    </div>
  </div>

  </div>

  <!-- VISTA: Pagamentos -->
  <div id="pal-view-pagamentos" style="display:none;padding:14px">
    <div class="pal-pay-summary">
    <!-- Filtros -->
    <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
      <input type="text" id="pal-pag-cliente" list="pal-client-list" placeholder="👤 Cliente..." style="font-size:12px;padding:5px 10px;width:220px;border:1px solid var(--border);border-radius:7px;background:var(--card);color:var(--ink);font-family:inherit" onchange="loadPaladarPayments()">
      <div style="font-size:11px;color:var(--muted)">Use o seletor de período ⬆️ acima para quinzenal/mensal/anual</div>
      <div style="flex:1"></div>
      <div id="pag-active-client" style="display:none;font-size:11px;font-weight:700;color:#4F46E5;background:#EEF2FF;padding:4px 10px;border-radius:6px"></div>
      <button class="btn btn-primary btn-sm" id="btn-lancar-pagamento" onclick="openPaymentModal()">💰 Lançar pagamento</button>
      <button class="btn btn-sm" onclick="exportPaymentsExcel()" style="background:#22c55e;color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit">📥 Excel</button>
      <button class="btn btn-sm" onclick="exportPaymentsPDF(this)" style="background:#EF4444;color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit">📄 PDF</button>
    </div>

    <div id="pag-start-hint" class="pal-pay-start">
      <div>
        <strong>Selecione um cliente para abrir o painel financeiro</strong>
        Veja total vendido, recebido, saldo, dias cobertos pelo pagamento e o extrato em uma tela só.
      </div>
      <span style="font-size:11px;color:#4F46E5;font-weight:800;background:#EEF2FF;border-radius:999px;padding:5px 9px">Pagamentos por período</span>
    </div>

    <!-- Cards resumo -->
    <div id="pag-summary-cards" style="display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:14px">
      <div style="background:#4F46E5;color:#fff;border-radius:var(--radius);padding:12px">
        <div style="font-size:9px;opacity:.7;text-transform:uppercase">💰 Total vendido</div>
        <div style="font-size:16px;font-weight:700;font-family:monospace;margin-top:4px" id="pag-total-vendido">—</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
        <div style="font-size:9px;color:var(--muted);text-transform:uppercase">📥 Total recebido</div>
        <div style="font-size:16px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:4px" id="pag-total-pago">—</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
        <div style="font-size:9px;color:var(--muted);text-transform:uppercase">⚖️ Saldo</div>
        <div style="font-size:16px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:4px" id="pag-saldo">—</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
        <div style="font-size:9px;color:var(--muted);text-transform:uppercase">📋 Notas</div>
        <div style="font-size:16px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:4px" id="pag-num-notas">—</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
        <div style="font-size:9px;color:var(--muted);text-transform:uppercase">💳 Pagamentos</div>
        <div style="font-size:16px;font-weight:700;font-family:monospace;color:var(--g800);margin-top:4px" id="pag-num-pagamentos">—</div>
      </div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px">
        <div style="font-size:9px;color:var(--muted);text-transform:uppercase">📅 Último pagto</div>
        <div style="font-size:13px;font-weight:700;color:var(--g800);margin-top:4px" id="pag-ultimo-pagamento">—</div>
      </div>
    </div>

    <!-- Barra de progresso -->
    <div id="pag-progress-wrap" style="margin-bottom:14px">
      <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:4px">
        <span>📊 Progresso de quitação</span>
        <span id="pag-progress-text">0%</span>
      </div>
      <div style="height:8px;background:var(--g100);border-radius:4px;overflow:hidden">
        <div id="pag-progress-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#22c55e,#16a34a);border-radius:4px;transition:width .3s"></div>
      </div>
    </div>
    </div>

    <!-- Cobertura por período -->
    <div class="card" id="pag-coverage-card" style="padding:14px;margin-bottom:12px;border-color:#c7d2fe">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap">
        <div>
          <div style="font-size:12px;font-weight:800;color:var(--g800)">🧾 Dias cobertos por pagamento</div>
          <div style="font-size:10px;color:var(--muted);margin-top:2px">Verde mostra os dias cobertos pelo pagamento. Vermelho mostra o valor pendente no período.</div>
        </div>
      </div>
      <div id="pag-coverage-wrap"><div class="wa-empty">Carregando...</div></div>
    </div>

    <div class="card" style="padding:14px;margin-bottom:14px">
      <div class="pal-pay-tabs">
        <button type="button" class="pal-pay-tab active" data-pay-tab="notas" onclick="switchPaymentDetailTab('notas')">📄 Notas do período</button>
        <button type="button" class="pal-pay-tab" data-pay-tab="pagamentos" onclick="switchPaymentDetailTab('pagamentos')">💳 Pagamentos registrados</button>
        <button type="button" class="pal-pay-tab" data-pay-tab="extrato" onclick="switchPaymentDetailTab('extrato')">📊 Extrato cronológico</button>
      </div>
      <div id="pal-coverage-bands" style="margin-bottom:4px;"></div>
      <div class="pal-pay-tab-panel active" data-pay-panel="notas">
        <div id="pag-notas-wrap" class="pal-pay-tab-scroll"><div class="wa-empty">Carregando...</div></div>
      </div>
      <div class="pal-pay-tab-panel" data-pay-panel="pagamentos">
        <div id="pag-pagamentos-wrap" class="pal-pay-tab-scroll"><div class="wa-empty">Carregando...</div></div>
      </div>
      <div class="pal-pay-tab-panel" data-pay-panel="extrato">
        <div id="pag-extrato-wrap" class="pal-pay-tab-scroll"><div class="wa-empty">Carregando...</div></div>
      </div>
    </div>
  </div>

  <!-- Modal de detalhes da Nota APP -->
  <div id="app-note-detail-modal" onclick="if(event.target===this)closeAppNoteDetail()" style="position:fixed;inset:0;z-index:9600;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.55);padding:16px">
    <div style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);width:min(900px,96vw);max-height:90vh;overflow:auto">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--border)">
        <div><div id="app-note-detail-client" style="font-size:17px;font-weight:900;color:var(--g800)">Cliente</div><div id="app-note-detail-meta" style="font-size:10px;color:var(--muted);margin-top:3px"></div></div>
        <button onclick="closeAppNoteDetail()" style="background:none;border:none;font-size:24px;color:var(--muted);cursor:pointer">&times;</button>
      </div>
      <div id="app-note-detail-body" style="padding:16px"></div>
    </div>
  </div>

  <!-- Modal de edição de Nota APP -->
  <div id="app-note-modal" onclick="if(event.target===this)closeAppNoteModal()" style="position:fixed;inset:0;z-index:9600;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.55);padding:16px">
    <div style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px;width:min(680px,96vw);max-height:90vh;overflow:auto">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px">
        <div style="font-size:16px;font-weight:800;color:#4F46E5">✏️ Editar Nota APP</div>
        <button onclick="closeAppNoteModal()" style="background:none;border:none;font-size:22px;color:var(--muted);cursor:pointer">&times;</button>
      </div>
      <input type="hidden" id="app-note-id">
      <div style="display:grid;grid-template-columns:1fr 180px;gap:10px;margin-bottom:12px">
        <label style="font-size:11px;font-weight:700;color:var(--muted)">Cliente
          <input id="app-note-edit-client" style="display:block;width:100%;margin-top:5px;padding:9px;border:1px solid var(--border);border-radius:7px;background:var(--card);color:var(--ink);box-sizing:border-box">
        </label>
        <label style="font-size:11px;font-weight:700;color:var(--muted)">Data
          <input id="app-note-edit-date" placeholder="dd/mm/aaaa" style="display:block;width:100%;margin-top:5px;padding:9px;border:1px solid var(--border);border-radius:7px;background:var(--card);color:var(--ink);box-sizing:border-box">
        </label>
      </div>
      <label style="font-size:11px;font-weight:700;color:var(--muted)">Itens — uma linha por produto no formato: Produto | Quantidade | Peso/Medida | Unidade | Valor unitário
        <textarea id="app-note-edit-items" rows="10" style="display:block;width:100%;margin-top:5px;padding:10px;border:1px solid var(--border);border-radius:7px;background:var(--card);color:var(--ink);font:12px monospace;box-sizing:border-box;resize:vertical"></textarea>
      </label>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:15px">
        <button class="btn btn-secondary" onclick="closeAppNoteModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="saveAppNote()">💾 Salvar alterações</button>
      </div>
    </div>
  </div>

  <!-- Modal de Lançamento Monteiro (multi-itens) — DENTRO do #paladar-app -->
  <div id="paladar-sale-modal" onclick="if(event.target===this)closePaladarSaleModal()" style="position:fixed;inset:0;z-index:9500;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.55)">
    <div class="paladar-modal-box" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <div style="font-size:16px;font-weight:700;color:#4F46E5">🍽️ Lançar Venda Monteiro</div>
        <button onclick="closePaladarSaleModal()" style="background:none;border:none;font-size:22px;color:var(--muted);cursor:pointer;padding:0;line-height:1">&times;</button>
      </div>
      <div class="paladar-modal-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px">
          <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Data *</label><input type="date" id="pal-sale-date" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box"></div>
          <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Cliente</label>
            <input type="text" id="pal-sale-client" list="pal-client-list" placeholder="Nome do cliente..." autocomplete="off" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
            <datalist id="pal-client-list"></datalist>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px">
          <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Número NF</label><input type="text" id="pal-sale-nf" placeholder="Ex: 105.200.01" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box"></div>
          <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Entregador</label>
            <input type="text" id="pal-sale-driver" list="pal-driver-list" placeholder="Nome do entregador..." autocomplete="off" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
            <datalist id="pal-driver-list"></datalist>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px">
            <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Veículo</label>
              <input type="text" id="pal-sale-vehicle" list="pal-vehicle-list" placeholder="Veículo..." autocomplete="off" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
              <datalist id="pal-vehicle-list"></datalist>
              <div style="margin-top:3px;display:flex;gap:6px;align-items:center">
                <span id="pal-plate-auto" style="font-size:10px;color:#4F46E5;font-weight:600"></span>
                <a href="#" id="pal-plate-manual-toggle" style="font-size:10px;color:var(--muted)" onclick="event.preventDefault();var w=document.getElementById('pal-plate-manual-wrap');w.style.display=w.style.display==='none'?'':'none';document.getElementById('pal-sale-plate').focus()">➕ Placa manual</a>
              </div>
            </div>
            <div id="pal-plate-manual-wrap" style="display:none">
              <label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Placa</label>
              <input type="text" id="pal-sale-plate" placeholder="AAA-0000" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box;text-transform:uppercase">
            </div>
          </div>
        </div>
        <div style="margin-bottom:8px">
          <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Observações</label><input type="text" id="pal-sale-notes" placeholder="Obs..." style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box"></div>
        </div>
        <div style="margin-bottom:8px">
          <label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Nota fiscal (PDF, XML ou imagem)</label>
          <input type="file" id="pal-sale-invoice" accept=".pdf,.xml,.jpg,.jpeg,.png,.webp,application/pdf,text/xml,application/xml,image/*" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:12px;font-family:inherit;box-sizing:border-box;background:var(--card)">
        </div>
        <div style="font-size:12px;font-weight:700;color:#4F46E5;margin:10px 0 8px">Itens da Venda</div>
        <div id="pal-items-body" style="max-height:320px;overflow-y:auto"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;padding-top:10px;border-top:1px solid var(--border)">
          <button onclick="addPaladarItem()" style="border:1.5px solid #4F46E5;color:#4F46E5;background:transparent;padding:6px 12px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit">➕ Adicionar Item</button>
          <div style="font-size:14px;font-weight:700;color:var(--g800)">Total Geral: <span id="pal-grand-total" style="color:#4F46E5;font-size:16px;font-weight:700;font-family:monospace">R$ 0,00</span></div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
          <button class="btn btn-secondary btn-sm" onclick="closePaladarSaleModal()">Cancelar</button>
          <button id="pal-save-btn" class="btn btn-primary btn-sm" onclick="savePaladarSale()" style="background:#4F46E5">✅ Salvar Venda</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Edição de Cliente do Lançamento Monteiro -->
<div id="paladar-group-edit-modal" style="position:fixed;inset:0;z-index:9600;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.55)" onclick="if(event.target===this)closePaladarGroupEditModal()">
  <div class="paladar-modal-box" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px;max-width:430px;width:95vw">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <div style="font-size:16px;font-weight:700;color:#4F46E5">✎ Editar Cliente</div>
      <button onclick="closePaladarGroupEditModal()" style="background:none;border:none;font-size:22px;color:var(--muted);cursor:pointer;padding:0;line-height:1">&times;</button>
    </div>
    <div>
      <label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Nome do cliente</label>
      <input type="text" id="pal-group-client" list="pal-client-list" placeholder="Nome do cliente..." autocomplete="off" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
      <button class="btn btn-secondary btn-sm" onclick="closePaladarGroupEditModal()">Cancelar</button>
      <button id="pal-group-save-btn" class="btn btn-primary btn-sm" onclick="savePaladarGroupEdit()" style="background:#4F46E5">Salvar Cliente</button>
    </div>
  </div>
</div>

<!-- Modal de Edição de Item Monteiro -->
<div id="paladar-item-edit-modal" style="position:fixed;inset:0;z-index:9600;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.55)" onclick="if(event.target===this)closePaladarItemEditModal()">
  <div class="paladar-modal-box" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px;max-width:460px;width:95vw">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <div style="font-size:16px;font-weight:700;color:#4F46E5">✎ Editar Item Monteiro</div>
      <button onclick="closePaladarItemEditModal()" style="background:none;border:none;font-size:22px;color:var(--muted);cursor:pointer;padding:0;line-height:1">&times;</button>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px">
      <div>
        <label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Produto *</label>
        <input type="text" id="pal-edit-prod" list="pal-products-list" oninput="autoFillPrice(this)" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div>
          <label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Quantidade *</label>
          <input type="number" id="pal-edit-qty" min="0.01" step="any" oninput="updatePaladarEditTotal()" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
        </div>
        <div>
          <label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Preço Unit. *</label>
          <input type="number" id="pal-edit-price" min="0" step="0.01" oninput="updatePaladarEditTotal()" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
        </div>
      </div>
      <div>
        <label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Observação</label>
        <input type="text" id="pal-edit-notes" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box">
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;background:#F5F3FF;border:1px solid #DDD6FE;border-radius:8px;padding:10px 12px">
        <span style="font-size:12px;font-weight:700;color:#4F46E5">Total do item</span>
        <span id="pal-edit-total" style="font-size:16px;font-weight:800;color:#4F46E5;font-family:monospace">R$ 0,00</span>
      </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
      <button class="btn btn-secondary btn-sm" onclick="closePaladarItemEditModal()">Cancelar</button>
      <button id="pal-edit-save-btn" class="btn btn-primary btn-sm" onclick="savePaladarItemEdit()" style="background:#4F46E5">Salvar Alterações</button>
    </div>
  </div>
</div>

<!-- Modal de Pagamento Monteiro -->
<div id="pal-pag-modal" style="position:fixed;inset:0;z-index:9500;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.55)" onclick="if(event.target===this)closePaymentModal()">
  <div style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px;max-width:460px;width:95vw">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <div style="font-size:16px;font-weight:700;color:#4F46E5" id="pag-modal-title">💰 Lançar Pagamento</div>
      <button onclick="closePaymentModal()" style="background:none;border:none;font-size:22px;color:var(--muted);cursor:pointer;padding:0;line-height:1">&times;</button>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Cliente *</label><input type="text" id="pag-cliente" list="pal-client-list" placeholder="Nome do cliente..." style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box"></div>
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Data *</label><input type="date" id="pag-data" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box"></div>
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Valor *</label><input type="number" id="pag-valor" step="0.01" min="0.01" placeholder="0,00" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box"></div>
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Competência</label><select id="pag-comp-month" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:12px;font-family:inherit;box-sizing:border-box"><option value="">Mês</option><option value="01">Janeiro</option><option value="02">Fevereiro</option><option value="03">Março</option><option value="04">Abril</option><option value="05">Maio</option><option value="06">Junho</option><option value="07">Julho</option><option value="08">Agosto</option><option value="09">Setembro</option><option value="10">Outubro</option><option value="11">Novembro</option><option value="12">Dezembro</option></select></div>
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Ano</label><select id="pag-comp-year" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:12px;font-family:inherit;box-sizing:border-box"><option value="">Ano</option><option value="2024">2024</option><option value="2025">2025</option><option value="2026">2026</option><option value="2027">2027</option></select></div>
      <input type="hidden" id="pag-edit-id" value="">
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Tipo</label><select id="pag-tipo" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:12px;font-family:inherit;box-sizing:border-box"><option value="repasse">Repasse</option><option value="adiantamento">Adiantamento</option><option value="ajuste">Ajuste</option><option value="devolucao">Devolução</option><option value="outro">Outro</option></select></div>
      <div style="grid-column:span 2"><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Observação</label><input type="text" id="pag-obs" placeholder="Obs..." style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box"></div>
      <div id="pag-modal-err" style="grid-column:span 2;display:none;font-size:12px;color:var(--red);background:var(--red-l);padding:7px 10px;border-radius:6px"></div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
      <button class="btn btn-secondary" onclick="closePaymentModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="savePayment()">✅ Salvar pagamento</button>
    </div>
  </div>
</div>

<!-- Modal de Produto Monteiro (adicionar/editar) -->
<div id="paladar-product-modal" style="position:fixed;inset:0;z-index:9600;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.55)" onclick="if(event.target===this)closePaladarProductModal()">
  <div class="paladar-modal-box" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px;max-width:420px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <div style="font-size:16px;font-weight:700;color:#4F46E5" id="pal-product-modal-title">📦 Novo Produto</div>
      <button onclick="closePaladarProductModal()" style="background:none;border:none;font-size:22px;color:var(--muted);cursor:pointer;padding:0;line-height:1">&times;</button>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px">
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Nome do Produto *</label><input type="text" id="pal-prod-name" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box" placeholder="Ex: Coxinha"></div>
      <div><label style="font-size:11px;font-weight:600;color:var(--muted);display:block;margin-bottom:3px">Preço Sugerido (R$)</label><input type="number" id="pal-prod-price" step="0.01" min="0" value="" style="width:100%;padding:7px 9px;border:1px solid #ddd;border-radius:7px;font-size:13px;font-family:inherit;box-sizing:border-box" placeholder="0,00"></div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
      <button class="btn btn-secondary btn-sm" onclick="closePaladarProductModal()">Cancelar</button>
      <button id="pal-prod-save-btn" class="btn btn-primary btn-sm" onclick="savePaladarProduct()" style="background:#4F46E5">✅ Salvar</button>
    </div>
    <input type="hidden" id="pal-prod-edit-id" value="">
  </div>
</div>

<!-- Datalist de produtos paladar -->
<datalist id="pal-products-list"></datalist>
<select id="pal-products-data" style="display:none"></select>

</body>
</html>
