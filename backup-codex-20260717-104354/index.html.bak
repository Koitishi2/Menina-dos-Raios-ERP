window.addEventListener('notasUpdated', function(){
  updateNotifBadge();
  // Atualiza contadores não-visíveis (o ativo é atualizado pelo render)
  if(_notasView!=='pendentes'){ var c1=document.getElementById('notas-count-pend'); if(c1) c1.textContent=getPendingSales().length; }
  if(_notasView!=='entregues'){ var c2=document.getElementById('notas-count-deliv'); if(c2) c2.textContent=getDeliveredSales().length; }
  if(_notasView!=='nao'){ var c3=document.getElementById('notas-count-nao'); if(c3) c3.textContent=getNaoEntregueSales().length; }
  const panel = document.getElementById('panel-pendentes');
  if(panel && panel.classList.contains('active')){
    if(_notasView==='entregues') renderDeliveredList();
    else if(_notasView==='nao') renderNaoEntregueList();
    else renderPendingList();
  }
  const drawer = document.getElementById('notif-drawer');
  if(drawer && drawer.classList.contains('open')) renderDrawerList();
});

// Atualiza badge quando allSales chegar (depois do loadAll)
window.addEventListener('salesLoaded', function(){ updateNotifBadge(); });

// Suporte a teclado: ESC fecha drawer
window.addEventListener('keydown', function(e){
  if(e.key==='Escape'){
    const drawer = document.getElementById('notif-drawer');
    if(drawer && drawer.classList.contains('open')) toggleNotificationDrawer();
  }
});

// ── Polling de sincronização de entregas (tempo real entre máquinas) ─────
let _deliverySyncTimer = null;
const DELIVERY_SYNC_INTERVAL = 10000; // 10 segundos

async function pollDeliverySync(){
  if(!session || !session.token) return;
  try{
    const remote = await api('/api/sales/delivery-sync');
    if(!Array.isArray(remote) || !Array.isArray(allSales)) return;
    var remoteMap = {};
    for(var i=0; i<remote.length; i++){
      remoteMap[remote[i].id] = remote[i];
    }
    var changed = false;
    for(var j=0; j<allSales.length; j++){
      var s = allSales[j];
      var r = remoteMap[s.id];
      if(!r) continue;
      var localDel = s.delivered || null;
      var remoteDel = r.delivered || null;
      var localAt = s.delivered_at || null;
      var remoteAt = r.delivered_at || null;
      if(localDel !== remoteDel || localAt !== remoteAt){
        s.delivered = remoteDel;
        s.delivered_at = remoteAt;
        changed = true;
      }
    }
    if(changed){
      window.dispatchEvent(new CustomEvent('notasUpdated', {detail:{sync:true}}));
      window.dispatchEvent(new CustomEvent('salesLoaded'));
    }
  }catch(e){
    console.debug('delivery sync:', e.message);
  }
}

function startDeliveryPolling(){
  if(_deliverySyncTimer) clearInterval(_deliverySyncTimer);
  _deliverySyncTimer = setInterval(pollDeliverySync, DELIVERY_SYNC_INTERVAL);
}

function stopDeliveryPolling(){
  if(_deliverySyncTimer){ clearInterval(_deliverySyncTimer); _deliverySyncTimer = null; }
}

window.addEventListener('salesLoaded', function _startOnce(){
  startDeliveryPolling();
  window.removeEventListener('salesLoaded', _startOnce);
});

document.addEventListener('visibilitychange', function(){
  if(document.hidden){ stopDeliveryPolling(); }
  else { pollDeliverySync(); startDeliveryPolling(); }
});

